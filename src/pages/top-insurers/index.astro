---
import Layout from '../../layouts/Layout.astro';

const insurers = [
  {
    rank: 1,
    name: 'Debeka',
    slug: 'debeka',
    logo: '/logos/debeka.svg',
    tagline: 'Best for civil servants and families',
    highlight: 'Largest private health insurer by members. Renowned for long-term premium stability and strong Beihilfe tariffs.',
    badge: 'Top Pick',
    badgeColor: 'green',
    score: '9.4',
    color: '#c0392b',
    bgColor: '#fef2f2',
    tags: ['Civil servants', 'Families', 'Stable premiums'],
  },
  {
    rank: 2,
    name: 'Allianz',
    slug: 'allianz',
    logo: '/logos/allianz.svg',
    tagline: 'Premium coverage, global network',
    highlight: 'Germany\'s most recognized insurer with outstanding English-language support and digital claims processing.',
    badge: 'Premium',
    badgeColor: 'blue',
    score: '9.2',
    color: '#003781',
    bgColor: '#eff6ff',
    tags: ['English support', 'Global coverage', 'Digital-first'],
  },
  {
    rank: 3,
    name: 'DKV',
    slug: 'dkv',
    logo: '/logos/dkv.svg',
    tagline: 'Largest private insurer by market share',
    highlight: 'Widest range of tariffs covering every profile. Strong reputation and consistent customer satisfaction.',
    badge: 'Most Popular',
    badgeColor: 'teal',
    score: '9.0',
    color: '#0055a4',
    bgColor: '#eff6ff',
    tags: ['All profiles', 'Tariff variety', 'High satisfaction'],
  },
  {
    rank: 4,
    name: 'HanseMerkur',
    slug: 'hansemerkur',
    logo: '/logos/hansemerkur.svg',
    tagline: 'Flexible plans, great for new expats',
    highlight: 'Known for expat-friendly onboarding, good English customer service, and competitive entry pricing.',
    badge: 'Expat-Friendly',
    badgeColor: 'green',
    score: '8.8',
    color: '#1a7a44',
    bgColor: '#f0fdf4',
    tags: ['Expats', 'English support', 'Flexible plans'],
  },
  {
    rank: 5,
    name: 'Signal Iduna',
    slug: 'signal-iduna',
    logo: '/logos/signal-iduna.svg',
    tagline: 'Competitive rates, solid coverage',
    highlight: 'Strong mid-market option with transparent pricing, broad network coverage, and reliable customer service.',
    badge: '',
    badgeColor: '',
    score: '8.5',
    color: '#d97706',
    bgColor: '#fffbeb',
    tags: ['Competitive pricing', 'Broad network'],
  },
  {
    rank: 6,
    name: 'AXA',
    slug: 'axa',
    logo: '/logos/axa.svg',
    tagline: 'International-friendly, digital-first',
    highlight: 'Top pick for frequent travelers and professionals with international ties. Excellent digital portal.',
    badge: '',
