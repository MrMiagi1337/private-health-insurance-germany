    tags: ['Mid-range', 'Under 35', 'Stable history'],
  },
  {
    rank: 8,
    name: 'Hallesche',
    slug: 'hallesche',
    logo: '/logos/hallesche.svg',
    tagline: 'Top customer satisfaction ratings',
    highlight: 'Consistently scores highest in independent customer satisfaction surveys. Excellent claims experience.',
    badge: 'Highly Rated',
    badgeColor: 'purple',
    score: '8.8',
    color: '#7e22ce',
    bgColor: '#faf5ff',
    tags: ['Customer satisfaction', 'Fast claims'],
  },
  {
    rank: 9,
    name: 'Gothaer',
    slug: 'gothaer',
    logo: '/logos/gothaer.svg',
    tagline: 'Reliable, long-established insurer',
    highlight: 'Founded in 1820. Solid financials, good tariff flexibility, and strong regional service network.',
    badge: '',
    badgeColor: '',
    score: '8.0',
    color: '#0369a1',
    bgColor: '#f0f9ff',
    tags: ['Established', 'Flexible tariffs'],
  },
  {
    rank: 10,
    name: 'Continentale',
    slug: 'continentale',
    logo: '/logos/continentale.svg',
    tagline: 'Strong for civil servants and employees',
    highlight: 'Competitive Beihilfe-supplement tariffs and good value plans for public sector employees.',
    badge: '',
    badgeColor: '',
    score: '7.9',
    color: '#1e3a5f',
    bgColor: '#f0f4ff',
    tags: ['Civil servants', 'Beihilfe', 'Good value'],
  },
];

const badgeStyles: Record<string, { bg: string; color: string }> = {
  green:  { bg: '#dcfce7', color: '#15803d' },
  blue:   { bg: '#dbeafe', color: '#1d4ed8' },
  teal:   { bg: 'var(--blue-tint)', color: 'var(--blue-dk)' },
  purple: { bg: '#ede9fe', color: '#7c3aed' },
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://private-health-insurance-germany.com/" },
        { "@type": "ListItem", "position": 2, "name": "Top Insurers", "item": "https://private-health-insurance-germany.com/top-insurers" }
      ]
    }
  ]
};
---

<Layout
  title="Best Private Health Insurance in Germany 2026 — Top 10 Insurers"
  description="Independent comparison of the 10 best private health insurance companies in Germany for expats: coverage, costs, English support, and who each suits."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <main>
    <div class="page-wrap">

      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page">Top Insurers</li>
          </ol>
        </nav>
      </div>

      <!-- Hero header -->
      <div class="page-hero">
        <div class="container">
          <span class="page-kicker">Independent Review · 2026</span>
          <h1>Top 10 Private Health Insurers in Germany</h1>
          <p class="page-lead">Ranked by coverage quality, pricing, English support, and suitability for expats. Reviewed by licensed brokers.</p>
          <div class="meta-row">
            <span class="meta-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              By Marco Maurelli
            </span>
            <span class="meta-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Updated April 2026
            </span>
            <span class="meta-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              10 insurers compared
            </span>
          </div>
        </div>
      </div>

      <!-- Cards grid -->
      <div class="container-wide grid-section">
        <div class="insurers-grid">
          {insurers.map(ins => {
            const bs = ins.badgeColor ? badgeStyles[ins.badgeColor] : null;
            return (
              <a href={`/top-insurers/${ins.slug}`} class="insurer-card" style={`--brand:${ins.color};--brand-bg:${ins.bgColor}`}>
                <!-- Rank chip -->
                <div class="card-rank">#{ins.rank}</div>

                <!-- Avatar -->
                <div class="card-avatar">
                  <img src={ins.logo} alt={`${ins.name} logo`} class="avatar-logo" width="100" height="40" loading="lazy" />
                  <div class="avatar-glow" aria-hidden="true"></div>
                </div>

                <!-- Name + badge -->
                <div class="card-head">
                  <h2 class="card-name">{ins.name}</h2>
                  {ins.badge && bs && (
                    <span class="card-badge" style={`background:${bs.bg};color:${bs.color}`}>{ins.badge}</span>
                  )}
                </div>

                <!-- Score -->
                <div class="card-score">
                  <span class="score-num">{ins.score}</span>
                  <div class="score-stars" aria-label={`Score ${ins.score} out of 10`}>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </div>
                  <span class="score-label">/10</span>
                </div>

                <!-- Tagline -->
                <p class="card-tagline">{ins.tagline}</p>

                <!-- Highlight -->
                <p class="card-highlight">{ins.highlight}</p>

                <!-- Tags -->
                <div class="card-tags">
                  {ins.tags.map(tag => (
                    <span class="card-tag">{tag}</span>
                  ))}
                </div>

                <!-- CTA -->
                <div class="card-cta">
                  <span class="cta-text">View details</span>
                  <svg class="cta-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>

                <!-- Decorative 3D highlight edge -->
                <div class="card-edge" aria-hidden="true"></div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Bottom guide section -->
      <div class="container">
        <div class="guide-section">
          <div class="guide-header">
            <h2>How to choose the right insurer</h2>
            <p>The best insurer for you depends on your personal profile. Here are the five most important factors to weigh.</p>
          </div>
          <div class="guide-grid">
            <div class="guide-card">
              <div class="guide-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3>Age at entry</h3>
              <p>Premiums are locked at entry age. Some insurers price under-30s very competitively; others are better for entries in your 40s.</p>
            </div>
            <div class="guide-card">
              <div class="guide-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
              <h3>Employment type</h3>
              <p>Civil servants need Beihilfe-complement tariffs. Freelancers need different tariff structures. Employees have the most options.</p>
            </div>
            <div class="guide-card">
              <div class="guide-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <h3>Family situation</h3>
              <p>If you have children or a non-working spouse to insure, compare total family costs — the difference can be hundreds per month.</p>
            </div>
            <div class="guide-card">
              <div class="guide-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              </div>
              <h3>Health history</h3>
              <p>Some insurers are more lenient with minor pre-existing conditions. A broker can run anonymous pre-screening before you apply.</p>
            </div>
            <div class="guide-card">
              <div class="guide-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </div>
              <h3>English support</h3>
              <p>For expats, English-speaking customer service and English claims forms makes a significant practical difference day to day.</p>
            </div>
            <div class="guide-card guide-card-cta">
              <p>The most reliable way to find your best match is through a licensed independent broker who can compare exact quotes for your profile.</p>
              <a href="/contact" class="btn-primary">Get matched with a broker →</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  .page-wrap { padding-bottom: 5rem; }

  /* Breadcrumb */
  .breadcrumb ol { display: flex; align-items: center; gap: .4rem; list-style: none; flex-wrap: wrap; padding-top: 1.5rem; margin-bottom: 1.5rem; }
  .breadcrumb li { font-size: .8rem; color: var(--muted); }
  .breadcrumb a { color: var(--muted); transition: color var(--ease); }
  .breadcrumb a:hover { color: var(--text); }

  /* Hero header */
  .page-hero {
    background: linear-gradient(135deg, #0d2137 0%, #0a3040 50%, #0d3535 100%);
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(2rem, 5vw, 3rem);
    margin-bottom: 3rem;
  }
  .page-kicker {
    display: inline-block;
    font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--primary); background: rgba(0,201,167,.12);
    padding: 4px 12px; border-radius: 999px; margin-bottom: 1rem;
    border: 1px solid rgba(0,201,167,.2);
  }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.1;
    color: #fff; margin-bottom: .85rem;
  }
  .page-lead { font-size: 1.05rem; color: rgba(255,255,255,.65); line-height: 1.65; max-width: 560px; margin-bottom: 1.25rem; }
  .meta-row { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .meta-item {
    display: flex; align-items: center; gap: .4rem;
    font-size: .8rem; color: rgba(255,255,255,.45); font-weight: 500;
  }

  /* Grid */
  .grid-section { margin-bottom: 4rem; }
  .insurers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Card */
  .insurer-card {
    position: relative;
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: 20px;
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex; flex-direction: column; gap: .6rem;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    transform-style: preserve-3d;
    transition:
      transform .25s cubic-bezier(.2,.8,.4,1),
      box-shadow .25s cubic-bezier(.2,.8,.4,1),
      border-color .2s ease;
    box-shadow:
      0 1px 3px rgba(0,0,0,.06),
      0 4px 12px rgba(0,0,0,.05),
      0 0 0 0 var(--brand, #000);
  }
  .insurer-card:hover {
    transform: perspective(800px) rotateX(-4deg) rotateY(1deg) translateY(-8px);
    box-shadow:
      0 2px 4px rgba(0,0,0,.04),
      0 8px 24px rgba(0,0,0,.12),
      0 20px 40px rgba(0,0,0,.08),
      inset 0 1px 0 rgba(255,255,255,.8);
    border-color: var(--brand, var(--primary));
  }

  /* Top light edge for 3D effect */
  .card-edge {
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.6) 50%, transparent);
    pointer-events: none;
  }

  /* Rank chip */
  .card-rank {
    position: absolute; top: 1rem; right: 1rem;
    font-size: .68rem; font-weight: 800; letter-spacing: .04em;
    color: var(--muted); background: var(--surface);
    padding: 3px 9px; border-radius: 999px;
    border: 1px solid var(--border);
  }

  /* Avatar */
  .card-avatar {
    position: relative;
    width: 120px; height: 48px;
    background: var(--brand-bg, #f0f4ff);
    border: 1.5px solid color-mix(in srgb, var(--brand, #0055a4) 18%, transparent);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    padding: 6px 10px;
    margin-bottom: .25rem;
    flex-shrink: 0;
  }
  .avatar-logo {
    width: 100%; height: 100%;
    object-fit: contain;
    display: block;
  }
  .avatar-glow {
    position: absolute; inset: -4px; border-radius: 22px;
    background: var(--brand, #0055a4); opacity: 0;
    filter: blur(12px);
    transition: opacity .25s ease;
    z-index: -1;
  }
  .insurer-card:hover .avatar-glow { opacity: .15; }

  /* Head */
  .card-head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .card-name { font-size: 1.15rem; font-weight: 800; letter-spacing: -.03em; color: var(--text); }
  .card-badge {
    font-size: .62rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
    padding: 2px 8px; border-radius: 999px;
  }

  /* Score */
  .card-score { display: flex; align-items: center; gap: .3rem; }
  .score-num { font-size: 1.1rem; font-weight: 900; color: var(--brand, var(--primary)); letter-spacing: -.03em; }
  .score-stars { display: flex; gap: 1px; color: #f59e0b; }
  .score-label { font-size: .75rem; color: var(--muted); font-weight: 500; }

  /* Text */
  .card-tagline { font-size: .88rem; font-weight: 600; color: var(--text); line-height: 1.4; }
  .card-highlight { font-size: .82rem; color: var(--muted); line-height: 1.6; flex: 1; }

  /* Tags */
  .card-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .1rem; }
  .card-tag {
    font-size: .68rem; font-weight: 600; letter-spacing: .03em;
    color: var(--brand, var(--primary));
    background: var(--brand-bg, #f0f4ff);
    padding: 3px 9px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--brand, #0055a4) 15%, transparent);
  }

  /* CTA */
  .card-cta {
    display: flex; align-items: center; gap: .4rem; margin-top: .35rem;
    font-size: .8rem; font-weight: 700; color: var(--brand, var(--primary));
  }
  .cta-arrow { transition: transform .2s ease; }
  .insurer-card:hover .cta-arrow { transform: translateX(4px); }

  /* Guide section */
  .guide-section { padding-top: 1rem; }
  .guide-header { margin-bottom: 2rem; }
  .guide-header h2 { font-size: clamp(1.4rem, 3vw, 1.85rem); font-weight: 800; letter-spacing: -.03em; margin-bottom: .5rem; }
  .guide-header p { font-size: .95rem; color: var(--muted); }

  .guide-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
  }
  .guide-card {
    background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: 1.5rem; box-shadow: var(--sh-sm);
  }
  .guide-icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--primary); margin-bottom: .85rem;
  }
  .guide-card h3 { font-size: .95rem; font-weight: 700; letter-spacing: -.01em; margin-bottom: .4rem; }
  .guide-card p { font-size: .85rem; color: var(--muted); line-height: 1.65; }
  .guide-card-cta {
    background: linear-gradient(135deg, #0d2137, #0a3040);
    border-color: transparent;
    display: flex; flex-direction: column; justify-content: center; gap: 1.25rem;
  }
  .guide-card-cta p { color: rgba(255,255,255,.65); }

  /* Responsive */
  @media (max-width: 960px) {
    .insurers-grid { grid-template-columns: repeat(2, 1fr); }
    .guide-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .insurers-grid { grid-template-columns: 1fr; }
    .guide-grid { grid-template-columns: 1fr; }
    .insurer-card:hover { transform: translateY(-4px); }
  }
</style>
