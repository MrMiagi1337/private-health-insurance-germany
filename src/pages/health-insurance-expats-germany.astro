---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What health insurance do expats need in Germany?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All residents in Germany are legally required to have health insurance. Expats have three options: public public health insurance (mandatory for employees earning below €77,400/year), private private health insurance (available to high earners, self-employed, and civil servants), or expat/travel health insurance for short stays under 3 months."
          }
        },
        {
          "@type": "Question",
          "name": "Can expats get private health insurance in Germany?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Expats who are employed and earn above €77,400 gross per year can choose private health insurance. Self-employed expats can choose private health insurance at any income level. Private health insurance typically offers better coverage, faster specialist access, and English-speaking support."
          }
        },
        {
          "@type": "Question",
          "name": "How much does health insurance cost for expats in Germany?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Public health insurance contributions are 14.6% + supplement (~1.6%) of gross salary, split with your employer. A €70,000 salary means roughly €540/month total, ~€270 from you. Private health insurance for a healthy 30-year-old expat costs €210–360/month. Employers contribute up to €421/month toward private health insurance as well."
          }
        },
        {
          "@type": "Question",
          "name": "Which health insurance is best for expats in Germany?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For expats earning above €77,400/year, private health insurance is usually better: lower cost, better coverage, English service. For expats below the threshold, public health insurance is mandatory. Recommended private health insurers for expats: DKV, HanseMerkur, Allianz, Hallesche."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://private-health-insurance-germany.com/" },
        { "@type": "ListItem", "position": 2, "name": "Health Insurance for Expats in Germany", "item": "https://private-health-insurance-germany.com/health-insurance-expats-germany" }
      ]
    }
  ]
};

const options = [
  {
    name: 'Public public health insurance',
    tag: 'Mandatory below €77,400/yr',
    who: 'Employees below income threshold',
    cost: '~€270/month (employee share at €70k)',
    pros: ['Family members covered free', 'No health questionnaire', 'Employer pays ~50%'],
    cons: ['Premium scales with income', 'Longer specialist waits', 'Shared hospital rooms'],
    cta: '/public-health-insurance-germany',
    ctaLabel: 'Learn about public health insurance →',
  },
  {
    name: 'Private private health insurance',
    tag: 'Best for high earners & self-employed',
    who: 'Employees above €77,400/yr, freelancers',
    cost: '€210–480/month (age & plan dependent)',
    pros: ['Private hospital room', 'Direct specialist access', 'English-speaking insurers', 'Premium fixed at entry age'],
    cons: ['Separate premium per child', 'Health questionnaire required', 'Hard to switch back'],
    cta: '/private-health-insurance-germany',
    ctaLabel: 'Learn about private health insurance →',
    featured: true,
  },
  {
    name: 'Expat / Travel',
    tag: 'Short stays under 3 months',
    who: 'Visitors, job seekers, short-term arrivals',
    cost: '€50–150/month',
    pros: ['No long-term commitment', 'Covers visa requirements', 'Quick to obtain online'],
    cons: ['Not valid for residence permit', 'Limited coverage scope', 'Cannot switch to public health insurance directly'],
    cta: '/guide/for-foreigners',
    ctaLabel: 'Learn more →',
  },
];

const insurers = [
  { name: 'DKV',          tag: 'Best for expats',        href: '/top-insurers/dkv',         reason: 'English hotline, global coverage, digital claims' },
  { name: 'HanseMerkur',  tag: 'Most expat-friendly',    href: '/top-insurers/hansemerkur',  reason: 'Flexible tariffs, quick approval, expat-focused teams' },
  { name: 'Allianz',      tag: 'Premium international',  href: '/top-insurers/allianz',      reason: 'Worldwide coverage, premium hospitals, strong brand' },
  { name: 'Hallesche',    tag: 'Best for freelancers',   href: '/top-insurers/hallesche',    reason: 'Comprehensive coverage, strong financials, low rate increases' },
  { name: 'Debeka',       tag: 'Most stable premiums',   href: '/top-insurers/debeka',       reason: 'Largest private health insurer, consistently low premium increases' },
  { name: 'Barmenia',     tag: 'Best mental health',     href: '/top-insurers/barmenia',     reason: 'Excellent mental health coverage, modern app, fair claims' },
];
---

<Layout
  title="Health Insurance for Expats in Germany 2026 — Complete Guide"
  description="Everything expats need to know about health insurance in Germany: public vs private health insurance, who qualifies, what it costs, and the best insurers for internationals. Updated 2026."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="hero-inner container-wide">
      <div class="hero-content">
        <div class="hero-tag">Updated for 2026 · Expat-focused</div>
        <h1>Health Insurance for<br/><span class="h1-accent">Expats in Germany</span></h1>
        <p class="hero-sub">Germany requires all residents to have health insurance from day one. As an expat you have three options — and choosing the right one can save you hundreds of euros every month.</p>
        <div class="hero-actions">
          <a href="/contact" class="btn-hero">Get free broker advice →</a>
          <a href="/eligibility-check" class="btn-hero-ghost">Check my eligibility</a>
        </div>
        <div class="hero-trust">
          <span>§34d licensed brokers</span>
          <span class="sep">·</span>
          <span>Free of charge</span>
          <span class="sep">·</span>
          <span>English service</span>
        </div>
      </div>

      <div class="hero-cards">
        <div class="hcard hcard-active">
          <div class="hcard-label">Private private health insurance</div>
          <div class="hcard-price">€210<span>/mo</span></div>
          <div class="hcard-desc">Age 30 · mid-range plan · employer pays ~50%</div>
        </div>
        <div class="hcard">
          <div class="hcard-label">Public public health insurance</div>
          <div class="hcard-price">€270<span>/mo</span></div>
          <div class="hcard-desc">Your share at €70k salary · employer pays ~50%</div>
        </div>
        <div class="hcard-note">Most expats above €77,400/yr save with private health insurance</div>
      </div>
    </div>
  </section>

  <!-- ── STATS BAR ── -->
  <div class="stats-bar">
    <div class="container-wide stats-inner">
      <div class="stat-item"><span class="stat-num">€77,400</span><span class="stat-label">2026 income threshold for private health insurance</span></div>
      <div class="stat-div"></div>
      <div class="stat-item"><span class="stat-num">40+</span><span class="stat-label">Insurers compared</span></div>
      <div class="stat-div"></div>
      <div class="stat-item"><span class="stat-num">Day 1</span><span class="stat-label">Coverage required from arrival</span></div>
      <div class="stat-div"></div>
      <div class="stat-item"><span class="stat-num">100% free</span><span class="stat-label">Broker service, no fees</span></div>
    </div>
  </div>

  <!-- ── 3 OPTIONS ── -->
  <section class="section-white">
    <div class="container-wide">
      <div class="section-kicker">Your options</div>
      <h2 class="section-title">3 types of health insurance for expats</h2>
      <p class="section-intro">Which type you qualify for depends mainly on your employment status and income. Here is how they compare.</p>

      <div class="options-grid">
        {options.map(opt => (
          <div class:list={['option-card', opt.featured && 'option-featured']}>
            {opt.featured && <div class="featured-badge">Most popular for expats</div>}
            <div class="opt-header">
              <h3>{opt.name}</h3>
              <span class="opt-tag">{opt.tag}</span>
            </div>
            <div class="opt-who"><strong>Who:</strong> {opt.who}</div>
            <div class="opt-cost"><strong>Cost:</strong> {opt.cost}</div>
            <div class="opt-lists">
              <ul class="pros-list">
                {opt.pros.map(p => <li>{p}</li>)}
              </ul>
              <ul class="cons-list">
                {opt.cons.map(c => <li>{c}</li>)}
              </ul>
            </div>
            <a href={opt.cta} class="opt-cta">{opt.ctaLabel}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ELIGIBILITY ── -->
  <section class="section-gray">
    <div class="container-wide elig-grid">
      <div>
        <div class="section-kicker">Eligibility</div>
        <h2 class="section-title">Who can get private insurance?</h2>
        <p class="elig-intro">Private health insurance is not available to everyone. The German system has strict rules about who can opt out of public insurance.</p>
        <a href="/eligibility-check" class="btn-primary" style="display:inline-flex;align-items:center;gap:8px">Check your eligibility →</a>
      </div>
      <div class="elig-checks">
        <div class="check-item check-yes">
          <div class="check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
          <div>
            <strong>Employed above €77,400/year gross</strong>
            <p>You can opt into private health insurance if you earn above the 2026 Versicherungspflichtgrenze. You must have exceeded the threshold in the previous year too (or be starting a new job above it).</p>
          </div>
        </div>
        <div class="check-item check-yes">
          <div class="check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
          <div>
            <strong>Self-employed or freelancer</strong>
            <p>Freelancers (freiberuflich) and the self-employed (gewerblich) can choose private health insurance at any income level, from day one of self-employment.</p>
          </div>
        </div>
        <div class="check-item check-yes">
          <div class="check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
          <div>
            <strong>Civil servant (Beamter)</strong>
            <p>Beamte receive Beihilfe (50–80% government subsidy). Private health insurance covers the remainder, making it significantly cheaper than public health insurance for civil servants.</p>
          </div>
        </div>
        <div class="check-item check-no">
          <div class="check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></div>
          <div>
            <strong>Employed below the income threshold</strong>
            <p>If you earn below €77,400/year as an employee, public health insurance is mandatory. You cannot switch to private health insurance until your income exceeds the threshold for a full calendar year.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── COSTS ── -->
  <section class="section-white">
    <div class="container-wide">
      <div class="section-kicker">Cost comparison</div>
      <h2 class="section-title">What does health insurance cost expats in Germany?</h2>

      <div class="cost-table-wrap">
        <table class="cost-table">
          <thead>
            <tr>
              <th>Scenario</th>
              <th>Public health insurance</th>
              <th>Private health insurance</th>
              <th>Difference</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Employee, €70k salary, age 30</td>
              <td>~€540/mo total (€270 your share)</td>
              <td>~€460/mo total (€230 your share)</td>
              <td class="cost-save">Save ~€40/mo</td>
            </tr>
            <tr>
              <td>Employee, €90k salary, age 30</td>
              <td>~€660/mo total (€330 your share)</td>
              <td>~€460/mo total (€230 your share)</td>
              <td class="cost-save">Save ~€100/mo</td>
            </tr>
            <tr>
              <td>Freelancer, €60k income, age 35</td>
              <td>~€720/mo (full amount, no employer split)</td>
              <td>~€310–370/mo (full, no employer)</td>
              <td class="cost-save">Save ~€350/mo</td>
            </tr>
            <tr>
              <td>Civil servant, age 35</td>
              <td>Not eligible (must use private health insurance + Beihilfe)</td>
              <td>~€120–180/mo (after Beihilfe subsidy)</td>
              <td class="cost-save">Much cheaper</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">All figures approximate for 2026. Private health insurance amounts assume mid-range plan. Employer private health insurance contribution capped at ~€421/month. <a href="/calculator">Use the calculator for your exact numbers →</a></p>
    </div>
  </section>

  <!-- ── TOP INSURERS ── -->
  <section class="section-gray">
    <div class="container-wide">
      <div class="ins-header">
        <div>
          <div class="section-kicker">Insurer reviews</div>
          <h2 class="section-title">Best private health insurers for expats in Germany</h2>
        </div>
        <a href="/top-insurers" class="btn-outline">See all reviews →</a>
      </div>

      <div class="ins-grid">
        {insurers.map(ins => (
          <a href={ins.href} class="ins-card">
            <div class="ins-top">
              <div class="ins-avatar">{ins.name[0]}</div>
              <div class="ins-meta">
                <strong>{ins.name}</strong>
                <span class="ins-tag">{ins.tag}</span>
              </div>
            </div>
            <p class="ins-reason">{ins.reason}</p>
            <span class="ins-link">Full review →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ── -->
  <section class="section-white">
    <div class="container-wide">
      <div class="section-kicker">How to get insured</div>
      <h2 class="section-title">3 steps to health insurance as an expat</h2>
      <div class="steps-grid">
        <div class="step-item">
          <div class="step-num">01</div>
          <h3>Check eligibility</h3>
          <p>Answer 5 quick questions about your employment status, income, and age. Instant result — takes 2 minutes.</p>
          <a href="/eligibility-check" class="step-link">Take the eligibility check →</a>
        </div>
        <div class="step-arrow"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
        <div class="step-item">
          <div class="step-num">02</div>
          <h3>Get a broker comparison</h3>
          <p>A §34d licensed broker who speaks English reviews your situation, compares all major insurers, and gives you a clear recommendation.</p>
          <a href="/contact" class="step-link">Book free call →</a>
        </div>
        <div class="step-arrow"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
        <div class="step-item">
          <div class="step-num">03</div>
          <h3>Sign and start coverage</h3>
          <p>Your broker handles all paperwork and notifications to your previous insurer. Coverage starts within 2–4 weeks.</p>
          <a href="/checklist" class="step-link">See document checklist →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section-gray">
    <div class="container-wide faq-wrap">
      <div class="section-kicker">Common questions</div>
      <h2 class="section-title">Expat health insurance FAQ</h2>

      <div class="faq-grid">
        <details class="faq-item">
          <summary>Do I need health insurance from day one in Germany?</summary>
          <p>Yes. German law requires health insurance coverage to begin from the day you register your residence (Anmeldung). Your employer will normally enrol you automatically in public health insurance if you earn below the threshold. If you are self-employed or above the threshold, you must arrange coverage yourself before or on your first working day.</p>
        </details>
        <details class="faq-item">
          <summary>Can I keep my home country health insurance in Germany?</summary>
          <p>Only temporarily. EU citizens can use the European Health Insurance Card (EHIC) for short trips, but it does not satisfy the German residence insurance requirement. Non-EU expats, and EU expats staying longer than 3 months, must get German health insurance.</p>
        </details>
        <details class="faq-item">
          <summary>What happens if I lose my job — do I lose private health insurance?</summary>
          <p>If you become unemployed, you will normally switch back to public health insurance (through Arbeitslosengeld / job centre). Your private health insurance may offer an Anwartschaftsversicherung — a "dormant" policy at low cost that preserves your entry conditions so you can reactivate private health insurance later without a new health questionnaire.</p>
        </details>
        <details class="faq-item">
          <summary>Can my family be covered under my German health insurance?</summary>
          <p>In public health insurance, non-earning spouses and children are included free of charge (Familienversicherung). In private health insurance, each family member needs their own policy at an additional premium. This makes private health insurance less attractive for families with children and a non-working partner.</p>
        </details>
        <details class="faq-item">
          <summary>Which insurers offer English-speaking support?</summary>
          <p>Several private health insurers cater specifically to expats: DKV offers English customer service; HanseMerkur has expat-focused products; Allianz provides international coverage with English documentation. A broker can help you identify the best fit for your language needs.</p>
        </details>
        <details class="faq-item">
          <summary>Is a health questionnaire required for private health insurance?</summary>
          <p>Yes. All private health insurance applications include a health questionnaire about pre-existing conditions. You must answer truthfully. Minor conditions may lead to small premium surcharges or exclusions. Serious pre-existing conditions may require public health insurance. Misrepresentation can void your policy.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS ── -->
  <section class="section-white">
    <div class="container-wide">
      <div class="section-kicker">Expat stories</div>
      <h2 class="section-title">What other expats say</h2>
      <div class="testi-grid">
        <div class="testi-card">
          <p>"I came from India on a work visa with no idea how German health insurance works. The broker explained everything in plain English, compared three private health insurance quotes, and I was insured within two weeks. Saving €220/month vs public health insurance."</p>
          <div class="testi-author">
            <div class="testi-avatar">A</div>
            <div><strong>Arjun S.</strong><span>Software Engineer · Hamburg</span></div>
          </div>
        </div>
        <div class="testi-card">
          <p>"As a freelancer from the US I had no idea I could get affordable private insurance. The guide on this site was the clearest explanation I found. Ended up with DKV at €280/month — far less than I expected."</p>
          <div class="testi-author">
            <div class="testi-avatar">S</div>
            <div><strong>Sarah L.</strong><span>UX Designer · Berlin</span></div>
          </div>
        </div>
        <div class="testi-card">
          <p>"My employer in Frankfurt HR told me to just sign up to AOK. Glad I checked first — I qualified for private health insurance, get a private room in hospital, and pay less per month. The broker handled everything in under a week."</p>
          <div class="testi-author">
            <div class="testi-avatar">M</div>
            <div><strong>Marco B.</strong><span>Finance Manager · Frankfurt</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="section-cta">
    <div class="container-wide cta-inner">
      <h2>Find the right health insurance for your expat situation</h2>
      <p>A licensed §34d broker compares all major private health insurers for your age, income, and health profile. Free advice in English, no obligation, no commission from you.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn-hero">Get free broker advice →</a>
        <a href="/eligibility-check" class="btn-hero-ghost">Check eligibility first</a>
      </div>
      <div class="cta-meta">§34d licensed &nbsp;·&nbsp; GDPR compliant &nbsp;·&nbsp; Free for you &nbsp;·&nbsp; English service</div>
    </div>
  </section>

</Layout>

<style>
  /* ── HERO ── */
  .hero {
    background: linear-gradient(135deg, #0d2137 0%, #0a3040 45%, #0d3535 100%);
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 50% at 70% 50%, rgba(0,201,167,.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid; grid-template-columns: 1fr 340px;
    gap: clamp(3rem, 6vw, 5rem); align-items: center; position: relative;
  }
  .hero-tag {
    display: inline-block; font-size: .78rem; font-weight: 500;
    color: rgba(255,255,255,.55); background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    padding: 5px 14px; border-radius: 999px; margin-bottom: 1.75rem;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 900;
    letter-spacing: -.04em; line-height: 1.08; color: #fff; margin-bottom: 1.5rem;
  }
  .h1-accent { color: #00c9a7; display: block; }
  .hero-sub {
    font-size: clamp(.95rem, 1.4vw, 1.05rem); color: rgba(255,255,255,.6);
    max-width: 460px; line-height: 1.75; margin-bottom: 2.25rem;
  }
  .hero-actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .btn-hero {
    display: inline-flex; align-items: center;
    background: var(--primary); color: var(--ink);
    font-size: .95rem; font-weight: 800; padding: .9rem 1.8rem;
    border-radius: 10px; letter-spacing: -.01em;
    box-shadow: 0 4px 20px rgba(0,201,167,.35);
    transition: background var(--ease), transform var(--ease);
  }
  .btn-hero:hover { background: var(--primary-dk); transform: translateY(-1px); }
  .btn-hero-ghost {
    display: inline-flex; align-items: center;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.2);
    color: rgba(255,255,255,.85); font-size: .95rem; font-weight: 600;
    padding: .9rem 1.8rem; border-radius: 10px; backdrop-filter: blur(4px);
    transition: background var(--ease);
  }
  .btn-hero-ghost:hover { background: rgba(255,255,255,.14); }
  .hero-trust {
    display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
    font-size: .78rem; color: rgba(255,255,255,.4); font-weight: 500;
  }
  .sep { color: rgba(255,255,255,.2); }

  /* Hero cards */
  .hero-cards { display: flex; flex-direction: column; gap: .75rem; }
  .hcard {
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px; padding: 1.25rem 1.5rem; backdrop-filter: blur(8px);
  }
  .hcard-active {
    background: rgba(0,201,167,.12); border-color: rgba(0,201,167,.35);
  }
  .hcard-label { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.5); margin-bottom: .35rem; }
  .hcard-active .hcard-label { color: var(--primary); }
  .hcard-price { font-size: 2rem; font-weight: 900; letter-spacing: -.04em; color: #fff; }
  .hcard-price span { font-size: 1rem; font-weight: 500; color: rgba(255,255,255,.5); }
  .hcard-desc { font-size: .72rem; color: rgba(255,255,255,.4); margin-top: .25rem; }
  .hcard-note {
    font-size: .75rem; font-weight: 600; color: var(--primary);
    text-align: center; padding: .5rem;
    background: rgba(0,201,167,.08); border-radius: 8px;
  }

  /* ── STATS BAR ── */
  .stats-bar { background: var(--ink); padding: 1.25rem 0; }
