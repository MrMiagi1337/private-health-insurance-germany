<style>
  .legal-page {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    max-width: 720px;
  }

  .legal-header {
    margin-bottom: 2.5rem;
  }
  .legal-tag {
    display: inline-block;
    font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--muted); background: var(--border);
    padding: 3px 10px; border-radius: 999px;
    margin-bottom: .75rem;
  }
  .legal-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800; letter-spacing: -.03em;
    color: var(--text);
  }

  .legal-body {
    font-size: .95rem;
    line-height: 1.75;
    color: #3a3a42;
  }
  .legal-body h2 {
    font-size: 1rem; font-weight: 700;
    color: var(--text); margin: 2rem 0 .5rem;
    padding-bottom: .4rem;
    border-bottom: 1px solid var(--border);
  }
  .legal-body p { margin-bottom: .85rem; }
  .legal-body ul {
    margin: .5rem 0 1rem 1.25rem;
    display: flex; flex-direction: column; gap: .5rem;
  }
  .legal-body li { padding-left: .25rem; }
  .legal-body a {
    color: var(--red); text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-body strong { font-weight: 600; color: var(--text); }
</style>
