---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Do I Qualify for Private Health Insurance in Germany? (PKV Eligibility Quiz)"
  description="Find out in 2 minutes if you qualify for private health insurance (PKV) in Germany. Answer 5 quick questions about your employment, income, and age."
>
  <main>
    <section class="hero-section">
      <div class="container">
        <div class="hero-badge">2-minute quiz</div>
        <h1>Do you qualify for PKV?</h1>
        <p class="hero-sub">Answer 5 quick questions to find out if you're eligible for private health insurance in Germany — and whether it makes financial sense for you.</p>
      </div>
    </section>

    <section class="quiz-section">
      <div class="container quiz-container">

        <div class="progress-bar">
          <div class="progress-track">
            <div class="progress-fill" id="progressFill" style="width: 20%"></div>
          </div>
          <span class="progress-label" id="progressLabel">Question 1 of 5</span>
        </div>

        <div class="quiz-card" id="quizCard">

          <!-- Q1 -->
          <div class="question active" data-q="1">
            <h2>What is your employment status in Germany?</h2>
            <div class="options">
              <button class="option-btn" data-next="2" data-score="1" data-note="employed">
                <div class="option-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg></div>
                <div>
                  <strong>Employed (Angestellter)</strong>
                  <span>Working for a German employer</span>
                </div>
              </button>
              <button class="option-btn" data-next="2" data-score="2" data-note="freelancer">
                <div class="option-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div>
                <div>
                  <strong>Self-employed / Freelancer</strong>
                  <span>Working independently or running a business</span>
                </div>
              </button>
              <button class="option-btn" data-next="2" data-score="2" data-note="civil-servant">
                <div class="option-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
                <div>
                  <strong>Civil servant (Beamter)</strong>
                  <span>Working for the German public sector</span>
                </div>
              </button>
              <button class="option-btn" data-next="result-no" data-score="0" data-note="student">
                <div class="option-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></div>
                <div>
                  <strong>Student</strong>
                  <span>Enrolled at a German university</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Q2 -->
          <div class="question" data-q="2">
            <h2>What is your gross annual income?</h2>
            <p class="q-hint">The PKV income threshold in 2025 is €73,800/year (€6,150/month).</p>
            <div class="options">
              <button class="option-btn" data-next="3" data-score="2" data-note="income-high">
                <div class="option-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                <div>
                  <strong>Over €73,800 / year</strong>
                  <span>Above the Versicherungspflichtgrenze</span>
                </div>
              </button>
              <button class="option-btn" data-next="result-income" data-score="0" data-note="income-low">
                <div class="option-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                <div>
                  <strong>Under €73,800 / year</strong>
                  <span>Below the threshold (if employed)</span>
                </div>
              </button>
              <button class="option-btn" data-next="3" data-score="2" data-note="freelancer-any">
                <div class="option-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></div>
                <div>
                  <strong>I'm self-employed / freelancer</strong>
                  <span>No income threshold applies to me</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Q3 -->
          <div class="question" data-q="3">
            <h2>How old are you?</h2>
            <div class="options">
              <button class="option-btn" data-next="4" data-score="2">
                <div>
                  <strong>Under 35</strong>
                  <span>Best time to switch — lowest entry premium</span>
                </div>
              </button>
              <button class="option-btn" data-next="4" data-score="1">
                <div>
                  <strong>35 – 45</strong>
                  <span>Still likely advantageous</span>
                </div>
              </button>
              <button class="option-btn" data-next="4" data-score="0">
                <div>
                  <strong>46 – 55</strong>
                  <span>Needs careful comparison</span>
                </div>
              </button>
              <button class="option-btn" data-next="4" data-score="0">
                <div>
                  <strong>Over 55</strong>
                  <span>May not be financially advantageous</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Q4 -->
          <div class="question" data-q="4">
            <h2>Do you have dependants covered by your current insurance?</h2>
            <p class="q-hint">In GKV, dependants (spouse, children) can be insured for free. In PKV, each person needs their own policy.</p>
            <div class="options">
              <button class="option-btn" data-next="5" data-score="2">
                <div>
                  <strong>No — just me</strong>
                  <span>PKV is typically most cost-effective for singles</span>
                </div>
              </button>
              <button class="option-btn" data-next="5" data-score="1">
                <div>
                  <strong>Spouse or partner (also working)</strong>
                  <span>They can get their own PKV independently</span>
                </div>
              </button>
              <button class="option-btn" data-next="5" data-score="0">
                <div>
                  <strong>Spouse not working + children</strong>
                  <span>PKV costs add up — needs careful calculation</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Q5 -->
          <div class="question" data-q="5">
            <h2>How would you describe your current health?</h2>
            <div class="options">
              <button class="option-btn" data-next="result" data-score="2">
                <div>
                  <strong>Good — no significant conditions</strong>
                  <span>Standard underwriting, best rates available</span>
                </div>
              </button>
              <button class="option-btn" data-next="result" data-score="1">
                <div>
                  <strong>Average — minor conditions or medication</strong>
                  <span>May have loading or exclusions</span>
                </div>
              </button>
              <button class="option-btn" data-next="result" data-score="0">
                <div>
                  <strong>Pre-existing chronic conditions</strong>
                  <span>Significant loading likely — GKV may be better</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Results -->
          <div class="question result-screen" data-q="result" style="display:none">
            <div class="result-icon good">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h2>PKV looks like a strong fit for you</h2>
            <p>Based on your answers, you appear to meet the eligibility requirements for private health insurance in Germany and could benefit financially from switching.</p>
            <div class="result-points" id="resultPoints"></div>
            <a href="/contact" class="result-cta">Get a free personalised quote</a>
            <a href="/compare" class="result-link">Compare GKV vs PKV in detail</a>
          </div>

          <div class="question result-screen" data-q="result-income" style="display:none">
            <div class="result-icon warning">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
            </div>
            <h2>You may not be eligible yet</h2>
            <p>As an employed person, you need to earn above €73,800/year (the Versicherungspflichtgrenze) for 3 consecutive years before you can choose PKV.</p>
            <p>If you expect your income to increase, or if you move into self-employment or a civil servant role, eligibility opens up automatically.</p>
            <a href="/guide/who-qualifies" class="result-cta">Learn more about PKV eligibility</a>
          </div>

          <div class="question result-screen" data-q="result-no" style="display:none">
            <div class="result-icon warning">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
            </div>
            <h2>PKV isn't the right fit right now</h2>
            <p>As a student, the standard student GKV tariff (around €120/month) is usually the better choice. There are special student PKV tariffs, but they're rarely more economical.</p>
            <a href="/guide/who-qualifies" class="result-cta">Read the full eligibility guide</a>
          </div>

        </div>

      </div>
    </section>
  </main>
</Layout>

<script>
  let totalScore = 0;
  const totalQ = 5;

  function goTo(qId: string | number) {
    document.querySelectorAll('.question').forEach(q => {
      (q as HTMLElement).style.display = 'none';
      q.classList.remove('active');
    });

    const target = document.querySelector(`[data-q="${qId}"]`) as HTMLElement;
    if (target) {
      target.style.display = 'block';
      target.classList.add('active');
    }

    // Update progress
    const isResult = typeof qId === 'string' && qId.startsWith('result');
    const qNum = isResult ? totalQ : Math.min(Number(qId), totalQ);
    const pct = (qNum / totalQ) * 100;
    (document.getElementById('progressFill') as HTMLElement).style.width = pct + '%';
    document.getElementById('progressLabel')!.textContent = isResult
      ? 'Complete!'
      : `Question ${qNum} of ${totalQ}`;

    if (qId === 'result') {
      const pts = document.getElementById('resultPoints')!;
      const labels: Record<number, string> = {
        10: 'Excellent profile for PKV',
        8: 'Strong candidate for PKV',
        6: 'Good candidate — worth exploring',
        4: 'Mixed signals — careful comparison needed',
      };
      const label = Object.entries(labels).reverse().find(([k]) => totalScore >= Number(k));
      pts.innerHTML = label ? `<span class="score-badge">${label[1]}</span>` : '';
    }
  }

  document.querySelectorAll('.option-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const score = parseInt((btn as HTMLElement).dataset.score ?? '0');
      const next = (btn as HTMLElement).dataset.next ?? 'result';
      totalScore += score;
      goTo(next);
    });
  });
</script>

<style>
  main { background: var(--bg); }

  .hero-section {
    background: #fff;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2rem);
    text-align: center;
  }
  .container { max-width: 700px; margin: 0 auto; }
  .hero-badge {
    display: inline-block;
    background: #fef3c7; color: #d97706;
    font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    padding: .3rem .8rem; border-radius: 20px; margin-bottom: 1rem;
  }
  .hero-section h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: .75rem; }
  .hero-sub { font-size: 1.05rem; color: var(--muted); line-height: 1.65; }

  .quiz-section { padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 4vw, 2rem); }
  .quiz-container { max-width: 680px; }

  .progress-bar { margin-bottom: 1.5rem; }
  .progress-track { height: 6px; background: var(--border); border-radius: 3px; margin-bottom: .5rem; }
  .progress-fill { height: 100%; background: var(--red); border-radius: 3px; transition: width .4s ease; }
  .progress-label { font-size: .8rem; color: var(--muted); font-weight: 600; }

  .quiz-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .question { display: none; }
  .question.active { display: block; }

  .question h2 { font-size: 1.25rem; font-weight: 800; margin-bottom: .75rem; }
  .q-hint { font-size: .85rem; color: var(--muted); margin-bottom: 1.25rem; background: #f8f7f4; padding: .6rem 1rem; border-radius: 8px; }

  .options { display: flex; flex-direction: column; gap: .6rem; }
  .option-btn {
    display: flex; align-items: center; gap: 1rem;
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    text-align: left;
    cursor: pointer; font-family: inherit;
    transition: all var(--ease);
  }
  .option-btn:hover { border-color: var(--red); background: #fff8f8; }
  .option-btn .option-icon {
    width: 40px; height: 40px; flex-shrink: 0;
    background: var(--bg);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: var(--red);
  }
  .option-btn strong { display: block; font-size: .95rem; margin-bottom: .15rem; color: var(--text); }
  .option-btn span { font-size: .82rem; color: var(--muted); }

  /* Result screens */
  .result-screen { text-align: center; padding: 1rem 0; }
  .result-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.25rem;
  }
  .result-icon.good { background: #ecfdf5; color: #059669; }
  .result-icon.warning { background: #fffbeb; color: #d97706; }
  .result-screen h2 { font-size: 1.4rem; font-weight: 800; margin-bottom: .75rem; }
  .result-screen p { color: var(--muted); line-height: 1.65; margin-bottom: .75rem; font-size: .95rem; }

  .score-badge {
    display: inline-block;
    background: #ecfdf5; color: #059669;
    font-size: .8rem; font-weight: 700;
    padding: .3rem .9rem; border-radius: 20px;
    margin-bottom: 1.5rem;
  }
  .result-points { margin-bottom: 1.5rem; }

  .result-cta {
    display: block;
    background: var(--red); color: #fff;
    border-radius: 10px; padding: .85rem 1.5rem;
    font-weight: 700; font-size: .95rem;
    text-decoration: none; margin-bottom: .75rem;
    transition: background var(--ease);
  }
  .result-cta:hover { background: var(--red-dk); }
  .result-link {
    display: block; color: var(--muted); font-size: .88rem;
    text-decoration: none; transition: color var(--ease);
  }
  .result-link:hover { color: var(--red); }
</style>
