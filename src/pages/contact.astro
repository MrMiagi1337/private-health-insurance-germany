---
import Layout from '../layouts/Layout.astro';
import HeroCentered from '../components/sections/HeroCentered.astro';
import Section from '../components/sections/Section.astro';
import LeadForm from '../components/forms/LeadForm.astro';
---

<Layout
  title="Get Free Private Health Insurance Advice"
  description="Speak with a licensed §34d insurance broker about private health insurance in Germany. Free, no-obligation consultation for expats and freelancers."
>
  <main>
    <HeroCentered
      eyebrow="Free consultation"
      title="Get expert private health insurance advice"
      lead="Our independent consultants speak English and specialise in helping expats navigate Germany's health insurance system. No cost, no obligation."
    />
    <section class="form-wrap">
      <div class="container"><LeadForm source="phig-contact" /></div>
    </section>
    <Section end>
      <div class="opts">
        <a class="opt" href="tel:+4971196981720"><span class="opt-t">Call us</span><span class="opt-v">+49 711 96 98 17 20</span></a>
        <a class="opt" href="mailto:contact@private-health-insurance-germany.com"><span class="opt-t">Email us</span><span class="opt-v">contact@private-health-insurance-germany.com</span></a>
        <a class="opt" href="/eligibility-check"><span class="opt-t">Not ready to talk?</span><span class="opt-v">Start the Eligibility Check</span></a>
      </div>
    </Section>
  </main>
</Layout>

<style>
  .form-wrap { margin-top: 0; padding-top: 24px; position: relative; }
  @media (min-width: 960px) { .form-wrap { margin-top: -60px; padding-top: 0; } }
  .opts { display: grid; gap: 12px; }
  .opt { display: flex; flex-direction: column; gap: 4px; padding: 20px 24px; border: var(--border-w) solid var(--border); border-radius: var(--radius-card-sm); background: var(--surface); transition: border-color var(--ease); }
  .opt:hover { border-color: var(--blue); }
  .opt:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .opt-t { font-size: var(--fs-small); line-height: var(--lh-small); font-weight: var(--fw-btn); letter-spacing: .06em; text-transform: uppercase; color: var(--blue-dk); }
  .opt-v { font-weight: var(--fw-h3); color: var(--navy); overflow-wrap: anywhere; }
  @media (min-width: 900px) { .opts { grid-template-columns: repeat(3, 1fr); gap: 25px; } }
</style>
