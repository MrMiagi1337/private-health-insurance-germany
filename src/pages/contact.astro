---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Get Free PKV Advice"
  description="Speak with a licensed §34d insurance broker about private health insurance in Germany. Free, no-obligation consultation for expats and freelancers."
>
  <main>
    <section class="hero-section">
      <div class="container">
        <div class="hero-badge">Free Consultation</div>
        <h1>Get Expert PKV Advice</h1>
        <p class="hero-sub">Our licensed §34d insurance brokers speak English and specialize in helping expats navigate Germany's health insurance system. No cost, no obligation.</p>
      </div>
    </section>

    <section class="contact-section">
      <div class="container contact-grid">

        <div class="form-card">
          <h2>Tell us about your situation</h2>
          <p class="form-intro">Fill in the form and a broker will contact you within one business day.</p>

          <form class="contact-form" id="contactForm">
            <div class="field-row">
              <div class="field-group">
                <label for="firstName">First name *</label>
                <input type="text" id="firstName" name="firstName" required placeholder="Anna" />
              </div>
              <div class="field-group">
                <label for="lastName">Last name *</label>
                <input type="text" id="lastName" name="lastName" required placeholder="Schmidt" />
              </div>
            </div>

            <div class="field-group">
              <label for="email">Email address *</label>
              <input type="email" id="email" name="email" required placeholder="anna@example.com" />
            </div>

            <div class="field-group">
              <label for="employment">Employment status *</label>
              <select id="employment" name="employment" required>
                <option value="">Select your status</option>
                <option value="employed">Employed (Angestellter)</option>
                <option value="self-employed">Self-employed / Freelancer</option>
                <option value="civil-servant">Civil servant (Beamter)</option>
                <option value="student">Student</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="field-group">
              <label for="income">Gross monthly income (approx.) *</label>
              <select id="income" name="income" required>
                <option value="">Select range</option>
                <option value="under-5550">Under €5,550</option>
                <option value="5550-7000">€5,550 – €7,000</option>
                <option value="7000-10000">€7,000 – €10,000</option>
                <option value="over-10000">Over €10,000</option>
              </select>
            </div>

            <div class="field-group">
              <label for="situation">What are you looking for? *</label>
              <select id="situation" name="situation" required>
                <option value="">Select your goal</option>
                <option value="switch-to-pkv">Switch from GKV to PKV</option>
                <option value="new-to-germany">New to Germany, setting up insurance</option>
                <option value="compare-plans">Compare PKV plans and costs</option>
                <option value="already-pkv">Already in PKV, want to switch provider</option>
                <option value="general">General question about PKV</option>
              </select>
            </div>

            <div class="field-group">
              <label for="message">Anything else you'd like to share?</label>
              <textarea id="message" name="message" rows="4" placeholder="E.g. I moved to Berlin 6 months ago on a Blue Card, currently in TK (GKV)..."></textarea>
            </div>

            <div class="consent-row">
              <input type="checkbox" id="consent" name="consent" required />
              <label for="consent" class="consent-label">
                I agree that my data will be forwarded to a licensed insurance broker for the purpose of this consultation. <a href="/privacy">Privacy policy</a>.
              </label>
            </div>

            <button type="submit" class="submit-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Send my request
            </button>

            <p class="form-note">Usually replied to within 1 business day. All communication in English.</p>
          </form>

          <div class="success-msg" id="successMsg" style="display:none">
            <div class="success-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3>Request sent!</h3>
            <p>A licensed broker will reach out to you at your email address within one business day.</p>
          </div>
        </div>

        <aside class="info-panel">
          <div class="trust-card">
            <h3>What happens next</h3>
            <ol class="steps-list">
              <li>
                <span class="step-num">1</span>
                <div>
                  <strong>We review your details</strong>
                  <p>A §34d licensed broker looks at your employment and income to confirm PKV eligibility.</p>
                </div>
              </li>
              <li>
                <span class="step-num">2</span>
                <div>
                  <strong>You get a tailored comparison</strong>
                  <p>The broker compares plans from top insurers (Debeka, Allianz, DKV, etc.) and sends you a clear summary.</p>
                </div>
              </li>
              <li>
                <span class="step-num">3</span>
                <div>
                  <strong>You decide — no pressure</strong>
                  <p>Take your time. The consultation is free and there is no obligation to purchase anything.</p>
                </div>
              </li>
            </ol>
          </div>

          <div class="why-card">
            <h3>Why use a broker?</h3>
            <ul class="why-list">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Access to all major PKV providers, not just one
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                German bureaucracy explained in plain English
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Legally required to act in your interest (§34d GewO)
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                No extra cost — broker fee paid by the insurer
              </li>
            </ul>
          </div>

          <div class="contact-direct">
            <p>Prefer email?</p>
            <a href="mailto:contact@private-health-insurance-germany.com" class="email-link">contact@private-health-insurance-germany.com</a>
          </div>
        </aside>

      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const successMsg = document.getElementById('successMsg')!;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.style.display = 'none';
    successMsg.style.display = 'block';
  });
</script>

<style>
  main { background: var(--bg); }

  .hero-section {
    background: #fff;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2rem);
    text-align: center;
  }
  .container { max-width: 1140px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
  .hero-badge {
    display: inline-block;
    background: #ecfdf5; color: #059669;
    font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    padding: .3rem .8rem; border-radius: 20px; margin-bottom: 1rem;
  }
  .hero-section h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: .75rem; }
  .hero-sub { font-size: 1.05rem; color: var(--muted); max-width: 580px; margin: 0 auto; line-height: 1.65; }

  .contact-section { padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 4vw, 2rem); }
  .contact-grid { display: grid; grid-template-columns: 1fr 380px; gap: 2.5rem; align-items: start; }

  .form-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .form-card h2 { font-size: 1.3rem; font-weight: 800; margin-bottom: .4rem; }
  .form-intro { color: var(--muted); font-size: .9rem; margin-bottom: 1.75rem; }

  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field-group { display: flex; flex-direction: column; gap: .35rem; }
  .field-group label { font-size: .85rem; font-weight: 600; color: var(--text); }
  .field-group input,
  .field-group select,
  .field-group textarea {
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: .7rem 1rem;
    font-size: .92rem;
    font-family: inherit;
    color: var(--text);
    background: #fff;
    transition: border-color var(--ease);
    outline: none;
  }
  .field-group input:focus,
  .field-group select:focus,
  .field-group textarea:focus { border-color: var(--red); }
  .field-group textarea { resize: vertical; min-height: 100px; }

  .consent-row { display: flex; gap: .7rem; align-items: flex-start; }
  .consent-row input[type="checkbox"] { margin-top: .2rem; flex-shrink: 0; accent-color: var(--red); }
  .consent-label { font-size: .82rem; color: var(--muted); line-height: 1.5; }
  .consent-label a { color: var(--red); }

  .submit-btn {
    display: flex; align-items: center; justify-content: center; gap: .6rem;
    background: var(--red); color: #fff;
    border: none; border-radius: 10px;
    padding: .85rem 2rem;
    font-size: 1rem; font-weight: 700; font-family: inherit;
    cursor: pointer;
    transition: background var(--ease);
  }
  .submit-btn:hover { background: var(--red-dk); }
  .form-note { font-size: .8rem; color: var(--muted); text-align: center; margin-top: -.25rem; }

  .success-msg {
    text-align: center;
    padding: 3rem 1.5rem;
  }
  .success-icon {
    width: 60px; height: 60px;
    background: #ecfdf5; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #059669;
    margin: 0 auto 1.25rem;
  }
  .success-msg h3 { font-size: 1.4rem; font-weight: 800; margin-bottom: .5rem; }
  .success-msg p { color: var(--muted); }

  /* Side panel */
  .info-panel { display: flex; flex-direction: column; gap: 1.25rem; }
  .trust-card, .why-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .trust-card h3, .why-card h3 { font-size: 1rem; font-weight: 800; margin-bottom: 1.1rem; }

  .steps-list { list-style: none; display: flex; flex-direction: column; gap: 1.1rem; }
  .steps-list li { display: flex; gap: .9rem; align-items: flex-start; }
  .step-num {
    width: 26px; height: 26px; flex-shrink: 0;
    background: var(--red); color: #fff;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: .75rem; font-weight: 800;
  }
  .steps-list strong { font-size: .9rem; display: block; margin-bottom: .2rem; }
  .steps-list p { font-size: .82rem; color: var(--muted); margin: 0; line-height: 1.5; }

  .why-list { list-style: none; display: flex; flex-direction: column; gap: .65rem; }
  .why-list li { display: flex; align-items: flex-start; gap: .55rem; font-size: .88rem; color: var(--muted); line-height: 1.45; }
  .why-list svg { color: #059669; flex-shrink: 0; margin-top: .15rem; }

  .contact-direct {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    text-align: center;
  }
  .contact-direct p { font-size: .82rem; color: var(--muted); margin-bottom: .4rem; }
  .email-link { font-size: .85rem; font-weight: 600; color: var(--red); word-break: break-all; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
    .info-panel { order: -1; }
  }
  @media (max-width: 500px) {
    .field-row { grid-template-columns: 1fr; }
  }
</style>
