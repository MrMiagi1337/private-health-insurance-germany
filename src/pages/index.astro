  <script is:inline>

(function(){
  var inc=document.getElementById('inc'),incv=document.getElementById('incv'),mode='emp';
  var $=function(i){return document.getElementById(i)};
  var CEIL=5812.5,MAXPUB=1100,EMPCAP=508.59,age=$('age');
  // Illustrative age factors relative to a 32-year-old entering a mid-range plan (premium rises with entry age).
  var AF=[[20,.8],[25,.88],[30,.95],[32,1],[35,1.1],[40,1.3],[45,1.55],[50,1.85],[55,2.15],[60,2.4]];
  function af(a){for(var i=1;i<AF.length;i++)if(a<=AF[i][0]){var p=AF[i-1],q=AF[i];return p[1]+(q[1]-p[1])*(a-p[0])/(q[0]-p[0])}return AF[AF.length-1][1]}
  function share(full){return full-Math.min(full/2,EMPCAP)}
  function eur(n){return '€'+Math.round(n).toLocaleString('en-US')}
  // Bar length is proportional to the amount; the label moves outside when the bar is too short for it.
  function bar(id,val,txt){
    var f=$(id+'f'),l=$(id+'l'),pct=Math.min(val/MAXPUB,1)*100;
    f.style.width=pct+'%';l.textContent=txt;
    var w=f.parentNode.clientWidth*pct/100,fits=l.scrollWidth+28<=w;
    l.classList.toggle('out',!fits);
    l.style.left=fits?'14px':(w+12)+'px';
  }
  function calc(){
    var y=+inc.value,m=y/12,a=+age.value,k=af(a);incv.textContent=eur(y);$('agev').textContent=a;
    var pub,pl,ph,note,closed=false;
    if(mode==='self'){
      pub=Math.min(Math.max(m,1318.33),CEIL)*0.175;pl=300*k;ph=450*k;
      $('pubn').innerHTML='Public<br>you pay all';$('privn').innerHTML='Private<br>you pay';
      note='Public: 17.5% of income (14.6% general + 2.9% average additional), capped at the €5,812.50 monthly ceiling.';
    }else{
      pub=Math.min(m,CEIL)*0.0875;pl=share(300*k);ph=share(450*k);
      $('pubn').innerHTML='Public<br>employee share';$('privn').innerHTML='Private<br>employee share';
      note='Private health insurance is open to employees earning over €77,400 a year. Your employer pays up to half of the premium.';
      if(y<77400)closed=true;
    }
    $('closed').style.display=closed?'block':'none';
    $('bpriv').style.display=closed?'none':'grid';
    bar('pub',pub,eur(pub)+' /mo');
    bar('priv',ph,eur(pl)+'–'+eur(ph)+' /mo');
    $('note').textContent=note;
    $('ageh').style.display=a>45&&!closed?'block':'none';
    if(closed)$('note').textContent='Public: your share is 8.75% of income. '+'Private is not open yet at this income.';
  }
  inc.addEventListener('input',calc);age.addEventListener('input',calc);
  window.addEventListener('resize',calc);
  document.querySelectorAll('.toggle button').forEach(function(b){
    b.addEventListener('click',function(){
      mode=b.dataset.m;
      document.querySelectorAll('.toggle button').forEach(function(x){x.setAttribute('aria-pressed',x===b)});
      calc();
    });
  });
  calc();
  /* Eligibility Check */
  (function(){
    var root=$('elig'),steps={},back=$('elig-back'),again=$('elig-again'),stepL=$('elig-step');
    root.querySelectorAll('.estep').forEach(function(e){steps[e.dataset.s]=e});
    var R={
      'emp-yes':['Private health insurance is open to you.','Above \u20ac77,400 a year (2026 threshold) you can leave public insurance. Your employer pays up to half of the premium.'],
      'emp-no':['Not yet: you stay in public insurance for now.','Private health insurance opens for employees above \u20ac77,400 a year (2026). A broker can tell you if a raise or a job change would change that.'],
      'emp-unsure':["Let's check it together.",'The 2026 threshold is \u20ac77,400 gross a year, bonuses can count. A broker can check your contract with you.'],
      'self':['Private health insurance is open to you, from day one.','Self-employed people and freelancers can choose private health insurance at any income. The question is whether it fits your plans.'],
      'stu':['You can choose, once.','At the start of your studies you can opt out of public student insurance. That decision holds for your whole studies, so it is worth checking first.']
    };
    function show(k,focus){
      Object.keys(steps).forEach(function(x){steps[x].hidden=(x!==k)});
      back.hidden=(k==='1');again.hidden=(k!=='r');
      stepL.innerHTML=k==='r'?'Your result':'Question '+k+' of 2';
      if(focus){var h=steps[k].querySelector('h2,h3');if(h)h.focus({preventScroll:true})}
    }
    function result(key){var r=R[key];$('res-h').textContent=r[0];$('res-p').textContent=r[1];show('r',true)}
    root.querySelectorAll('.opt').forEach(function(b){
      b.addEventListener('click',function(){
        var a=b.dataset.a;
        if(a==='emp')show('2',true);
        else if(a==='self'||a==='stu')result(a);
        else result('emp-'+a);
      });
    });
    back.addEventListener('click',function(){show('1',true)});
    again.addEventListener('click',function(){show('1',true)});
    show('1',false);
  })();
  var els=document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion:reduce)').matches){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
    els.forEach(function(e){io.observe(e)});
  }else els.forEach(function(e){e.classList.add('in')});
})();
document.querySelectorAll('.rv-body').forEach(d=>{d.classList.add('clamp');if(d.scrollHeight<=d.clientHeight+2){d.classList.remove('clamp');return}const m=document.createElement('button');m.type='button';m.className='rv-more';m.textContent='Read more';m.setAttribute('aria-expanded','false');m.onclick=()=>{const o=d.classList.toggle('clamp');m.textContent=o?'Read more':'Show less';m.setAttribute('aria-expanded',String(!o))};d.after(m)});
{const t=document.querySelector('.rv-track'),s=d=>t.scrollBy({left:d*400});document.querySelector('.rv-prev').onclick=()=>s(-1);document.querySelector('.rv-next').onclick=()=>s(1)}
(()=>{const els=document.querySelectorAll('.cu');if(!els.length||matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window))return;
const fmt=(v,d)=>v.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
els.forEach(e=>{const to=+e.dataset.to,d=+(e.dataset.dec||0);e.textContent=fmt(0,d);
const io=new IntersectionObserver(([en])=>{if(!en.isIntersecting)return;io.disconnect();const t0=performance.now(),D=1600;
const step=t=>{const k=Math.min(1,(t-t0)/D),v=to*(1-Math.pow(1-k,4));e.textContent=fmt(k<1?(d?v:Math.round(v)):to,d);if(k<1)requestAnimationFrame(step)};requestAnimationFrame(step)},{threshold:.5});io.observe(e)})})();

  </script>
