---
import Layout from '../layouts/Layout.astro';

const tools = [
  { bg: '#eef3fe', color: '#2563eb', title: 'Eligibility Quiz', sub: 'Check if you qualify in 2 min', href: '/quiz' },
  { bg: '#f0fdf4', color: '#16a34a', title: 'Cost Calculator', sub: 'Estimate your PKV premium', href: '/calculator' },
  { bg: '#fef4ee', color: '#c2610a', title: 'Compare GKV vs PKV', sub: 'Side-by-side breakdown', href: '/compare' },
  { bg: '#f5f0ff', color: '#7c3aed', title: 'Document Checklist', sub: 'What you need to apply', href: '/checklist' },
];

const guides = [
  { title: 'Who qualifies for PKV?', href: '/guide/who-qualifies', desc: 'Income threshold, employment types, and age factors explained.' },
  { title: 'PKV costs in 2026', href: '/guide/costs-and-contributions', desc: 'Real monthly premiums by age, income, and plan level.' },
  { title: 'How to switch from GKV', href: '/guide/how-to-switch', desc: 'Step-by-step: notice periods, timing, and common mistakes.' },
  { title: 'PKV for freelancers', href: '/guide/for-freelancers', desc: 'Why self-employed people usually pay far less with PKV.' },
];

const insurers = [
  { name: 'Debeka', note: 'Best for civil servants & families', href: '/top-insurers/debeka' },
  { name: 'Allianz', note: 'Premium coverage, strong network', href: '/top-insurers/allianz' },
  { name: 'DKV', note: 'Largest private insurer in Germany', href: '/top-insurers/dkv' },
  { name: 'HanseMerkur', note: 'Great for expats, flexible plans', href: '/top-insurers/hansemerkur' },
  { name: 'Signal Iduna', note: 'Competitive rates, good service', href: '/top-insurers/signal-iduna' },
  { name: 'AXA', note: 'International-friendly, digital-first', href: '/top-insurers/axa' },
];
---

<Layout
  title="PKV Germany"
  description="Private health insurance in Germany for expats, explained in plain English. Compare GKV vs PKV, check eligibility, calculate your costs, and get matched with a licensed broker. Free."
>

  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-left">
        <div class="hero-kicker">Private Health Insurance Germany</div>
        <h1>Private health insurance in Germany — made simple for expats.</h1>
        <p>If you earn over €73,800/year or are self-employed, private health insurance (PKV) could save you €200–500/month compared to public GKV. We explain everything, in plain English.</p>
        <div class="hero-ctas">
          <a href="/quiz" class="btn-primary">Check my eligibility →</a>
          <a href="/private-health-insurance" class="btn-outline">Full PKV guide</a>
        </div>
        <div class="hero-trust">
          <span>✓ 100% free</span>
          <span>✓ Licensed brokers</span>
          <span>✓ English support</span>
          <span>✓ Updated 2026</span>
        </div>
      </div>
      <div class="hero-right" aria-hidden="true">
        <div class="hero-card hc-1">
          <div class="hc-label">GKV (public) at €70k salary</div>
          <div class="hc-amount hc-bad">€ 580 <span>/month</span></div>
          <div class="hc-note">Scales with income, no cap</div>
        </div>
        <div class="hero-card hc-2">
          <div class="hc-label">PKV (private) same person</div>
          <div class="hc-amount hc-good">€ 280 <span>/month</span></div>
          <div class="hc-note">Fixed by age and health, not income</div>
          <div class="hc-save">Save €300/month</div>
        </div>
        <div class="hero-card hc-3">
          <div class="hc-stat-num">10,000+</div>
          <div class="hc-stat-label">Expats helped to switch</div>
        </div>
      </div>
    </div>
  </section>

  <main>

    <section class="section container">
      <div class="sec-head"><h2>Quick tools</h2></div>
      <div class="tools-grid">
        {tools.map(t => (
          <a href={t.href} class="tool-card">
            <div class="tc-icon" style={`background:${t.bg};color:${t.color}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="tc-body">
              <div class="tc-title">{t.title}</div>
              <div class="tc-sub">{t.sub}</div>
            </div>
            <svg class="tc-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </section>

    <section class="section container">
      <a href="/private-health-insurance" class="pillar-banner">
        <div class="pb-left">
          <div class="pb-tag">Complete guide</div>
          <h2>Private Health Insurance in Germany (PKV)</h2>
          <p>Everything you need to know: how PKV works, who qualifies, what it costs, top providers, and how to get covered. Updated for 2026.</p>
          <span class="btn-white">Read the full guide →</span>
        </div>
        <div class="pb-card" aria-hidden="true">
          <div class="pb-card-label">What this covers</div>
          <ul>
            <li>GKV vs PKV explained</li>
            <li>2026 eligibility rules</li>
            <li>Real cost examples</li>
            <li>How to find the right plan</li>
            <li>Top providers compared</li>
          </ul>
        </div>
      </a>
    </section>

    <section class="section container">
      <div class="sec-head"><h2>PKV guides</h2></div>
      <div class="guides-grid">
        {guides.map(g => (
          <a href={g.href} class="guide-card">
            <div class="gc-title">{g.title}</div>
            <div class="gc-desc">{g.desc}</div>
            <span class="gc-link">Read guide →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section container">
      <div class="sec-head"><h2>Top insurers reviewed</h2></div>
      <div class="insurers-grid">
        {insurers.map(ins => (
          <a href={ins.href} class="ins-card">
            <div class="ins-name">{ins.name}</div>
            <div class="ins-note">{ins.note}</div>
            <span class="ins-link">Read review →</span>
          </a>
        ))}
      </div>
      <div class="ins-more">
        <a href="/top-insurers" class="btn-outline">See all 10 insurers</a>
      </div>
    </section>

    <section class="section container">
      <div class="sec-head"><h2>What expats say</h2></div>
      <div class="testi-grid">
        <div class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <p>"I was paying €540/month for GKV. After switching to PKV I pay €240/month. Same doctor, better coverage. Wish I'd done it sooner."</p>
          <div class="testi-author">James K., Software Engineer, Berlin</div>
        </div>
        <div class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <p>"As a freelancer I had no idea I could switch. The broker handled everything in English. It took two weeks and I save €280/month."</p>
          <div class="testi-author">Priya M., Consultant, Munich</div>
        </div>
        <div class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <p>"The eligibility quiz told me I qualified instantly. The guide explained the differences better than my German colleagues ever could."</p>
          <div class="testi-author">Thomas B., Finance Manager, Frankfurt</div>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="cta-block">
        <h2>Ready to find the right PKV plan?</h2>
        <p>Get matched with a licensed German insurance broker who speaks English. Free of charge, no obligation.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn-primary">Get free advice →</a>
          <a href="/quiz" class="btn-outline">Check eligibility first</a>
        </div>
        <div class="cta-note">§34d licensed brokers · GDPR compliant · Free for you</div>
      </div>
    </section>

  </main>

</Layout>

<style>
  .hero { background: var(--bg); border-bottom: 1px solid var(--border); padding: clamp(3rem, 7vw, 5rem) 0; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .hero-kicker {
    display: inline-block;
    font-size: .72rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
    color: var(--red); background: var(--red-lt); padding: 4px 12px; border-radius: 999px;
    margin-bottom: 1.25rem; border: 1px solid rgba(30,138,154,.2);
  }
  .hero h1 { font-size: clamp(2.4rem, 5.5vw, 4rem); font-weight: 900; letter-spacing: -.05em; line-height: .95; margin-bottom: 1.1rem; color: var(--text); }
  .hero p { font-size: clamp(.93rem, 1.5vw, 1.05rem); color: var(--muted); max-width: 440px; margin-bottom: 2rem; line-height: 1.65; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.5rem; }
  .hero-trust { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .hero-trust span { font-size: .8rem; color: var(--muted); font-weight: 500; }

  .hero-right { display: flex; flex-direction: column; gap: .75rem; }
  .hero-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 1.1rem 1.4rem; box-shadow: var(--sh-sm); }
  .hc-label { font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: .35rem; }
  .hc-amount { font-size: 1.8rem; font-weight: 900; letter-spacing: -.04em; line-height: 1; }
  .hc-amount span { font-size: .9rem; font-weight: 400; color: var(--muted); }
  .hc-bad { color: #dc2626; }
  .hc-good { color: #16a34a; }
  .hc-note { font-size: .78rem; color: var(--muted); margin-top: .3rem; }
  .hc-save { display: inline-block; margin-top: .6rem; background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; font-size: .75rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
  .hc-3 { background: var(--red-lt); border-color: rgba(30,138,154,.2); display: flex; align-items: center; gap: 1rem; }
  .hc-stat-num { font-size: 1.6rem; font-weight: 800; color: var(--red); }
  .hc-stat-label { font-size: .8rem; color: var(--red-dk); }

  .section { padding: clamp(2rem, 5vw, 3.5rem) 0; }

  .tools-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .tool-card {
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
    padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem;
    box-shadow: var(--sh-sm); transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
  }
  .tool-card:hover { transform: translateY(-2px); box-shadow: var(--sh-md); border-color: var(--red); }
  .tc-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .tc-body { flex: 1; }
  .tc-title { font-size: .9rem; font-weight: 700; color: var(--text); }
  .tc-sub { font-size: .78rem; color: var(--muted); margin-top: 2px; }
  .tc-arrow { color: var(--muted); flex-shrink: 0; }

  .pillar-banner {
    background: linear-gradient(135deg, #1e8a9a 0%, #0f5f6d 100%);
    border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2.25rem);
    display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center;
    box-shadow: 0 8px 30px rgba(30,138,154,.25);
    transition: transform var(--ease), box-shadow var(--ease);
    position: relative; overflow: hidden;
  }
  .pillar-banner::before { content: ''; position: absolute; right: -40px; top: -40px; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,.07); }
  .pillar-banner:hover { transform: translateY(-2px); box-shadow: 0 16px 48px rgba(30,138,154,.35); }
  .pb-tag { display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; background: rgba(255,255,255,.2); color: #fff; padding: 3px 10px; border-radius: 999px; margin-bottom: .75rem; }
  .pillar-banner h2 { font-size: clamp(1.1rem, 2.5vw, 1.45rem); font-weight: 800; color: #fff; letter-spacing: -.02em; margin-bottom: .5rem; }
  .pillar-banner p { font-size: .9rem; color: rgba(255,255,255,.85); max-width: 420px; line-height: 1.55; margin-bottom: 1.25rem; }
  .pb-card { background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.22); border-radius: 12px; padding: 1.1rem 1.25rem; min-width: 180px; flex-shrink: 0; position: relative; z-index: 1; }
  .pb-card-label { font-size: .7rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.7); margin-bottom: .7rem; }
  .pb-card ul { list-style: none; display: flex; flex-direction: column; gap: .35rem; }
  .pb-card li { font-size: .78rem; color: rgba(255,255,255,.88); padding-left: 1.1rem; position: relative; }
  .pb-card li::before { content: '✓'; position: absolute; left: 0; color: rgba(255,255,255,.6); font-size: .7rem; }

  .guides-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .guide-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem 1.5rem; box-shadow: var(--sh-sm); display: flex; flex-direction: column; gap: .35rem; transition: transform var(--ease), box-shadow var(--ease); }
  .guide-card:hover { transform: translateY(-2px); box-shadow: var(--sh-md); }
  .gc-title { font-size: .95rem; font-weight: 700; color: var(--text); }
  .gc-desc { font-size: .83rem; color: var(--muted); line-height: 1.55; flex: 1; }
  .gc-link { font-size: .8rem; font-weight: 700; color: var(--red); margin-top: .5rem; }

  .insurers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .ins-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem 1.25rem; box-shadow: var(--sh-sm); display: flex; flex-direction: column; gap: .3rem; transition: transform var(--ease), box-shadow var(--ease); }
  .ins-card:hover { transform: translateY(-2px); box-shadow: var(--sh-md); }
  .ins-name { font-size: .95rem; font-weight: 800; color: var(--text); }
  .ins-note { font-size: .8rem; color: var(--muted); flex: 1; }
  .ins-link { font-size: .78rem; font-weight: 700; color: var(--red); margin-top: .4rem; }
  .ins-more { text-align: center; }

  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .testi-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem 1.5rem; box-shadow: var(--sh-sm); }
  .testi-stars { color: #f59e0b; font-size: 1rem; margin-bottom: .6rem; }
  .testi-card p { font-size: .85rem; color: var(--text); line-height: 1.6; margin-bottom: .75rem; font-style: italic; }
  .testi-author { font-size: .75rem; color: var(--muted); font-weight: 600; }

  .cta-block { background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius); padding: clamp(2rem, 5vw, 3rem); text-align: center; box-shadow: var(--sh-sm); }
  .cta-block h2 { font-size: clamp(1.2rem, 3vw, 1.6rem); font-weight: 800; letter-spacing: -.03em; margin-bottom: .5rem; }
  .cta-block p { font-size: .95rem; color: var(--muted); margin-bottom: 1.5rem; max-width: 480px; margin-left: auto; margin-right: auto; }
  .cta-btns { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1rem; }
  .cta-note { font-size: .78rem; color: var(--muted); }

  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-right { display: none; }
    .pillar-banner { grid-template-columns: 1fr; }
    .pb-card { display: none; }
    .tools-grid { grid-template-columns: 1fr; }
    .guides-grid { grid-template-columns: 1fr; }
    .insurers-grid { grid-template-columns: repeat(2, 1fr); }
    .testi-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) { .insurers-grid { grid-template-columns: 1fr; } }
</style>
