---
import Layout from '../layouts/Layout.astro';
import HeroHome from '../components/sections/HeroHome.astro';
import TrustTabs from '../components/sections/TrustTabs.astro';
import Section from '../components/sections/Section.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import WhyTabs from '../components/sections/WhyTabs.astro';
import KeyFactsPanel from '../components/sections/KeyFactsPanel.astro';
import HighlightsCarousel from '../components/sections/HighlightsCarousel.astro';
import ReliabilityRow from '../components/sections/ReliabilityRow.astro';
import CalculatorBand from '../components/sections/CalculatorBand.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import AudienceCard from '../components/ui/AudienceCard.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import KnowledgeCard from '../components/ui/KnowledgeCard.astro';
import TrustChip from '../components/ui/TrustChip.astro';
import GuideCard from '../components/ui/GuideCard.astro';
import GuideCarousel from '../components/ui/GuideCarousel.astro';
import KeyFigures from '../components/ui/KeyFigures.astro';
import Icon from '../components/ui/Icon.astro';
import LeadForm from '../components/forms/LeadForm.astro';

const faqs = [
  { q: 'Who can choose private health insurance in Germany?', a: 'Employees who earn above the income threshold, self-employed people and freelancers, and civil servants can usually choose private cover. Students can choose a student tariff. The Eligibility Check shows which route applies to you.' },
  { q: 'How are private health insurance premiums calculated?', a: 'Your premium is set by your age at entry, your health and the level of cover you choose. It does not rise with your salary, which is the main difference from public health insurance.' },
  { q: 'Do I need to speak German?', a: 'No. Our independent consultants work in English, and several insurers offer full English-language service.' },
  { q: 'How long does it take to get covered?', a: 'Policies typically start within 2 to 4 weeks of the application. Your consultant handles the paperwork with you.' },
  { q: 'What does the advice cost?', a: 'Nothing. The consultation and the comparison are free of charge and without obligation.' },
  { q: 'Can I go back to public health insurance later?', a: 'Only in limited cases, for example if your income drops below the threshold for an extended period. Think carefully before you switch and talk to an independent consultant first.' },
];

const audiences = [
  { title: 'Employees', icon: 'briefcase', text: 'Compare cover and contributions if you earn above the income threshold and work for a German employer.', href: '/guide/who-qualifies' },
  { title: 'Self-employed &amp; freelancers', icon: 'laptop', text: 'Freelancers and founders can choose freely. See how to protect your income and your health.', href: '/guide/for-freelancers' },
  { title: 'Students', icon: 'cap', text: 'Study-specific options built for your time at a German university.', href: '/guide/for-students' },
  { title: 'Civil servants', icon: 'building', text: 'Cover that works alongside the state allowance for public-sector employees.', href: '/private-health-insurance' },
  { title: 'Families', icon: 'family', text: 'What changes for partners and children, and what each choice costs.', href: '/guide/costs-and-contributions' },
  { title: 'New arrivals', icon: 'globe', text: 'Clear cover and full support in English, without the paperwork.', href: '/guide/for-foreigners' },
] as const;
---

<Layout
  title="Private Health Insurance in Germany 2026 — Costs & Expat Guide"
  description="Private health insurance in Germany for expats, in plain English: compare public vs private health insurance, check eligibility, estimate costs, and get matched with a broker."
>
  <main>
    <!-- S1 -->
    <HeroHome />

    <!-- S2 -->
    <div class="s2"><TrustTabs /></div>

    <!-- S3 -->
    <Section variant="band">
      <h2>Cover options for your situation</h2>
      <p class="intro-p">Different rules apply depending on your employment status, so start with the group that fits you best.</p>
      <div class="grid-3 mt">
        {audiences.map((a) => (
          <AudienceCard title={a.title} text={a.text} href={a.href}><Icon slot="icon" name={a.icon} /></AudienceCard>
        ))}
      </div>

      <!-- S4 (same band as S3, as in the reference) -->
      <div class="s4">
      <h2>Tools that do the maths</h2>
      <p class="intro-p">Three free tools to get you from question to answer.</p>
      <div class="grid-3 mt">
        <ToolCard icon="checklist" tone="blue" title="Eligibility Check" text="Find out in two minutes whether private health insurance is open to you." href="/eligibility-check" />
        <ToolCard icon="calculator" tone="green" title="Cost calculator" text="Estimate your monthly contribution based on age, income and cover." href="/calculator" />
        <ToolCard icon="scale" tone="gold" title="Public vs private comparison" text="Benefits, costs and flexibility side by side, with no sales pitch." href="/compare" />
      </div>
      </div>
    </Section>

    <!-- S5 -->
    <Section>
      <SectionIntro eyebrow="Why us" title="Why people choose us" />
      <div class="mt"><WhyTabs /></div>
    </Section>

    <!-- S6 -->
    <Section>
      <KeyFactsPanel />
    </Section>

    <!-- S7 -->
    <Section variant="band">
      <SectionIntro eyebrow="Why independent advice" title="What you can count on." />
      <div class="mt"><KeyFigures /></div>
    </Section>

    <!-- S8 -->
    <Section>
      <SectionIntro eyebrow="Security" title="How we handle your data." />
      <div class="chips">
        <TrustChip icon="lock" title="Encrypted" sub="in transit and at rest" />
        <TrustChip icon="globe" title="Servers in Germany" sub="GDPR compliant" />
        <TrustChip icon="award" title="Registered" sub="under §34d GewO" />
      </div>
      <div class="s8b">
        <SectionIntro eyebrow="Our promise" title="Independent consultants on your side." lead="We compare the market for you instead of selling one insurer's product, and we explain every step in plain English." />
        <div class="cols3">
          <div class="col"><h3><Icon name="scale" size={24} />Independent</h3><p>No insurer ties. The comparison starts from your needs, not from a sales target.</p></div>
          <div class="col"><h3><Icon name="globe" size={24} />In English</h3><p>From the first call to the signed policy, we work in English and translate the German terms.</p></div>
          <div class="col"><h3><Icon name="shield" size={24} />Free of charge</h3><p>The consultation and the comparison cost you nothing and come without obligation.</p></div>
        </div>
      </div>
    </Section>

    <!-- S9 -->
    <Section>
      <HighlightsCarousel />
    </Section>

    <!-- S10 -->
    <Section>
      <ReliabilityRow />
    </Section>

    <!-- S11 -->
    <div class="s11">
      <CalculatorBand
        title="What will private cover cost you?"
        text="Premiums depend on your age at entry, your health and your plan level. Try the calculator for a realistic range based on your own situation."
        image="/images/photos/row-woman-coworking.jpg"
        imageAlt="Expat professional working on a laptop in a coworking space"
      />
    </div>

    <!-- S12 -->
    <Section>
      <LeadForm source="phig-home" />
    </Section>

    <!-- S13 -->
    <Section>
      <GuideCarousel title="Understand your options before you commit">
        <GuideCard title="Who qualifies for private health insurance?" excerpt="Income, job status and residence decide whether private cover is open to you." href="/guide/who-qualifies" eyebrow="Guide" readTime="6 min read" image="/images/photos/pillar-selfemployed-studio.jpg" alt="Self-employed creative working in a bright studio" />
        <GuideCard title="Costs and contributions explained" excerpt="What drives your premium and what you can expect to pay each month." href="/guide/costs-and-contributions" eyebrow="Costs" readTime="8 min read" image="/images/photos/pillar-family-park.jpg" alt="Family spending time together in a park" />
        <GuideCard title="Health insurance for freelancers" excerpt="How to stay covered and protect your income when you work for yourself." href="/guide/for-freelancers" eyebrow="Freelancers" readTime="7 min read" image="/images/photos/pillar-student-campus.jpg" alt="People walking across a university campus" />
        <GuideCard title="How to switch your health insurance" excerpt="Notice periods, timing and the steps to change cover without gaps." href="/guide/how-to-switch" eyebrow="Switching" readTime="6 min read" image="/images/photos/pillar-expats-street.jpg" alt="Expats walking along a city street" />
        <GuideCard title="Health insurance for foreigners" excerpt="What newcomers need to know about cover, visas and registration." href="/guide/for-foreigners" eyebrow="Newcomers" readTime="7 min read" image="/images/photos/article-berlin-dusk.jpg" alt="Berlin skyline at dusk" />
        <GuideCard title="Opening a bank account in Germany" excerpt="The documents you need and how the account connects to your insurance." href="/guide/bank-account" eyebrow="Getting started" readTime="5 min read" image="/images/photos/not-sure-man-kitchen.jpg" alt="Man reviewing documents in his kitchen" />
      </GuideCarousel>
    </Section>

    <!-- S14 -->
    <Section>
      <SectionIntro title="Learn before you decide." lead="A switch should be well thought through. We help you decide with the facts that matter most." />
      <div class="grid-3 mt">
        <KnowledgeCard title="The essentials,<br />short and clear." label="Read the guides" icon="arrow" href="/guide" />
        <KnowledgeCard title="Public vs private<br />Which fits you?" label="Open the comparison" icon="scale" href="/compare" />
        <KnowledgeCard title="Is it worth it?<br />Find out." label="Cost calculator" icon="calculator" href="/calculator" />
      </div>
    </Section>

    <!-- S15 -->
    <Section>
      <SectionIntro title="Frequently asked questions" />
      <div class="mt"><FaqAccordion items={faqs} /></div>
    </Section>

    <!-- S16 -->
    <Section end>
      <CtaBand title="Find out which private health insurance fits you" buttonText="Check my eligibility" href="/eligibility-check" />
    </Section>
  </main>
</Layout>

<style>
  .s2 { margin-top: 32px; }
  .s4 { margin-top: var(--section-pad-alt-mobile); }
  .s11 { margin-top: var(--section-y-mobile); }
  .intro-p { margin-top: 16px; max-width: 1120px; font-size: var(--fs-intro); line-height: var(--lh-intro); color: var(--text); }
  .mt { margin-top: 32px; }
  .chips { display: grid; gap: 16px; margin-top: 40px; }
  .s8b { margin-top: 64px; }
  .cols3 { display: grid; gap: 32px; margin-top: 40px; text-align: center; }
  .col { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding-top: 20px; border-top: 1px solid var(--border); text-align: left; }
  .col h3 { margin: 0; display: flex; align-items: center; gap: 10px; }
  .col h3 :global(svg) { flex: none; color: var(--blue); }
  .col p { margin: 0; max-width: 340px; }
  @media (min-width: 900px) {
    .s2 { margin-top: 54px; }
    .s4 { margin-top: var(--section-pad-alt); }
    .s11 { margin-top: var(--section-y); }
    .mt { margin-top: 48px; }
    .chips { display: flex; flex-wrap: wrap; justify-content: center; }
    .s8b { margin-top: 100px; }
    .cols3 { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
</style>
