---
import Layout from '../layouts/Layout.astro';

const featuredGuides = [
  { emoji: '🏙️', title: 'Move to Berlin',    href: '/guides/moving-to-berlin',  desc: 'Your complete relocation checklist' },
  { emoji: '💼', title: 'Find a job',         href: '/guides/find-a-job',        desc: 'Job market, visa & work permits'   },
  { emoji: '🏪', title: 'Start a business',   href: '/guides/start-a-business',  desc: 'Freelance, GmbH & tax setup'       },
];

const needGuides = [
  { emoji: '🏠', title: 'An apartment',        href: '/guides/find-an-apartment'   },
  { emoji: '📋', title: 'An Anmeldung',        href: '/guides/anmeldung'           },
  { emoji: '🏦', title: 'A bank account',      href: '/guides/bank-account'        },
  { emoji: '🏥', title: 'Health insurance',    href: '/guides/health-insurance'    },
  { emoji: '🛡️', title: 'Liability insurance', href: '/guides/liability-insurance' },
  { emoji: '📊', title: 'A Schufa',            href: '/guides/schufa'              },
  { emoji: '🚲', title: 'A bicycle',           href: '/guides/bicycle'             },
  { emoji: '🚗', title: 'A vehicle',           href: '/guides/buy-a-car'           },
  { emoji: '🤝', title: 'Professional help',   href: '/guides/professional-help'   },
];
---

<Layout
  title="Living in Germany"
  description="Step-by-step guides for expats moving to, living in, and thriving in Germany — in plain English. Apartments, Anmeldung, health insurance & more."
>

  <!-- ── Hero ── -->
  <section class="hero" aria-labelledby="hero-h1">
    <svg class="skyline" viewBox="0 0 960 160" fill="currentColor" aria-hidden="true">
      <rect x="476" y="15" width="5" height="145"/>
      <ellipse cx="478" cy="62" rx="20" ry="24"/>
      <rect x="475" y="5" width="7" height="14"/>
      <rect x="190" y="72" width="11" height="88"/><rect x="212" y="72" width="11" height="88"/>
      <rect x="234" y="72" width="11" height="88"/><rect x="256" y="72" width="11" height="88"/>
      <rect x="278" y="72" width="11" height="88"/>
      <rect x="183" y="66" width="113" height="12"/><rect x="188" y="50" width="103" height="20"/>
      <ellipse cx="650" cy="70" rx="44" ry="30"/>
      <rect x="614" y="94" width="72" height="66"/>
      <rect x="30" y="105" width="38" height="55"/><rect x="78" y="88" width="28" height="72"/>
      <rect x="118" y="118" width="24" height="42"/><rect x="355" y="98" width="32" height="62"/>
      <rect x="398" y="115" width="20" height="45"/><rect x="540" y="90" width="38" height="70"/>
      <rect x="590" y="118" width="22" height="42"/><rect x="740" y="98" width="40" height="62"/>
      <rect x="792" y="82" width="28" height="78"/><rect x="832" y="112" width="32" height="48"/>
      <rect x="876" y="96" width="38" height="64"/>
    </svg>

    <div class="hero-inner">
      <div class="hero-pill" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/></svg>
        Berlin, Germany
      </div>

      <h1 id="hero-h1">Your life in Germany,<br><span>made easy</span></h1>
      <p>Step-by-step guides for expats moving to, living in, and thriving in Germany — in plain English.</p>

      <div class="hero-ctas">
        <a href="/guides" class="btn-primary">
          Explore all guides
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/guides/health-insurance" class="btn-outline">
          Health insurance →
        </a>
      </div>
    </div>
  </section>

  <!-- ── Trust bar ── -->
  <div class="trust" role="complementary" aria-label="Why expats trust us">
    <div class="trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <span>Free guides, always</span>
    </div>
    <div class="trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Updated regularly</span>
    </div>
    <div class="trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>10,000+ expats helped</span>
    </div>
    <div class="trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>Expert-reviewed</span>
    </div>
  </div>

  <!-- ── Main ── -->
  <main class="container section-pad">

    <!-- Health insurance spotlight — MHB money page -->
    <section aria-labelledby="ins-heading">
      <div class="sec-head"><h2>Featured</h2></div>

      <a href="/guides/health-insurance" class="feature-banner" aria-label="Private health insurance guide for expats in Germany">
        <div class="fb-body">
          <div class="fb-tag" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Most important for expats
          </div>
          <h2 id="ins-heading">Private Health Insurance in Germany</h2>
          <p>GKV or PKV? If you earn over €77,400/year you may qualify — and could save up to €300/month. We explain everything in plain English.</p>
          <span class="btn-white">
            Find the right plan
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
        <svg class="fb-shield" viewBox="0 0 64 64" fill="white" aria-hidden="true">
          <path d="M32 4L8 14v18c0 13.3 10.3 25.7 24 29 13.7-3.3 24-15.7 24-29V14L32 4z"/>
          <path d="M22 32l7 7 13-13" stroke="rgba(214,76,43,.7)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </section>

    <!-- Top 3 goals -->
    <section aria-labelledby="start-heading">
      <div class="sec-head"><h2 id="start-heading">Start here</h2></div>

      <div class="featured-grid">
        {featuredGuides.map(g => (
          <a href={g.href} class="f-card" aria-label={`Guide: ${g.title}`}>
            <div class="f-icon" aria-hidden="true">{g.emoji}</div>
            <div class="f-content">
              <span class="f-title">{g.title}</span>
              <span class="f-desc">{g.desc}</span>
            </div>
            <span class="f-arrow" aria-hidden="true">Read guide →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- What do you need -->
    <section aria-labelledby="needs-heading">
      <div class="sec-head"><h2 id="needs-heading">What do you need?</h2></div>

      <div class="needs-grid">
        {needGuides.map(g => (
          <a href={g.href} class="n-card" aria-label={`Guide: ${g.title}`}>
            <div class="n-icon" aria-hidden="true">{g.emoji}</div>
            <span>{g.title}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- See all -->
    <div class="cta-row">
      <a href="/guides" class="btn-primary">
        See all guides
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Newsletter -->
    <section class="newsletter" aria-labelledby="nl-heading">
      <div class="nl-icon" aria-hidden="true">📬</div>
      <h2 id="nl-heading">Stay one step ahead</h2>
      <p>Get the latest expat guides, bureaucracy tips, and Berlin news straight to your inbox. No spam, ever.</p>
      <form class="nl-form" onsubmit="return false" aria-label="Newsletter signup">
        <input type="email" placeholder="your@email.com" aria-label="Your email address" required />
        <button type="submit" class="btn-primary">Subscribe free</button>
      </form>
      <span class="nl-note">Join 10,000+ expats. Unsubscribe anytime.</span>
    </section>

  </main>
</Layout>

<style>
  .hero {
    background: linear-gradient(160deg, #fff9f7 0%, var(--red-lt) 60%, #fff 100%);
    border-bottom: 1px solid var(--border);
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 6vw, 5rem);
    text-align: center; position: relative; overflow: hidden;
  }
  .skyline {
    position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 100%; max-width: 960px; opacity: .07; pointer-events: none;
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero-pill {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--red); color: #fff;
    font-size: .75rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
    padding: 4px 13px; border-radius: 999px; margin-bottom: 1.4rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -.035em; line-height: 1.12; margin-bottom: .8rem;
  }
  .hero h1 span { color: var(--red); }
  .hero p {
    font-size: clamp(.98rem, 1.8vw, 1.15rem);
    color: var(--muted); max-width: 500px; margin: 0 auto 2rem;
  }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center; }

  .trust {
    background: var(--card); border-bottom: 1px solid var(--border);
    padding: .9rem clamp(1rem, 4vw, 2.5rem);
    display: flex; align-items: center; justify-content: center;
    gap: clamp(1rem, 4vw, 3rem); flex-wrap: wrap;
  }
  .trust-item {
    display: flex; align-items: center; gap: 7px;
    font-size: .82rem; color: var(--muted); font-weight: 500; white-space: nowrap;
  }
  .trust-item svg { color: var(--red); flex-shrink: 0; }

  /* Insurance banner */
  .feature-banner {
    background: linear-gradient(135deg, var(--red) 0%, #c0391a 100%);
    color: #fff; border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: center;
    margin-bottom: 2.5rem;
    box-shadow: 0 8px 30px rgba(214,76,43,.28);
    position: relative; overflow: hidden;
    transition: transform var(--ease), box-shadow var(--ease);
  }
  .feature-banner::before {
    content: ''; position: absolute; right: -40px; top: -40px;
    width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,.07);
  }
  .feature-banner:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(214,76,43,.36); }
  .fb-tag {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(255,255,255,.2);
    font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
    padding: 3px 10px; border-radius: 999px; margin-bottom: .75rem;
  }
  .feature-banner h2 {
    font-size: clamp(1.1rem, 2.5vw, 1.45rem); font-weight: 700;
    letter-spacing: -.02em; margin-bottom: .5rem;
  }
  .feature-banner p { font-size: .9rem; opacity: .88; max-width: 420px; margin-bottom: 1.1rem; line-height: 1.55; }
  .fb-shield { width: 80px; height: 80px; opacity: .2; flex-shrink: 0; position: relative; z-index: 1; }

  /* Featured 3 */
  .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: 2.5rem; }
  .f-card {
    background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: 2.25rem 1.75rem 2rem;
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem;
    box-shadow: var(--sh-sm);
    transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
    position: relative; overflow: hidden;
  }
  .f-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--red); opacity: 0; transition: opacity var(--ease);
  }
  .f-card:hover { transform: translateY(-4px); box-shadow: var(--sh-lg); border-color: rgba(214,76,43,.25); }
  .f-card:hover::before { opacity: 1; }
  .f-icon {
    width: 76px; height: 76px; border-radius: 50%;
    background: var(--red-lt); display: flex; align-items: center; justify-content: center;
    font-size: 2.1rem; flex-shrink: 0; transition: background var(--ease);
  }
  .f-card:hover .f-icon { background: rgba(214,76,43,.15); }
  .f-content { flex: 1; min-width: 0; }
  .f-title { display: block; font-size: 1.05rem; font-weight: 700; color: var(--text); }
  .f-desc { display: block; font-size: .85rem; color: var(--muted); margin-top: 5px; line-height: 1.45; }
  .f-arrow { color: var(--red); flex-shrink: 0; opacity: 0; transition: opacity var(--ease); font-size: .85rem; font-weight: 600; }
  .f-card:hover .f-arrow { opacity: 1; }

  /* Needs grid — 2 columns, bigger cards */
  .needs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .n-card {
    background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: 1.5rem 1.5rem; display: flex; align-items: center; gap: 1.1rem;
    box-shadow: var(--sh-sm);
    transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease), background var(--ease);
  }
  .n-card:hover { transform: translateY(-2px); box-shadow: var(--sh-md); border-color: rgba(214,76,43,.25); background: var(--red-lt); }
  .n-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: var(--red-lt); display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; flex-shrink: 0; transition: background var(--ease);
  }
  .n-card:hover .n-icon { background: rgba(214,76,43,.18); }
  .n-card span { font-size: 1rem; font-weight: 600; }

  .cta-row { text-align: center; margin: 2rem 0; }

  .newsletter {
    background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: clamp(1.75rem, 4vw, 2.5rem); text-align: center; margin-top: 1rem; box-shadow: var(--sh-sm);
  }
  .nl-icon { font-size: 2rem; margin-bottom: .75rem; }
  .newsletter h2 { font-size: 1.2rem; font-weight: 700; letter-spacing: -.02em; margin-bottom: .4rem; }
  .newsletter p { font-size: .9rem; color: var(--muted); margin-bottom: 1.25rem; }
  .nl-form { display: flex; gap: .6rem; max-width: 440px; margin: 0 auto; flex-wrap: wrap; justify-content: center; }
  .nl-form input {
    flex: 1; min-width: 200px; padding: 11px 18px; border-radius: 999px;
    border: 1.5px solid var(--border); font-size: .9rem;
    background: var(--bg); color: var(--text); outline: none;
    transition: border-color var(--ease), box-shadow var(--ease);
  }
  .nl-form input:focus { border-color: var(--red); box-shadow: 0 0 0 3px rgba(214,76,43,.1); }
  .nl-form input::placeholder { color: var(--muted); }
  .nl-note { display: block; font-size: .78rem; color: var(--muted); margin-top: .75rem; }

  @media (max-width: 700px) {
    .featured-grid { grid-template-columns: 1fr; }
    .needs-grid { grid-template-columns: 1fr; }
    .feature-banner { grid-template-columns: 1fr; }
    .fb-shield { display: none; }
  }
  @media (max-width: 400px) {
    .needs-grid { grid-template-columns: 1fr; }
  }
</style>
