---
import Layout from '../layouts/Layout.astro';
import Advisor from '../components/Advisor.astro';
import LinkedInTrust from '../components/LinkedInTrust.astro';
import Testimonials from '../components/Testimonials.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';

const faqs = [
  { q: 'Who can choose private health insurance in Germany?', a: 'Employees who earn above the income threshold, self-employed people and freelancers, and civil servants can usually choose private cover. Students can choose a student tariff. The Eligibility Check shows which route applies to you.' },
  { q: 'How are private health insurance premiums calculated?', a: 'Your premium is set by your age at entry, your health and the level of cover you choose. It does not rise with your salary, which is the main difference from public health insurance.' },
  { q: 'Do I need to speak German?', a: 'No. Our independent consultants work in English, and several insurers offer full English-language service.' },
  { q: 'How long does it take to get covered?', a: 'Policies typically start within 2 to 4 weeks of the application. Your consultant handles the paperwork with you.' },
  { q: 'What does the advice cost?', a: 'Nothing. The consultation and the comparison are free of charge and without obligation.' },
  { q: 'Can I go back to public health insurance later?', a: 'Only in limited cases, for example if your income drops below the threshold for an extended period. Think carefully before you switch and talk to an independent consultant first.' },
];

const audiences = [
  { title: 'Expats', text: 'New to Germany or settled here: what private cover means for you.', href: '/health-insurance-expats-germany' },
  { title: 'Employees', text: 'Whether your salary lets you leave the public system.', href: '/guide/who-qualifies' },
  { title: 'Freelancers and self-employed', text: 'You can choose freely from day one. Know the income risk.', href: '/guide/for-freelancers' },
  { title: 'Students', text: 'Student options for your time at a German university.', href: '/guide/for-students' },
  { title: 'Families', text: 'What changes for partners and children, and what it costs.', href: '/guide/costs-and-contributions' },
];

const steps = [
  { t: 'Tell us your situation', d: 'Five short questions: job status, income band, household, time in Germany, contact details.' },
  { t: 'A broker calls you back', d: 'In English, at the time you chose. You get an honest view on whether private cover fits you at all.' },
  { t: 'Compare and decide', d: 'The broker compares insurers for your profile. You decide, with no obligation.' },
  { t: 'Cover starts', d: 'Policies typically start within 2 to 4 weeks of the application. Your broker handles the paperwork.' },
];

const rows = [
  { income: '€30,000', pub: '€408', priv: '€310' },
  { income: '€50,000', pub: '€679', priv: '€310' },
  { income: '€70,000', pub: '€899', priv: '€310' },
  { income: '€90,000', pub: '€899 (capped)', priv: '€310' },
];
---
<Layout
  title="Private Health Insurance in Germany 2026 — Costs & Expat Guide"
  description="Private health insurance in Germany for expats, in plain English: compare public vs private health insurance, check eligibility, estimate costs, and get matched with a broker."
>
  <main id="main">
    <!-- 1. Hero -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Independent advice, in English</p>
          <h1>Private health insurance in Germany, arranged for expats</h1>
          <p class="lead">A licensed broker compares insurers for your situation and explains every step in plain English. You pay nothing for the advice.</p>
          <div class="hero-actions">
            <a class="btn" href="/free-consultation">Get a free consultation</a>
            <a class="hero-phone" href="tel:+4971196981720">or call +49 711 96 98 17 20</a>
          </div>
          <ul class="hero-facts">
            <li>Licensed broker, &sect; 34d GewO</li>
            <li>Reply within one working day</li>
            <li>No obligation</li>
          </ul>
        </div>
        <div class="hero-side">
          <div class="photo" role="img" aria-label="Advisor photo placeholder"><span class="mono">[Advisor photo]</span></div>
          <Advisor layout="stack" size="sm" schema />
        </div>
      </div>
    </section>

    <!-- 2. Who it's for -->
    <section class="sec" id="who">
      <div class="container two">
        <div>
          <p class="eyebrow">Who it&rsquo;s for</p>
          <h2>The rules depend on your job. Start with yours.</h2>
        </div>
        <ul class="rowlist">
          {audiences.map((a) => (
            <li><a href={a.href}><span class="rl-t">{a.title}</span><span class="rl-d">{a.text}</span><span class="rl-a" aria-hidden="true">&rarr;</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. Costs -->
    <section class="sec sec-band" id="costs">
      <div class="container two">
        <div>
          <p class="eyebrow">What it costs</p>
          <h2>Private premiums follow age and health, not salary.</h2>
          <p class="body">The table compares a self-employed 32-year-old on a mid-range private plan with public contributions at different incomes. Employees above the 2026 threshold of &euro;77,400 per year can choose private cover.</p>
          <p class="links"><a href="/guide/costs-and-contributions">Costs and contributions explained</a><a href="/calculator">Cost calculator</a><a href="/eligibility-check">Eligibility Check</a></p>
        </div>
        <div class="tbl-wrap">
          <table>
            <caption>Approximate monthly cost, healthy single adult, freelancer paying the full premium</caption>
            <thead><tr><th scope="col">Annual income</th><th scope="col">Public</th><th scope="col">Private (age 32, mid plan)</th></tr></thead>
            <tbody>{rows.map((r) => <tr><th scope="row">{r.income}</th><td>{r.pub}</td><td>{r.priv}</td></tr>)}</tbody>
          </table>
          <p class="src">Source: <a href="/guide/for-freelancers">our freelancer guide</a>, 2026 figures. Your own premium depends on age, health and plan.</p>
        </div>
      </div>
    </section>

    <!-- 4. How it works -->
    <section class="sec" id="how">
      <div class="container">
        <p class="eyebrow">How it works</p>
        <h2>From first question to signed policy</h2>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="n mono">0{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ol>
        <p class="steps-cta"><a class="btn" href="/free-consultation">Start with step 1</a></p>
      </div>
    </section>

    <!-- 5. Trust -->
    <Testimonials />
    <section class="sec sec-band" id="trust">
      <div class="container two">
        <div>
          <p class="eyebrow">Who you talk to</p>
          <h2>Two named, licensed advisors.</h2>
          <p class="body">Read what clients wrote about them, and how we are paid.</p>
        </div>
        <div class="trust-col">
          <Advisor layout="stack" size="lg" />
          <LinkedInTrust />
          <div class="paid">
            <p class="paid-h">How we get paid</p>
            <p>[Placeholder: short statement on commission, independence and why the advice is free for you.] <a href="/how-we-get-paid">Read more</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FAQ + CTA -->
    <section class="sec" id="faq">
      <div class="container two">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2>Frequently asked questions</h2>
        </div>
        <FaqAccordion items={faqs} />
      </div>
    </section>

    <ConsultationCTA />
  </main>
</Layout>

<style>
  .hero { padding: 24px 0 56px; border-bottom: 1px solid var(--border); background: var(--band); }
  .hero-grid { display: grid; gap: 36px; }
  .hero h1 { font-size: 36px; line-height: 40px; margin-bottom: 18px; }
  .hero .lead { max-width: 560px; }
  .hero-actions { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  .hero-phone { font-weight: 600; color: var(--navy); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center; }
  .hero-facts { list-style: none; margin-top: 26px; display: flex; flex-wrap: wrap; gap: 6px 22px; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: .02em; color: var(--text-muted); }
  .hero-facts li::before { content: ""; display: inline-block; width: 7px; height: 7px; background: var(--brand-coral); margin-right: 8px; }
  .hero-side { display: grid; gap: 16px; }
  .photo { aspect-ratio: 16 / 10; background: #DCE1EC; border-radius: var(--radius-card); display: grid; place-items: center; color: #7F8AA8; }
  .sec { padding: var(--section-y-mobile) 0; }
  .sec-band { background: var(--band); border-block: 1px solid var(--border); }
  .sec h2 { max-width: 620px; }
  .two { display: grid; gap: 32px; }
  .rowlist { list-style: none; border-top: 2px solid var(--navy); }
  .rowlist a { display: grid; grid-template-columns: 1fr auto; gap: 2px 16px; padding: 18px 0; border-bottom: 1px solid var(--border); color: var(--navy); align-items: center; }
  .rl-t { font-family: var(--font-display); font-stretch: 108%; font-weight: 700; font-size: 19px; }
  .rl-d { grid-column: 1; font-size: 15px; color: var(--text-muted); }
  .rl-a { grid-row: 1 / span 2; grid-column: 2; font-size: 22px; color: var(--accent); transition: transform var(--dur-spring) var(--spring); }
  .rowlist a:hover .rl-t { color: var(--accent); }
  .rowlist a:hover .rl-a { transform: translateX(4px); }
  .body { margin-top: 16px; max-width: 520px; font-size: 17px; line-height: 27px; }
  .links { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .links a, .src a, .paid a { font-weight: 600; color: var(--accent-dk); text-decoration: underline; text-underline-offset: 3px; }
  .tbl-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border-strong); font-size: 15px; }
  caption { text-align: left; padding: 0 0 10px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .02em; color: var(--text-muted); caption-side: top; }
  th, td { padding: 13px 14px; text-align: left; border-bottom: 1px solid var(--border); }
  thead th { font-family: var(--font-mono); font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: .04em; color: var(--text-muted); border-bottom: 2px solid var(--navy); }
  tbody th { font-weight: 700; color: var(--navy); }
  .src { margin-top: 12px; font-size: 13.5px; color: var(--text-muted); }
  .steps { list-style: none; margin-top: 36px; display: grid; gap: 28px; }
  .steps li { border-top: 2px solid var(--navy); padding-top: 14px; }
  .n { color: var(--accent); font-size: 13px; }
  .steps h3 { margin: 8px 0 6px; font-size: 21px; line-height: 26px; }
  .steps p { font-size: 15.5px; line-height: 24px; }
  .steps-cta { margin-top: 36px; }
  .trust-col { display: grid; gap: 28px; }
  .paid { border-top: 1px solid var(--border); padding-top: 20px; }
  .paid-h { font-family: var(--font-display); font-stretch: 108%; font-weight: 700; font-size: 19px; color: var(--navy); margin-bottom: 8px; }
  @media (min-width: 960px) {
    .hero { padding: 40px 0 88px; }
    .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 72px; align-items: center; }
    .hero h1 { font-size: 52px; line-height: 56px; }
    .photo { aspect-ratio: 4 / 3; }
    .sec { padding: var(--section-y) 0; }
    .two { grid-template-columns: 5fr 7fr; gap: 80px; align-items: start; }
    .steps { grid-template-columns: repeat(4, 1fr); gap: 28px; }
  }
</style>
