---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConsultationForm from '../components/forms/ConsultationForm.astro';
import Advisor from '../components/Advisor.astro';
import LinkedInTrust from '../components/LinkedInTrust.astro';
---
<Layout
  title="Free Private Health Insurance Consultation in Germany"
  description="Five short questions, then a licensed broker calls you back in English. Free, independent advice on private health insurance in Germany for expats."
>
  <main id="main">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Free consultation' }]} />
    <div class="fc container">
      <div class="fc-head">
        <p class="eyebrow">Free consultation</p>
        <h1>Tell us your situation. We call you back.</h1>
        <p class="lead">Five short questions, about two minutes. A licensed broker compares private health insurance for you, in English. You pay nothing for the advice.</p>
      </div>
      <div class="fc-form"><ConsultationForm /></div>
      <div class="fc-extra">
        <ul class="fc-points">
          <li>Independent: we compare several insurers, not one.</li>
          <li>Free for you: insurers pay the broker, see <a href="/how-we-get-paid">how we get paid</a>.</li>
          <li>No obligation: you decide what happens after the call.</li>
        </ul>
        <div class="fc-adv"><Advisor layout="stack" size="sm" label="Your advisors" schema /></div>
        <LinkedInTrust />
      </div>
    </div>
  </main>
</Layout>
<style>
  .fc { display: grid; gap: 32px; padding-top: 8px; padding-bottom: var(--section-y-mobile); }
  .fc-head h1 { margin-bottom: 16px; }
  .fc-points { list-style: none; margin: 24px 0 28px; display: grid; gap: 10px; }
  .fc-points li { position: relative; padding-left: 20px; color: var(--navy); }
  .fc-points li::before { content: ""; position: absolute; left: 0; top: 9px; width: 8px; height: 8px; background: var(--brand-coral); }
  .fc-points a { text-decoration: underline; text-underline-offset: 3px; color: var(--accent-dk); }
  .fc-adv { margin-bottom: 28px; }
  @media (min-width: 960px) {
    .fc { grid-template-columns: 5fr 6fr; grid-template-areas: "head form" "extra form"; grid-template-rows: auto 1fr; column-gap: 72px; row-gap: 0; align-items: start; padding-bottom: var(--section-y); }
    .fc-head { grid-area: head; } .fc-extra { grid-area: extra; } .fc-points { margin-top: 24px; }
    .fc-form { grid-area: form; position: sticky; top: calc(var(--nav-h) + 24px); }
  }
</style>
