---
// German technical term in small caps + English explanation ("German term, translated").
// Inline:  <GermanTerm term="Beitragsbemessungsgrenze">contribution ceiling</GermanTerm>
// Block:   <GermanTerm block term="Versicherungspflichtgrenze">income threshold above which you may leave public insurance</GermanTerm>
interface Props { term: string; block?: boolean }
const { term, block = false } = Astro.props;
---
{block ? (
  <p class="gt gt--block">
    <span class="gt-term" lang="de">{term}</span>
    <span class="gt-tag">German term, translated</span>
    <span class="gt-en"><slot /></span>
  </p>
) : (
  <span class="gt"><span class="gt-term" lang="de">{term}</span> <span class="gt-en">(<slot />)</span></span>
)}
<style>
  .gt-term { font-variant-caps: all-small-caps; font-weight: 700; letter-spacing: .06em; color: var(--navy); font-size: 1.05em; }
  .gt-en { color: var(--text); }
  .gt--block { display: grid; gap: 4px; margin: 20px 0; padding: 14px 18px; background: var(--band); border: 1px solid var(--border); border-radius: var(--radius-card); }
  .gt--block .gt-term { font-family: var(--font-display); font-stretch: 112%; font-size: 20px; }
  .gt-tag { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); }
</style>
