---
// Header: one bar. Nav + "Who it's for" dropdown, phone, primary CTA -> /free-consultation. Own mobile menu.
import LogoMark from './ui/LogoMark.astro';
const PHONE = '+49 711 96 98 17 20';
const PHONE_HREF = 'tel:+4971196981720';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const audiences = [
  { label: 'Expats', href: '/health-insurance-expats-germany' },
  { label: 'Employees', href: '/guide/who-qualifies' },
  { label: 'Freelancers', href: '/guide/for-freelancers' },
  { label: 'Students', href: '/guide/for-students' },
  { label: 'Families', href: '/guide/costs-and-contributions' },
];
const links = [
  { label: 'Private Health Insurance', href: '/private-health-insurance' },
  { label: 'Who it’s for', href: '', children: audiences },
  { label: 'Costs', href: '/guide/costs-and-contributions' },
  { label: 'Compare', href: '/compare' },
  { label: 'Insurers', href: '/top-insurers' },
  { label: 'Guides', href: '/guide' },
];
const active = (h: string) => h && (current === h || (h !== '/' && current.startsWith(h + '/')));
---
<header class="site-header" id="siteNav">
  <div class="bar container">
    <a href="/" class="logo" aria-label="Private Health Insurance Germany, home">
      <LogoMark size={34} /><span class="logo-text">Private Health<br />Insurance Germany</span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <ul>
        {links.map((l) => (
          <li class:list={['nav-item', { 'has-dd': l.children }]}>
            {l.children ? (
              <>
                <button type="button" class="nav-link dd-btn" aria-expanded="false" aria-haspopup="true">{l.label}
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg>
                </button>
                <ul class="dd">
                  {l.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                </ul>
              </>
            ) : (
              <a href={l.href} class="nav-link" aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href={PHONE_HREF} class="phone">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>
        <span>{PHONE}</span>
      </a>
      <a href="/free-consultation" class="btn btn-sm cta">Free consultation</a>
    </div>

    <div class="mob-bar">
      <a href={PHONE_HREF} class="mob-icon" aria-label={`Call ${PHONE}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>
      </a>
      <button class="mob-icon" id="mobBtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobPanel">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="m-open" d="M3 7h18M3 12h18M3 17h18"/><path class="m-close" d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    </div>
  </div>

  <div class="mob-panel" id="mobPanel" hidden>
    <ul class="mob-list">
      {links.map((l) => (
        <li>
          {l.children ? (
            <details>
              <summary>{l.label}</summary>
              <ul>{l.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
            </details>
          ) : <a href={l.href}>{l.label}</a>}
        </li>
      ))}
    </ul>
    <a href="/free-consultation" class="btn mob-cta">Free consultation</a>
    <a href={PHONE_HREF} class="mob-phone">{PHONE}</a>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--surface); border-bottom: 1px solid var(--border); }
  .bar { max-width: 1320px; display: flex; align-items: center; gap: 16px; height: var(--nav-main-h); }
  .logo { display: flex; align-items: center; gap: 10px; flex: none; color: var(--navy); }
  .logo-text { font-family: var(--font-display); font-stretch: 112%; font-weight: 800; font-size: 13px; line-height: 15px; letter-spacing: -.005em; text-transform: uppercase; }
  .nav { flex: 1; min-width: 0; }
  .nav > ul { list-style: none; display: flex; align-items: center; gap: 2px; }
  .nav-item { position: relative; }
  .nav-link { display: inline-flex; align-items: center; gap: 5px; min-height: 44px; padding: 0 9px; font: 500 var(--fs-nav)/1 var(--font-sans); color: var(--navy); background: none; border: 0; cursor: pointer; white-space: nowrap; border-radius: var(--radius-btn); }
  .nav-link:hover, .nav-link[aria-current="page"] { color: var(--accent); }
  .dd-btn svg { transition: transform var(--dur-fade) ease; }
  .dd { list-style: none; position: absolute; top: calc(100% - 4px); left: 0; min-width: 210px; padding: 8px; background: var(--surface); border: 1px solid var(--border-strong); border-radius: var(--radius-card); box-shadow: var(--sh-3); display: none; }
  .has-dd:hover .dd, .has-dd:focus-within .dd, .has-dd.open .dd { display: block; }
  .has-dd:hover .dd-btn svg, .has-dd.open .dd-btn svg { transform: rotate(180deg); }
  .dd a { display: block; padding: 10px 12px; font-size: 15px; color: var(--navy); border-radius: 2px; }
  .dd a:hover { background: var(--band); color: var(--accent); }
  .actions { display: flex; align-items: center; gap: 18px; flex: none; margin-left: auto; }
  .phone { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15px; color: var(--navy); white-space: nowrap; min-height: 44px; }
  .phone:hover { color: var(--accent); }
  .cta { white-space: nowrap; }
  .mob-bar { display: none; margin-left: auto; align-items: center; gap: 4px; }
  .mob-icon { display: grid; place-items: center; width: 44px; height: 44px; color: var(--navy); background: none; border: 0; cursor: pointer; }
  .m-close { display: none; }
  #mobBtn[aria-expanded="true"] .m-open { display: none; }
  #mobBtn[aria-expanded="true"] .m-close { display: block; }
  .mob-panel { border-top: 1px solid var(--border); background: var(--surface); padding: 8px var(--gutter) 24px; max-height: calc(100dvh - var(--nav-main-h)); overflow-y: auto; }
  .mob-list { list-style: none; }
  .mob-list > li { border-bottom: 1px solid var(--border); }
  .mob-list a, .mob-list summary { display: block; padding: 16px 0; font-size: 17px; font-weight: 600; color: var(--navy); cursor: pointer; list-style: none; }
  .mob-list summary::-webkit-details-marker { display: none; }
  .mob-list details ul { list-style: none; padding: 0 0 8px 14px; }
  .mob-list details a { font-weight: 500; font-size: 16px; padding: 11px 0; color: var(--text); }
  .mob-cta { width: 100%; margin-top: 20px; }
  .mob-phone { display: block; text-align: center; padding: 14px; font-weight: 600; color: var(--navy); }
  @media (max-width: 1119px) {
    .nav, .actions { display: none; }
    .mob-bar { display: flex; }
  }
  @media (max-width: 1359px) and (min-width: 1120px) { .phone span { display: none; } .actions { gap: 8px; } }
</style>

<script>
  const btn = document.getElementById('mobBtn');
  const panel = document.getElementById('mobPanel');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (panel) panel.hidden = open;
  });
  document.querySelectorAll<HTMLElement>('.dd-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const li = b.closest('.has-dd')!;
      const o = li.classList.toggle('open');
      b.setAttribute('aria-expanded', String(o));
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('.has-dd.open').forEach((li) => li.classList.remove('open'));
  });
</script>
