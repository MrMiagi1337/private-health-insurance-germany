---
const navLinks = [
  { label: "Guides",           href: "/guides" },
  { label: "Health Insurance", href: "/guides/health-insurance" },
  { label: "Tools",            href: "/tools" },
  { label: "Newsletter",       href: "/newsletter" },
];
---

<header class="nav" role="banner">
  <a href="/" class="nav-logo" aria-label="Living in Germany home">
    <!-- Compass icon -->
    <svg class="logo-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="20" cy="20" r="18" stroke="white" stroke-width="2.5"/>
      <circle cx="20" cy="20" r="3" fill="white"/>
      <!-- N needle -->
      <polygon points="20,6 22.5,20 17.5,20" fill="white" fill-opacity=".95"/>
      <!-- S needle -->
      <polygon points="20,34 22.5,20 17.5,20" fill="white" fill-opacity=".4"/>
      <!-- Cardinal labels -->
      <text x="18.5" y="4.5" font-size="4" fill="white" font-family="Inter,sans-serif" font-weight="700">N</text>
    </svg>
    <span>Living in Germany</span>
  </a>

  <nav aria-label="Main navigation">
    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="nav-right">
    <div class="srch" role="search">
      <svg class="srch-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="search" placeholder="Search guides…" aria-label="Search guides" />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 200;
    background: var(--red);
    height: 58px;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
    display: flex; align-items: center; justify-content: space-between;
    box-shadow: 0 2px 14px rgba(214,76,43,.3);
  }

  .nav-logo {
    display: flex; align-items: center; gap: 10px;
    color: #fff; font-weight: 800; font-size: 1.08rem;
    letter-spacing: -.02em; white-space: nowrap;
  }
  .logo-icon { width: 30px; height: 30px; flex-shrink: 0; }

  .nav-links {
    display: flex; gap: clamp(.5rem, 2vw, 1.5rem);
    list-style: none;
  }
  .nav-links a {
    color: rgba(255,255,255,.85); font-size: .9rem; font-weight: 500;
    padding: 4px 0; border-bottom: 2px solid transparent;
    transition: color var(--ease), border-color var(--ease);
  }
  .nav-links a:hover { color: #fff; border-color: rgba(255,255,255,.55); }

  .nav-right { display: flex; align-items: center; }

  .srch { position: relative; }
  .srch input {
    background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.25);
    border-radius: 999px; padding: 6px 14px 6px 34px;
    color: #fff; font-size: .86rem; width: 170px; outline: none;
    transition: background var(--ease), width var(--ease), border-color var(--ease);
  }
  .srch input::placeholder { color: rgba(255,255,255,.6); }
  .srch input:focus {
    background: rgba(255,255,255,.22); border-color: rgba(255,255,255,.5); width: 210px;
  }
  .srch-ic {
    position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
    color: rgba(255,255,255,.7); pointer-events: none;
  }

  @media (max-width: 700px) {
    .nav-links { display: none; }
    .srch input { width: 120px; }
    .srch input:focus { width: 155px; }
  }
</style>
