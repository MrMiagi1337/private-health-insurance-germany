---
const navLinks = [
  { label: "PKV Guide",   href: "/guide" },
  { label: "Compare",     href: "/compare" },
  { label: "Insurers",    href: "/top-insurers" },
  { label: "Calculator",  href: "/calculator" },
  { label: "Blog",        href: "/blog" },
];
---

<header class="nav" role="banner">
  <a href="/" class="nav-logo" aria-label="Private Health Insurance Germany home">
    <div class="logo-mark" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <span class="logo-text"><strong>PKV</strong> Germany</span>
  </a>

  <nav aria-label="Main navigation">
    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="nav-right">
    <a href="/contact" class="nav-cta">Get free advice →</a>
    <button class="mob-btn" id="mobBtn" aria-label="Open menu" aria-expanded="false">
      <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="mob-drawer" id="mobDrawer">
    <ul>
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <a href="/contact" class="mob-cta">Get free advice →</a>
  </div>
</header>

<script>
  const btn    = document.getElementById('mobBtn')!;
  const drawer = document.getElementById('mobDrawer')!;
  btn.addEventListener('click', () => {
    const open = drawer.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.classList.toggle('active', open);
  });
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    drawer.classList.remove('open');
    btn.classList.remove('active');
    btn.setAttribute('aria-expanded', 'false');
  }));
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 200;
    background: #fff;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    min-height: 62px;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 9px;
    color: var(--text); text-decoration: none;
    white-space: nowrap; height: 62px;
  }
  .logo-mark {
    width: 30px; height: 30px; flex-shrink: 0;
    background: var(--red); border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
  }
  .logo-text { font-size: .95rem; font-weight: 400; color: var(--muted); letter-spacing: -.01em; }
  .logo-text strong { font-weight: 800; color: var(--text); }
  nav { height: 62px; display: flex; align-items: center; }
  .nav-links { display: flex; gap: clamp(.5rem, 2vw, 1.5rem); list-style: none; }
  .nav-links a {
    color: rgba(28,28,30,.6); font-size: .88rem; font-weight: 500;
    padding: 4px 0; border-bottom: 2px solid transparent;
    transition: color var(--ease), border-color var(--ease);
  }
  .nav-links a:hover { color: var(--red); border-color: var(--red); }
  .nav-right { display: flex; align-items: center; gap: .75rem; height: 62px; }
  .nav-cta {
    background: var(--red); color: #fff; font-size: .82rem; font-weight: 700;
    padding: .5rem 1.2rem; border-radius: 8px;
    text-decoration: none; white-space: nowrap; letter-spacing: -.01em;
    transition: background var(--ease);
  }
  .nav-cta:hover { background: var(--red-dk); }
  .mob-btn {
    display: none; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    background: none; border: 1px solid var(--border);
    border-radius: 8px; cursor: pointer; color: var(--text);
    transition: background var(--ease);
  }
  .mob-btn:hover { background: var(--bg); }
  .icon-close { display: none; }
  .mob-btn.active .icon-menu { display: none; }
  .mob-btn.active .icon-close { display: block; }
  .mob-drawer { display: none; width: 100%; border-top: 1px solid var(--border); padding: 1rem 0 1.25rem; }
  .mob-drawer.open { display: block; }
  .mob-drawer ul { list-style: none; padding: 0; margin: 0 0 .75rem; }
  .mob-drawer ul a {
    display: block; padding: .7rem 0;
    font-size: 1rem; font-weight: 500; color: var(--text);
    border-bottom: 1px solid var(--border); text-decoration: none;
    transition: color var(--ease);
  }
  .mob-drawer ul a:hover { color: var(--red); }
  .mob-cta {
    display: block; text-align: center;
    background: var(--red); color: #fff;
    font-size: .9rem; font-weight: 700;
    padding: .75rem 1rem; border-radius: 8px;
    text-decoration: none; margin-top: .5rem;
  }
  @media (max-width: 700px) {
    .nav-links { display: none; } nav { display: none; }
    .mob-btn { display: flex; }
  }
</style>
