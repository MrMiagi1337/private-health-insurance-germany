---
const navLinks = [
  { label: "Guides",           href: "/guides" },
  { label: "Health Insurance", href: "/guides/health-insurance" },
  { label: "Tools",            href: "/tools" },
  { label: "Newsletter",       href: "/newsletter" },
];
---

<header class="nav" role="banner">
  <a href="/" class="nav-logo" aria-label="Living in Germany home">
    <!-- Compass icon -->
    <svg class="logo-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="20" cy="20" r="18" stroke="#1c1c1e" stroke-width="2.5"/>
      <circle cx="20" cy="20" r="3" fill="#e8632a"/>
      <polygon points="20,6 22.5,20 17.5,20" fill="#e8632a"/>
      <polygon points="20,34 22.5,20 17.5,20" fill="#1c1c1e" fill-opacity=".25"/>
    </svg>
    <span>Living in Germany</span>
  </a>

  <nav aria-label="Main navigation">
    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="nav-right">
    <a href="https://myhealthcarebroker.com" target="_blank" rel="noopener" class="nav-cta">Free PKV consultation</a>
    <div class="srch" role="search">
      <svg class="srch-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="search" placeholder="Search guides…" aria-label="Search guides" />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 200;
    background: #fff;
    height: 62px;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    display: flex; align-items: center; gap: 10px;
    color: var(--text); font-weight: 800; font-size: 1.05rem;
    letter-spacing: -.02em; white-space: nowrap;
  }
  .logo-icon { width: 28px; height: 28px; flex-shrink: 0; }
  /* Make compass icon dark for white navbar */
  .logo-icon circle, .logo-icon polygon, .logo-icon text { stroke: var(--text) !important; fill: var(--text) !important; }
  .logo-icon polygon:last-child { fill: rgba(28,28,30,.35) !important; }

  .nav-links {
    display: flex; gap: clamp(.5rem, 2vw, 1.5rem);
    list-style: none;
  }
  .nav-links a {
    color: rgba(28,28,30,.6); font-size: .88rem; font-weight: 500;
    padding: 4px 0; border-bottom: 2px solid transparent;
    transition: color var(--ease), border-color var(--ease);
  }
  .nav-links a:hover { color: var(--red); border-color: var(--red); }

  .nav-right { display: flex; align-items: center; gap: .75rem; }

  .nav-cta {
    background: var(--red); color: #fff; font-size: .82rem; font-weight: 700;
    padding: .45rem 1.1rem; border-radius: 999px; border: none; cursor: pointer;
    transition: background var(--ease);
    white-space: nowrap;
  }
  .nav-cta:hover { background: var(--red-dk); }

  .srch { position: relative; }
  .srch input {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 999px; padding: 6px 14px 6px 34px;
    color: var(--text); font-size: .86rem; width: 160px; outline: none;
    transition: background var(--ease), width var(--ease), border-color var(--ease);
  }
  .srch input::placeholder { color: var(--muted); }
  .srch input:focus { border-color: var(--red); width: 200px; }
  .srch-ic {
    position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
    color: var(--muted); pointer-events: none;
  }

  @media (max-width: 700px) {
    .nav-links { display: none; }
    .srch input { width: 110px; }
    .srch input:focus { width: 145px; }
  }
</style>
