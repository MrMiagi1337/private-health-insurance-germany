---
// Two-tier sticky header (REDESIGN-V2-SPEC section 2): utility bar + main nav, dropdown panels, mobile panel.
const PHONE = '+49 711 96 98 17 20';
const PHONE_HREF = 'tel:+4971196981720';

// 24 viewBox, 1.75 stroke line icons (own drawings), keyed by name.
const icons: Record<string, string> = {
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2.2 2.2L15.5 10"/>',
  list: '<rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  calc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 7.5h7M9 12h.01M12 12h.01M15 12h.01M9 16h.01M12 16h.01M15 16h.01"/>',
  swap: '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
  scale: '<path d="M12 4v16M6 20h12M5 7h14"/><path d="M5 7l-2.5 6a2.5 2.5 0 005 0L5 7zM19 7l-2.5 6a2.5 2.5 0 005 0L19 7z"/>',
  coins: '<circle cx="9" cy="9" r="5.5"/><path d="M14.5 9.5A5.5 5.5 0 1115 20a5.5 5.5 0 01-3-1"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/>',
  clipboard: '<rect x="5" y="4.5" width="14" height="16" rx="2"/><path d="M9 4.5h6V7H9zM9 12h6M9 16h4"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9S14.6 18.4 12 21c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z"/>',
  cap: '<path d="M2.5 9L12 4.5 21.5 9 12 13.5 2.5 9z"/><path d="M6.5 11.5V16c0 1.4 2.5 2.5 5.5 2.5s5.5-1.1 5.5-2.5v-4.5"/>',
  briefcase: '<rect x="3" y="7.5" width="18" height="12" rx="2"/><path d="M9 7.5V5.5A1.5 1.5 0 0110.5 4h3A1.5 1.5 0 0115 5.5v2M3 13h18"/>',
  bank: '<path d="M3 9.5L12 4l9 5.5M5 10v7M9.5 10v7M14.5 10v7M19 10v7M3 20h18"/>',
  book: '<path d="M4 5.5C6.5 4.5 9.5 4.5 12 6c2.5-1.5 5.5-1.5 8-.5V19c-2.5-1-5.5-1-8 .5-2.5-1.5-5.5-1.5-8-.5V5.5z"/><path d="M12 6v13.5"/>',
  users: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19c.6-3.3 3-5 6-5s5.4 1.7 6 5"/><path d="M16 5.6a3 3 0 010 5.8M18 14.4c1.7.6 2.7 2.1 3 4.6"/>',
  home: '<path d="M4 11l8-6.5 8 6.5M6 9.5V19h12V9.5"/>',
};

// Hub link is the nav-link itself; groups give the dropdown its columns.
const menu = [
  { label: 'Private Health Insurance', href: '/private-health-insurance', groups: [
    { head: 'Basics', items: [
      { label: 'What is private health insurance?', href: '/private-health-insurance', icon: 'shield' },
      { label: 'Who can go private', href: '/guide/who-qualifies', icon: 'check' },
      { label: 'Costs and contributions', href: '/guide/costs-and-contributions', icon: 'coins' },
    ]},
    { head: 'Next steps', items: [
      { label: 'Top insurers', href: '/top-insurers', icon: 'list' },
      { label: 'How to switch', href: '/guide/how-to-switch', icon: 'swap' },
      { label: 'Document checklist', href: '/checklist', icon: 'clipboard' },
    ]},
  ]},
  { label: 'Compare', href: '/compare', groups: [
    { head: 'Compare & tools', items: [
      { label: 'Public vs private', href: '/compare', icon: 'scale' },
      { label: 'Cost calculator', href: '/calculator', icon: 'calc' },
      { label: 'Eligibility Check', href: '/eligibility-check', icon: 'check' },
      { label: 'Top insurers', href: '/top-insurers', icon: 'list' },
    ]},
  ]},
  { label: 'For Expats', href: '/health-insurance-expats-germany', groups: [
    { head: 'Who you are', items: [
      { label: 'Health insurance for expats', href: '/health-insurance-expats-germany', icon: 'globe' },
      { label: 'For foreigners', href: '/guide/for-foreigners', icon: 'users' },
      { label: 'For students', href: '/guide/for-students', icon: 'cap' },
      { label: 'For freelancers', href: '/guide/for-freelancers', icon: 'briefcase' },
    ]},
    { head: 'Settling in', items: [
      { label: 'Opening a bank account', href: '/guide/bank-account', icon: 'bank' },
    ]},
  ]},
  { label: 'Guides', href: '/guide', groups: [
    { head: 'Popular guides', items: [
      { label: 'All guides', href: '/guide', icon: 'book' },
      { label: 'Who qualifies', href: '/guide/who-qualifies', icon: 'check' },
      { label: 'Costs and contributions', href: '/guide/costs-and-contributions', icon: 'coins' },
      { label: 'How to switch', href: '/guide/how-to-switch', icon: 'swap' },
    ]},
  ]},
];

const utility = [
  { label: 'About us', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="site-header" id="siteNav">
  <div class="util" aria-label="Secondary navigation">
    <div class="util-row container">
      {utility.map(u => <a href={u.href} class="util-link">{u.label}</a>)}
      <a href="https://www.myhealthcarebroker.com" class="util-link" rel="noopener" lang="de" hreflang="de">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.globe}></svg>
        Deutsch
      </a>
    </div>
  </div>

  <div class="main" id="mainBar">
    <div class="main-row container">
      <a href="/" class="logo" aria-label="Private Health Insurance Germany, home">
        <span>Private Health</span><span>Insurance Germany</span>
      </a>

      <nav class="nav-main" aria-label="Main navigation">
        <ul class="nav-list">
          {menu.map(m => (
            <li class="nav-item">
              <a href={m.href} class="nav-link">{m.label}</a>
              <div class="dd" role="group" aria-label={m.label}>
                {m.groups.map(g => (
                  <div class="dd-col">
                    <p class="dd-head">{g.head}</p>
                    <ul>
                      {g.items.map(it => (
                        <li>
                          <a href={it.href} class="dd-row">
                            <span class="dd-ico" aria-hidden="true">
                              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]}></svg>
                            </span>
                            <span>{it.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </nav>

      <div class="actions">
        <a href={PHONE_HREF} class="phone">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>
          <span>{PHONE}</span>
        </a>
        <a href="/contact" class="cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c.7-4.2 4-6.5 8-6.5s7.3 2.3 8 6.5"/></svg>
          Free consultation
        </a>
      </div>

      <div class="mob-actions-bar">
        <a href={PHONE_HREF} class="mob-icon" aria-label={`Call ${PHONE}`}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg>
        </a>
        <button class="mob-icon" id="mobBtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobPanel">
          <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="mob-panel" id="mobPanel" hidden>
    <div class="container">
      <ul class="mob-groups">
        {menu.map(m => (
          <li>
            <details>
              <summary>{m.label}</summary>
              <ul>
                <li><a href={m.href}>Overview</a></li>
                {m.groups.flatMap(g => g.items).filter((it, i, a) => it.href !== m.href && a.findIndex(x => x.href === it.href) === i).map(it => <li><a href={it.href}>{it.label}</a></li>)}
              </ul>
            </details>
          </li>
        ))}
      </ul>
      <div class="mob-cta">
        <a href="/contact" class="btn">Free consultation</a>
        <a href={PHONE_HREF} class="btn btn-secondary btn-noarrow">{PHONE}</a>
      </div>
      <ul class="mob-util">
        {utility.map(u => <li><a href={u.href}>{u.label}</a></li>)}
        <li><a href="https://www.myhealthcarebroker.com" rel="noopener" lang="de" hreflang="de">Deutsch</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const root = document.getElementById('siteNav')!;
  const mainBar = document.getElementById('mainBar')!;
  const mobBtn = document.getElementById('mobBtn')!;
  const panel = document.getElementById('mobPanel')!;

  function setMobile(open: boolean) {
    panel.hidden = !open;
    mobBtn.setAttribute('aria-expanded', String(open));
    mobBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobBtn.classList.toggle('active', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }
  mobBtn.addEventListener('click', () => setMobile(panel.hidden));
  window.matchMedia('(min-width: 960px)').addEventListener('change', e => { if (e.matches && !panel.hidden) setMobile(false); });

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (!panel.hidden) { setMobile(false); mobBtn.focus(); return; }
    const active = document.activeElement as HTMLElement | null;
    if (active && root.contains(active) && active.closest('.nav-item')) { active.blur(); root.classList.add('dd-suppress'); }
  });
  root.addEventListener('mouseleave', () => root.classList.remove('dd-suppress'));
  root.addEventListener('focusin', e => { if ((e.target as Element).closest('.nav-item')) root.classList.remove('dd-suppress'); });

  // hairline under the main bar only after scrolling
  const onScroll = () => mainBar.classList.toggle('scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 200; background: var(--surface); }

  /* utility bar */
  .util { height: var(--util-h); background: var(--band); border-bottom: var(--border-w) solid var(--border); }
  .util-row { height: 100%; display: flex; align-items: center; justify-content: flex-end; gap: 0; }
  .util-link {
    display: inline-flex; align-items: center; gap: 8px; padding: 2px 12px; border-radius: var(--radius-btn-sm);
    font-size: var(--fs-util); line-height: 21px; font-weight: var(--fw-nav); color: var(--text);
    transition: background var(--ease);
  }
  .util-link + .util-link { position: relative; margin-left: 12px; }
  .util-link + .util-link::before {
    content: ""; position: absolute; left: -7px; top: 50%; height: 16px; width: 1px; margin-top: -8px; background: var(--border);
  }
  .util-link:hover { background: var(--border); }

  /* main nav */
  .main { height: var(--nav-main-h); background: var(--surface); border-bottom: var(--border-w) solid transparent; transition: border-color var(--ease); }
  .main.scrolled { border-bottom-color: var(--border); }
  .main-row { height: 100%; display: flex; align-items: center; gap: 32px; max-width: var(--container-header); }
  .logo { display: flex; flex-direction: column; max-width: 190px; color: var(--navy); font-size: 20px; line-height: 20px; font-weight: 800; letter-spacing: -.01em; white-space: nowrap; flex: none; }
  .nav-main { flex: 1; align-self: stretch; }
  .nav-list { display: flex; align-items: stretch; gap: 32px; list-style: none; height: 100%; }
  .nav-item { position: relative; display: flex; align-items: center; }
  .nav-link { font-size: var(--fs-nav); font-weight: var(--fw-nav); line-height: 24px; color: var(--text); white-space: nowrap; padding: 8px 0; transition: color var(--ease); }
  .nav-item:hover .nav-link, .nav-item:focus-within .nav-link { color: var(--blue-dk); }

  .dd {
    position: absolute; top: 100%; left: -32px; display: flex; gap: 40px; min-width: 280px; max-width: calc(100vw - 2 * var(--gutter));
    padding: 32px; background: var(--surface); border-radius: var(--radius-tile); box-shadow: var(--sh-2);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity var(--ease), transform var(--ease), visibility var(--ease);
  }
  .nav-item:nth-last-child(-n+2) .dd { left: auto; right: -32px; }
  .nav-item:hover .dd, .nav-item:focus-within .dd { opacity: 1; visibility: visible; transform: none; }
  .dd-suppress .dd { opacity: 0 !important; visibility: hidden !important; }
  .dd-col { min-width: 240px; }
  .dd-col ul { list-style: none; }
  .dd-head { margin: 0 0 12px; font-size: 12px; line-height: 18px; font-weight: 700; color: var(--text-muted); }
  .dd-row { display: flex; align-items: center; gap: 12px; min-height: 44px; font-size: var(--fs-small); line-height: 21px; color: var(--text-muted); transition: color var(--ease); }
  .dd-ico { flex: none; width: 44px; height: 44px; border-radius: 50%; background: var(--blue-tint); color: var(--blue); display: inline-flex; align-items: center; justify-content: center; }
  .dd-row:hover { color: var(--blue-dk); }
  .dd-row + .dd-row { margin-top: 0; }
  .dd-col li + li { margin-top: 4px; }

  .actions { display: flex; align-items: center; gap: 24px; flex: none; }
  .phone { display: inline-flex; align-items: center; gap: 12px; padding: 12px 0; font-size: var(--fs-nav); line-height: 24px; font-weight: 700; color: var(--blue); white-space: nowrap; }
  .phone:hover { color: var(--blue-dk); }
  .cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 196px; height: 36px;
    background: var(--surface); color: var(--blue); border-radius: var(--radius-btn-sm); box-shadow: var(--sh-1);
    font-size: var(--fs-btn-sm); line-height: 21px; font-weight: 700; white-space: nowrap; transition: background var(--ease);
  }
  .cta:hover { background: var(--blue-tint); }

  .mob-actions-bar { display: none; margin-left: auto; align-items: center; margin-right: -10px; }
  .mob-icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; background: none; border: 0; cursor: pointer; color: var(--navy); }
  .icon-close { display: none; }
  .mob-icon.active .icon-menu { display: none; }
  .mob-icon.active .icon-close { display: block; }

  /* mobile panel */
  .mob-panel {
    position: fixed; top: var(--nav-main-h); left: 0; right: 0; bottom: 0; background: var(--surface);
    border-top: var(--border-w) solid var(--border); overflow-y: auto; overscroll-behavior: contain; padding: 8px 0 32px;
  }
  .mob-panel[hidden] { display: none; }
  .mob-panel ul { list-style: none; }
  .mob-panel summary {
    list-style: none; cursor: pointer; min-height: 56px; display: flex; align-items: center; justify-content: space-between;
    font-size: 18px; line-height: 24px; font-weight: 700; color: var(--navy); border-bottom: var(--border-w) solid var(--border);
  }
  .mob-panel summary::-webkit-details-marker { display: none; }
  .mob-panel summary::after { content: ""; width: 10px; height: 10px; border-right: 2px solid var(--text-muted); border-bottom: 2px solid var(--text-muted); transform: rotate(45deg); margin-right: 4px; transition: transform var(--ease); }
  .mob-panel details[open] summary::after { transform: rotate(-135deg); }
  .mob-panel details ul a { display: flex; align-items: center; min-height: 44px; padding-left: 12px; color: var(--text); font-size: var(--fs-body); }
  .mob-cta { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
  .mob-util { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 16px; }
  .mob-util a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--fs-small); color: var(--text-muted); }

  @media (max-width: 1100px) { .phone span { display: none; } .phone { padding: 12px; } .main-row { gap: 24px; } .nav-list { gap: 24px; } }
  @media (max-width: 959px) {
    .util, .nav-main, .actions { display: none; }
    .mob-actions-bar { display: flex; }
    .logo { font-size: 16px; line-height: 17px; }
  }
  @media (min-width: 960px) { .mob-panel { display: none !important; } }
</style>
