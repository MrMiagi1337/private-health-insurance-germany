---
// S7 bento: 3 columns; col1 white + light-blue, col2 navy tall, col3 blue + white.
import KeyFigureCard from './KeyFigureCard.astro';
---
<div class="bento">
  <KeyFigureCard class="b-1" variant="white" icon="check"
    title="Our advice is *free of charge* for you, with no obligation."
    text="Compare cover and costs with a consultant before you commit to anything." />
  <KeyFigureCard class="b-2" variant="light" icon="globe"
    title="Advice in English"
    text="From the first call to the signed policy, in plain language."
    image="/images/photos/row-woman-coworking.jpg" alt="Woman on a call with her consultant" />
  <KeyFigureCard class="b-tall" variant="navy" badge
    title="Compare 40+ insurers with *independent consultants*"
    text="We compare 40+ insurers for your case and recommend the cover that fits your situation." />
  <KeyFigureCard class="b-3" variant="blue"
    title="*Independent* advice for expats"
    text="We explain the **threshold, your options and the costs** before you decide. You get clear numbers, not a sales pitch." />
  <KeyFigureCard class="b-4" variant="white" icon="thumb"
    title="Support after you sign"
    text="Your consultant stays your contact for questions, claims and changes." />
</div>

<style>
  .bento { display: grid; grid-template-columns: 1fr; gap: var(--grid-gap); }
  @media (min-width: 640px) {
    .bento { grid-template-columns: 1fr 1fr; }
    .bento :global(.b-tall) { grid-column: 1 / -1; }
  }
  @media (min-width: 960px) {
    .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: 380px 380px; }
    .bento :global(.b-1) { grid-column: 1; grid-row: 1; }
    .bento :global(.b-2) { grid-column: 1; grid-row: 2; }
    .bento :global(.b-tall) { grid-column: 2; grid-row: 1 / 3; }
    .bento :global(.b-3) { grid-column: 3; grid-row: 1; }
    .bento :global(.b-4) { grid-column: 3; grid-row: 2; }
  }
</style>
