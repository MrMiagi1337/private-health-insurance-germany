---
interface Props { size?: 48 | 64; class?: string }
const { size = 64, class: cls = '' } = Astro.props;
---
<span class={`icon-tile icon-tile-${size} ${cls}`} aria-hidden="true"><slot /></span>

<style>
  .icon-tile {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    background: var(--blue-tint); color: var(--blue); border-radius: var(--radius-tile);
  }
  .icon-tile-64 { width: 64px; height: 64px; }
  .icon-tile-48 { width: 48px; height: 48px; }
  .icon-tile :global(svg) { width: 32px; height: 32px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .icon-tile-48 :global(svg) { width: 24px; height: 24px; }
</style>
