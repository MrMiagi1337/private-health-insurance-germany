---
interface Tab { label: string; href?: string; }
interface Cta { label: string; href: string; }
interface Props {
  title: string;
  lead?: string;
  tabs?: Tab[];
  bullets?: string[];
  cta?: Cta;
  ghost?: Cta;
  image?: string;
  imageWebp?: string;
  alt: string;
  cardTitle?: string;
  cardText?: string;
  cardCta?: Cta;
  trust?: string[];
}
const {
  title, lead, tabs = [], bullets = [], cta, ghost,
  image = '/images/placeholder-3x4.svg', imageWebp, alt,
  cardTitle = 'Not sure which insurance fits you?',
  cardText = 'Take the Eligibility Check to see which option applies to your situation.',
  cardCta = { label: 'Find my insurance', href: '/eligibility-check' },
  trust = [],
} = Astro.props;
const webp = imageWebp ?? (/\.jpe?g$/.test(image) ? image.replace(/\.jpe?g$/, '.webp') : undefined);
const isPh = image.includes('placeholder');
---
<section class="hs">
  <div class="container hs-grid">
    <div class="hs-media">
      <div class:list={['hs-imgwrap', { ph: isPh }]}>
        <picture>{webp && <source srcset={webp} type="image/webp" />}<img class="hs-img" src={image} alt={isPh ? '' : alt} width="600" height="800" fetchpriority="high" loading="eager" decoding="async" /></picture>
      </div>
      <aside class="hs-card" aria-label={cardTitle}>
        <p class="hs-card-title">{cardTitle}</p>
        <p class="hs-card-text">{cardText}</p>
        <a class="btn-secondary" href={cardCta.href}>{cardCta.label}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </aside>
    </div>
    <div class="hs-copy">
      <h1>{title}</h1>
      {lead && <p class="hs-lead">{lead}</p>}
      {tabs.length > 0 && (
        <ul class="hs-tabs" role="list">
          {tabs.map((t, i) => (
            <li>{t.href
              ? <a class={`hs-tab${i === 0 ? ' is-active' : ''}`} href={t.href} aria-current={i === 0 ? 'true' : undefined}>{t.label}</a>
              : <span class={`hs-tab${i === 0 ? ' is-active' : ''}`}>{t.label}</span>}</li>
          ))}
        </ul>
      )}
      {bullets.length > 0 && (
        <ul class="hs-bullets" role="list">
          {bullets.map((b) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )}
      {(cta || ghost) && (
        <div class="hs-actions">
          {cta && <a class="btn-primary" href={cta.href}>{cta.label}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>}
          {ghost && <a class="btn-ghost hs-ghost" href={ghost.href}>{ghost.label}</a>}
        </div>
      )}
      {trust.length > 0 && (
        <ul class="hs-trust" role="list">
          {trust.map((t) => (
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg><span>{t}</span></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .hs { margin: 0 0 var(--section-y-mobile); }
  .hs-grid { display: grid; grid-template-columns: 1fr; gap: 24px; padding-top: 24px; }
  .hs-media { order: -1; display: flex; flex-direction: column; }
  .hs-imgwrap { border-radius: var(--radius-card); background: var(--blue-tint); overflow: hidden; }
  .hs-imgwrap picture { display: block; }
  .hs-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; max-height: 200px; object-fit: cover; }
  .hs-card {
    background: var(--surface); border: var(--border-w) solid var(--border);
    border-radius: var(--radius-card-sm); padding: 20px; margin-top: 16px;
    display: none; flex-direction: column; align-items: flex-start; gap: 8px;
  }
  .hs-card-title { font-size: 20px; line-height: 28px; font-weight: var(--fw-h3); color: var(--navy); }
  .hs-card-text { color: var(--text); margin-bottom: 8px; }
  h1 { font-size: var(--fs-h1-mobile); line-height: var(--lh-h1-mobile); }
  .hs-lead { margin-top: 16px; font-size: var(--fs-lead-sm); line-height: var(--lh-lead-sm); color: var(--text-muted); }
  .hs-tabs { list-style: none; display: flex; flex-wrap: nowrap; gap: 4px; margin-top: 24px; overflow-x: auto; scrollbar-width: none; }
  .hs-tabs::-webkit-scrollbar { display: none; }
  .hs-tabs li { flex: none; }
  .hs-tab {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px;
    border-radius: 999px; font-size: var(--fs-nav); font-weight: var(--fw-btn);
    color: var(--blue-dk); background: var(--blue-tint); transition: background var(--ease), color var(--ease);
  }
  a.hs-tab:hover { background: var(--border); }
  .hs-tab.is-active { background: var(--blue); color: var(--surface); }
  a.hs-tab.is-active:hover { background: var(--blue-dk); }
  .hs-bullets { list-style: none; display: grid; gap: 8px; margin-top: 20px; }
  .hs-bullets li { display: flex; align-items: flex-start; gap: 10px; color: var(--text); }
  .hs-bullets svg { flex: none; margin-top: 3px; color: var(--blue); }
  .hs-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 28px; padding-top: 24px; border-top: var(--border-w) solid var(--border); }
  .hs-trust li { display: flex; align-items: center; gap: 8px; font-size: var(--fs-nav); line-height: 20px; font-weight: var(--fw-nav); color: var(--navy); }
  .hs-trust svg { flex: none; color: var(--blue); }
  .hs-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 28px; }
  .hs a:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

  @media (min-width: 960px) {
    .hs { margin: 0 0 0; padding-bottom: 8px; }
    .hs-grid { grid-template-columns: 55fr 45fr; gap: 64px; padding-top: 64px; align-items: center; }
    .hs-media { order: 2; position: relative; width: 100%; max-width: 360px; justify-self: end; }
    .hs-img { max-height: none; aspect-ratio: 1 / 1; }
    .hs-card { display: flex; margin: -32px 16px 0; position: relative; padding: 20px 24px 24px; }
    .hs-card-title { font-size: var(--fs-h3); line-height: var(--lh-h3); }
    h1 { font-size: 40px; line-height: 50px; }
    .hs-lead { font-size: 20px; line-height: 30px; margin-top: 20px; max-width: 560px; }
    .hs-tabs { margin-top: 28px; }
    .hs-bullets { margin-top: 24px; gap: 6px; }
    .hs-actions { margin-top: 28px; }
    .hs-trust { margin-top: 32px; }
  }
</style>
