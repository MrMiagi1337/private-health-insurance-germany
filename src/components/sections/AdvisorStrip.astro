---
interface Props { name?: string; phone: string; phoneHref?: string; buttonText?: string; href?: string; }
const { name = 'Michael', phone, phoneHref = phone.replace(/[^+\d]/g, ''), buttonText = 'Request a call back', href = '/contact' } = Astro.props;
---
<div class="strip">
  <div class="who">
    <span class="avatar" aria-hidden="true"><img src="/images/photos/pastel-advisor-avatar.jpg" alt="" width="400" height="400" loading="lazy" decoding="async" /></span>
    <div>
      <p class="q">Questions about private health insurance?</p>
      <p class="sub">{name} and the team of independent consultants are happy to help.</p>
    </div>
  </div>
  <div class="act">
    <a class="tel" href={`tel:${phoneHref}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
      {phone}
    </a>
    <a class="btn-secondary" href={href}>{buttonText}</a>
  </div>
</div>
<style>
  .strip { border: var(--border-w) solid var(--border); border-radius: var(--radius-card); background: var(--surface); padding: 24px; display: flex; flex-direction: column; gap: 20px; }
  .who { display: flex; gap: 16px; align-items: center; }
  .avatar { position: relative; flex: none; width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: var(--blue-tint); }
  .avatar img { position: absolute; width: 352px; max-width: none; height: auto; left: -74px; top: -49px; }
  .q { font-weight: var(--fw-h3); color: var(--navy); font-size: 18px; line-height: 26px; }
  .sub { color: var(--text-muted); font-size: var(--fs-nav); line-height: var(--lh-small); }
  .act { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .tel { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: var(--fs-h4); line-height: var(--lh-h4); font-weight: var(--fw-btn); color: var(--blue); }
  .tel:hover { color: var(--blue-dk); }
  .tel:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  @media (min-width: 960px) {
    .strip { flex-direction: row; align-items: center; justify-content: space-between; padding: 28px 36px; }
    .act { flex-direction: row; align-items: center; gap: 28px; }
  }
</style>
