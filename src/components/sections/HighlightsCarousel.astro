---
// S9: pastel slides with a peeking next slide, arrows, dots, scroll-snap. No autoplay.
interface Item { title: string; text: string }
interface Slide { bg: 'pink' | 'mint' | 'blue'; title: string; items: Item[]; cta: string; href: string; image: string; alt: string; pos?: string }
interface Props { eyebrow?: string; title?: string; slides?: Slide[]; id?: string }
const {
  id = 'highlights',
  eyebrow = 'How it works',
  title = 'From first question to signed policy, one consultant at your side.',
  slides = [
    { bg: 'pink', title: 'Find out if you qualify.', cta: 'Start the Eligibility Check', href: '/eligibility-check',
      image: '/images/photos/gpt-woman-desk.jpg', alt: 'Woman checking her eligibility on a laptop',
      items: [
        { title: 'Income and job status', text: 'Employees, self-employed people, civil servants and students each have different routes.' },
        { title: 'The 2026 threshold', text: 'EUR 77,400 per year for employees. See where you stand.' },
        { title: 'A clear answer', text: 'You see which route applies before you talk to anyone.' },
      ] },
    { bg: 'mint', title: 'Compare 40+ insurers.', cta: 'See how we compare', href: '/compare',
      image: '/images/photos/nb-couple-sofa.jpg', alt: 'Couple comparing options at home',
      items: [
        { title: 'Independent consultants', text: 'No insurer ties, so the comparison starts from your needs.' },
        { title: 'Cover and costs side by side', text: 'Benefits, premiums and conditions explained in plain English.' },
        { title: 'Free of charge', text: 'The consultation and the comparison cost you nothing.' },
      ] },
    { bg: 'blue', title: 'We stay with you after you sign.', cta: 'Free consultation', href: '/contact',
      image: '/images/photos/row-man-homeoffice.jpg', alt: 'Man on the phone with his consultant in his home office', pos: '30% center',
      items: [
        { title: 'Help with the application', text: 'Your consultant handles the paperwork with you.' },
        { title: 'English-speaking support', text: 'Questions about claims or changes get an answer in English.' },
        { title: 'One contact person', text: 'The same consultant who advised you stays your contact.' },
      ] },
  ],
} = Astro.props;
---
<div class="hc" data-hc id={id}>
  <div class="hc-head">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
    <div class="hc-arrows">
      <button type="button" class="hc-arrow" data-prev aria-label="Previous slide"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <button type="button" class="hc-arrow" data-next aria-label="Next slide"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
    </div>
  </div>
  <div class="hc-viewport">
    <div class="hc-track" data-track tabindex="0" role="group" aria-roledescription="carousel" aria-label="Highlights">
      {slides.map((s, i) => (
        <article class={`hc-slide hc-slide--${s.bg}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
          <div class="hc-media"><img src={s.image} alt={s.alt} width="280" height="480" loading="lazy" style={s.pos ? `object-position:${s.pos}` : undefined} /></div>
          <div class="hc-copy">
            <h3>{s.title}</h3>
            <ul>
              {s.items.map((it) => (
                <li>
                  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" /><path d="M5.8 10.3l2.8 2.8 5.6-5.8" fill="none" stroke="var(--surface)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <div><strong>{it.title}</strong><span>{it.text}</span></div>
                </li>
              ))}
            </ul>
            <a class="btn" href={s.href}>{s.cta}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
  <div class="hc-dots" role="group" aria-label="Choose slide">
    {slides.map((_, i) => <button type="button" class="hc-dot" data-dot={i} aria-label={`Slide ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}
  </div>
</div>

<style>
  .hc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 32px; }
  .hc-head h2 { margin-top: 12px; max-width: 780px; }
  .hc-arrows { display: flex; gap: 16px; flex: none; margin-top: 12px; }
  .hc-arrow { width: 32px; height: 32px; border-radius: 50%; border: var(--border-w) solid var(--border); background: var(--surface); color: var(--navy); display: grid; place-items: center; cursor: pointer; box-shadow: 0 1px 2px color-mix(in srgb, var(--navy) 12%, transparent); transition: background var(--ease), transform var(--dur-spring) var(--spring); }
  .hc-arrow:hover { background: var(--blue-tint); }
  .hc-arrow:active:not([disabled]) { transform: scale(.92); transition-duration: var(--dur-press); }
  .hc-arrow[disabled] { color: var(--text-faint); cursor: default; background: var(--surface); }
  .hc-viewport { position: relative; }
  .hc-track { display: flex; gap: 32px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; -webkit-mask-image: linear-gradient(to right, #000 0, #000 84%, transparent 100%); mask-image: linear-gradient(to right, #000 0, #000 84%, transparent 100%); }
  .hc-track::-webkit-scrollbar { display: none; }
  .hc-track.is-end { -webkit-mask-image: none; mask-image: none; }
  .hc-slide { flex: none; width: 932px; max-width: calc(100% - 48px); height: 528px; scroll-snap-align: start; display: grid; grid-template-columns: 280px 1fr; gap: 32px; padding: 32px 40px 0 32px; border-radius: var(--radius-card); background: var(--pastel-blue); overflow: hidden; }
  .hc-slide--pink { background: var(--pastel-pink); }
  .hc-slide--mint { background: var(--pastel-mint); }
  .hc-media { align-self: stretch; border-radius: var(--radius-card) var(--radius-card) 0 0; overflow: hidden; box-shadow: var(--sh-2); }
  .hc-media img { width: 100%; height: 100%; object-fit: cover; }
  .hc-copy { align-self: center; padding-bottom: 32px; }
  .hc-copy h3 { margin: 0 0 24px; font-size: 32px; line-height: 40px; font-weight: var(--fw-heading); }
  .hc-copy ul { list-style: none; display: grid; gap: 20px; margin: 0 0 28px; }
  .hc-copy li { display: grid; grid-template-columns: 20px 1fr; gap: 12px; color: var(--blue); }
  .hc-copy li svg { margin-top: 2px; }
  .hc-copy li div { display: grid; color: var(--navy); }
  .hc-copy li strong { font-weight: 700; color: var(--navy); line-height: 24px; }
  .hc-copy li span { color: var(--text); line-height: 24px; }
  .hc-dots { display: flex; gap: 12px; margin-top: 24px; }
  .hc-dot { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 5px; background: var(--text-faint); cursor: pointer; transition: width var(--ease), background var(--ease); position: relative; }
  .hc-dot::before { content: ""; position: absolute; inset: -17px -6px; }
  .hc-dot[aria-current="true"] { width: 40px; background: var(--navy); }
  @media (max-width: 899px) {
    .hc-head { flex-direction: column; gap: 16px; margin-bottom: 24px; }
    .hc-arrows { display: none; }
    .hc-track { gap: 16px; -webkit-mask-image: none; mask-image: none; }
    .hc-slide { grid-template-columns: 1fr; grid-template-rows: 180px auto; gap: 24px; height: auto; max-width: calc(100% - 32px); padding: 24px 20px; }
    .hc-media { border-radius: var(--radius-card); }
    .hc-copy { padding-bottom: 0; }
    .hc-copy h3 { font-size: 26px; line-height: 32px; margin-bottom: 20px; }
    .hc-copy .btn { width: 100%; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hc]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const current = () => {
      let best = 0, d = Infinity;
      slides.forEach((s, i) => { const x = Math.abs(s.offsetLeft - track.offsetLeft - track.scrollLeft); if (x < d) { d = x; best = i; } });
      return best;
    };
    const go = (i: number) => track.scrollTo({ left: slides[Math.max(0, Math.min(slides.length - 1, i))].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    const sync = () => {
      const i = current();
      dots.forEach((d, j) => d.setAttribute('aria-current', String(i === j)));
      prev.disabled = i === 0; next.disabled = i === slides.length - 1;
      track.classList.toggle('is-end', i === slides.length - 1);
    };
    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
    });
    sync();
  });
</script>
