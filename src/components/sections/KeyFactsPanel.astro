---
// S6: light-blue panel, navy price pills, rotated navy round badge, photo.
interface Row { pill: string; text: string }
interface Props {
  eyebrow?: string; title?: string; text?: string; rows?: Row[];
  cta?: string; href?: string; image?: string; alt?: string;
  badgeTop?: string; badgeMain?: string; badgeBottom?: string;
}
const {
  eyebrow = 'Know your numbers',
  title = 'The 2026 income threshold, in three numbers.',
  text = 'Employees can choose private health insurance once their income passes the annual threshold. Here is where it stands.',
  rows = [
    { pill: 'EUR 77,400 / year', text: 'Annual income threshold 2026' },
    { pill: 'EUR 6,450 / month', text: 'The same threshold per month' },
    { pill: 'EUR 84,150', text: 'Expected for 2027, not final yet' },
  ],
  cta = 'Check my eligibility', href = '/eligibility-check',
  image = '/images/photos/gpt-woman-desk.jpg', alt = 'Woman checking the income threshold on her laptop',
  badgeTop = 'Threshold', badgeMain = 'EUR 77,400', badgeBottom = 'in 2026',
} = Astro.props;
---
<div class="kfp">
  <div class="kfp-copy">
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
    <p class="kfp-text">{text}</p>
    <ul class="kfp-rows">
      {rows.map((r) => <li><span class="pill-price">{r.pill}</span><strong>{r.text}</strong></li>)}
    </ul>
    <a class="btn" href={href}>{cta}</a>
  </div>
  <div class="kfp-media">
    <img src={image} alt={alt} width="480" height="484" loading="lazy" />
  </div>
  <div class="kfp-badge" aria-hidden="true"><span>{badgeTop}</span><b>{badgeMain}</b><span>{badgeBottom}</span></div>
</div>

<style>
  .kfp { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 40px; background: var(--blue-pill); border-radius: var(--radius-card); padding: 40px 0 40px 40px; overflow: hidden; }
  .kfp-copy { align-self: center; max-width: 560px; }
  .kfp h2 { margin: 16px 0; }
  .kfp-text { margin: 0 0 20px; color: var(--navy); }
  .kfp-rows { list-style: none; display: grid; gap: 8px; margin: 0 0 32px; }
  .kfp-rows li { display: flex; align-items: center; gap: 8px; color: var(--navy); line-height: 24px; }
  .kfp-rows .pill-price { flex: none; text-align: center; }
  .kfp-media { position: relative; margin: -40px 0; background: var(--blue-light); }
  .kfp-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .kfp-badge { position: absolute; z-index: 2; top: 24px; right: 40px; width: 150px; height: 150px; border-radius: 50%; background: var(--navy); color: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transform: rotate(-10deg); line-height: 1.1; box-shadow: var(--sh-1); }
  .kfp-badge span { font-size: 18px; font-weight: 500; }
  .kfp-badge b { font-size: 24px; font-weight: 800; padding: 2px 0; }
  @media (max-width: 899px) {
    .kfp { grid-template-columns: 1fr; gap: 0; padding: 24px 20px 0; }
    .kfp-copy { padding-bottom: 24px; }
    .kfp-rows li { flex-wrap: wrap; row-gap: 4px; }
    .kfp-media { margin: 0 -20px; height: 200px; }
    .kfp-badge { top: auto; bottom: 16px; right: 16px; width: 112px; height: 112px; }
    .kfp-badge span { font-size: 13px; }
    .kfp-badge b { font-size: 16px; }
  }
</style>
