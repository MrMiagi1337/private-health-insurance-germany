---
interface Props { badge?: string; title: string; text?: string; href?: string; linkLabel?: string; }
const { badge = 'Update', title, text, href, linkLabel = 'Read more' } = Astro.props;
const id = 'an-' + Math.random().toString(36).slice(2, 8);
---
<div class="an" data-alert>
  <button class="an-head" type="button" aria-expanded="false" aria-controls={id}>
    <span class="an-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg></span>
    <span class="an-badge">{badge}</span>
    <span class="an-title">{title}</span>
    <svg class="an-chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </button>
  <div class="an-body" id={id} hidden>
    {text && <p>{text} {href && <a href={href}>{linkLabel}</a>}</p>}
  </div>
</div>

<style>
  /* Own look: white note with a blue edge and an info mark. Not the reference's pink banner. */
  .an { background: var(--surface); border: var(--border-w) solid var(--border); border-left: 4px solid var(--blue); border-radius: var(--radius-banner); color: var(--navy); }
  .an-head {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; width: 100%; min-height: 48px; padding: 10px 12px 10px 14px;
    background: none; border: 0; cursor: pointer; text-align: left; color: inherit; font: inherit;
  }
  .an-icon { flex: none; display: inline-flex; width: 24px; height: 24px; align-items: center; justify-content: center; border-radius: 50%; background: var(--blue-pill); color: var(--blue-dk); }
  .an-badge {
    flex: none; padding: 3px 8px; border-radius: 999px; background: var(--blue-pill); color: var(--blue-dk);
    font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 0.01em;
  }
  .an-title { flex: 1 1 180px; min-width: 0; font-size: var(--fs-body); line-height: 20px; font-weight: 700; color: var(--navy); }
  .an-chev { flex: none; margin-left: auto; color: var(--text-muted); transition: transform var(--ease); }
  @media (max-width: 639px) { .an-head { position: relative; padding-right: 44px; } .an-chev { position: absolute; right: 12px; top: 14px; } }
  @media (min-width: 640px) { .an-head { flex-wrap: nowrap; } }
  .an-chev { transition: transform var(--dur-spring) var(--spring); }
  .an-head[aria-expanded="true"] .an-chev { transform: rotate(180deg); }
  .an-head:active .an-chev { transform: scale(.9); transition-duration: var(--dur-press); }
  .an-head[aria-expanded="true"]:active .an-chev { transform: rotate(180deg) scale(.9); }
  .an-head:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; border-radius: var(--radius-banner); }
  /* body unfolds from the header (height auto via interpolate-size; opacity fade everywhere) */
  .an-body {
    height: 0; opacity: 0; overflow: clip;
    transition: height var(--dur-spring) var(--spring), opacity var(--dur-fade) ease, display var(--dur-spring) allow-discrete;
  }
  .an-body:not([hidden]) { height: auto; opacity: 1; }
  @starting-style { .an-body:not([hidden]) { height: 0; opacity: 0; } }
  .an-body p { padding: 0 14px 14px 48px; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--text); }
  .an-body a { color: var(--blue-dk); font-weight: 700; text-decoration: underline; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-alert]').forEach((el) => {
    const btn = el.querySelector('button')!, body = el.querySelector<HTMLElement>('.an-body')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      body.hidden = open;
    });
  });
</script>
