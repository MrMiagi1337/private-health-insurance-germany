---
interface FaqItem { question: string; answer: string; }
interface Props {
  headline?: string;
  kicker?: string;
  items?: FaqItem[];
}
const {
  headline = 'Frequently asked questions',
  kicker = 'FAQ',
  items = [],
} = Astro.props;
---

<section class="faq-section">
  <div class="container-wide">
    {kicker && <div class="section-kicker">{kicker}</div>}
    <h2 class="section-title">{headline}</h2>
    <div class="faq-list">
      {items.map(item => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section { background: var(--cream); padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .faq-list { display: flex; flex-direction: column; gap: .75rem; max-width: 760px; }
  .faq-item {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; overflow: hidden;
  }
  .faq-item summary {
    padding: 1.15rem 1.5rem; font-size: .92rem; font-weight: 600;
    color: var(--text); cursor: pointer; list-style: none;
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-sans);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.3rem; color: var(--muted-lt); flex-shrink: 0; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p {
    padding: 0 1.5rem 1.25rem; font-size: .87rem;
    color: var(--muted); line-height: 1.7; margin: 0;
    font-family: var(--font-sans);
  }
</style>
