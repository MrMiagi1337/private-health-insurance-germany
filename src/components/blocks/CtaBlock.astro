---
interface Props {
  headline?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
}
const {
  headline = 'Find out how much you could save',
  body = 'A licensed §34d broker reviews your situation, compares all major private health insurers, and gives you a clear recommendation. Free of charge, in English, no obligation.',
  ctaLabel = 'Get free broker advice →',
  ctaHref = '/contact',
  ctaSecondaryLabel = 'Check eligibility first',
  ctaSecondaryHref = '/eligibility-check',
} = Astro.props;
---

<section class="cta-section">
  <div class="container-wide cta-inner">
    <h2>{headline}</h2>
    {body && <p>{body}</p>}
    <div class="cta-actions">
      <a href={ctaHref} class="btn-black">{ctaLabel}</a>
      {ctaSecondaryLabel && (
        <a href={ctaSecondaryHref} class="btn-ghost">{ctaSecondaryLabel}</a>
      )}
    </div>
    <div class="cta-meta">§34d licensed &nbsp;·&nbsp; GDPR compliant &nbsp;·&nbsp; Free &nbsp;·&nbsp; English service</div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--ink);
    padding: clamp(4rem, 7vw, 6rem) 0;
  }
  .cta-inner { text-align: center; }
  h2 {
    font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 700;
    color: var(--surface); margin-bottom: 1.25rem;
  }
  p {
    font-size: clamp(.9rem, 1.3vw, 1rem); color: rgba(255,255,255,.55);
    max-width: 520px; margin: 0 auto 2.25rem; line-height: 1.75;
    font-family: var(--font-sans);
  }
  .cta-actions { display: flex; gap: .85rem; justify-content: center; flex-wrap: wrap; }
  .btn-black {
    display: inline-flex; align-items: center;
    background: var(--cream); color: var(--ink);
    font-size: .95rem; font-weight: 700; padding: .9rem 1.75rem;
    border-radius: 10px; transition: opacity .18s;
    font-family: var(--font-sans);
  }
  .btn-black:hover { opacity: .9; }
  .btn-ghost {
    display: inline-flex; align-items: center;
    background: rgba(255,255,255,.08); color: rgba(255,255,255,.8);
    font-size: .95rem; font-weight: 600; padding: .9rem 1.75rem;
    border-radius: 10px; border: 1.5px solid rgba(255,255,255,.15);
    transition: background .18s; font-family: var(--font-sans);
  }
  .btn-ghost:hover { background: rgba(255,255,255,.14); }
  .cta-meta {
    margin-top: 1.75rem; font-size: .72rem;
    color: rgba(255,255,255,.25); letter-spacing: .04em;
    font-family: var(--font-sans);
  }
</style>
