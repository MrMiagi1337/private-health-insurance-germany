---
interface Testimonial { quote: string; name: string; role: string; }
interface Props {
  headline?: string;
  kicker?: string;
  testimonials?: Testimonial[];
}
const {
  headline = 'What expats say',
  kicker = 'Reviews',
  testimonials = [],
} = Astro.props;
---

<section class="testi-section">
  <div class="container-wide">
    {kicker && <div class="section-kicker">{kicker}</div>}
    <h2 class="section-title">{headline}</h2>
    <div class="testi-grid">
      {testimonials.map(t => (
        <div class="testi-card">
          <p>"{t.quote}"</p>
          <div class="testi-author">
            <div class="testi-av">{t.name[0]}</div>
            <div>
              <strong>{t.name}</strong>
              <span>{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testi-section { background: var(--surface); padding: clamp(3.5rem, 6vw, 5.5rem) 0; }
  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .testi-card {
    background: var(--cream); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.75rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .testi-card p { font-size: .88rem; color: var(--text); line-height: 1.7; flex: 1; font-family: var(--font-sans); }
  .testi-author { display: flex; align-items: center; gap: .75rem; padding-top: .75rem; border-top: 1px solid var(--border); }
  .testi-av {
    width: 36px; height: 36px; flex-shrink: 0;
    background: var(--ink); color: var(--cream);
    border-radius: 50%; font-size: .85rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-sans);
  }
  .testi-author strong { display: block; font-size: .85rem; font-weight: 700; color: var(--text); font-family: var(--font-sans); }
  .testi-author span { font-size: .75rem; color: var(--muted-lt); font-family: var(--font-sans); }
  @media (max-width: 760px) { .testi-grid { grid-template-columns: 1fr; } }
</style>
