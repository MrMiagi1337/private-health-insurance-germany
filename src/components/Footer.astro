---
import LogoMark from './ui/LogoMark.astro';
const columns = [
  { head: 'Private health insurance', links: [
    { label: 'What is private health insurance?', href: '/private-health-insurance' },
    { label: 'Health insurance for expats', href: '/health-insurance-expats-germany' },
    { label: 'Who qualifies?', href: '/guide/who-qualifies' },
    { label: 'For freelancers', href: '/guide/for-freelancers' },
    { label: 'For students', href: '/guide/for-students' },
    { label: 'For foreigners', href: '/guide/for-foreigners' },
  ]},
  { head: 'Compare and tools', links: [
    { label: 'Public vs private', href: '/compare' },
    { label: 'Cost calculator', href: '/calculator' },
    { label: 'Eligibility Check', href: '/eligibility-check' },
    { label: 'Document checklist', href: '/checklist' },
    { label: 'Top insurers', href: '/top-insurers' },
  ]},
  { head: 'Guides', links: [
    { label: 'All guides', href: '/guide' },
    { label: 'Costs and contributions', href: '/guide/costs-and-contributions' },
    { label: 'How to switch', href: '/guide/how-to-switch' },
    { label: 'Opening a bank account', href: '/guide/bank-account' },
  ]},
  { head: 'About', links: [
    { label: 'Free consultation', href: '/free-consultation' },
    { label: 'About us', href: '/about' },
    { label: 'Contact', href: '/contact' },
    { label: 'How we get paid', href: '/how-we-get-paid' },
    { label: 'Editorial standards', href: '/editorial-standards' },
  ]},
];
---
<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="/" class="foot-logo"><LogoMark size={34} /><span>Private Health<br />Insurance Germany</span></a>
        <p>Plain-English guidance on private health insurance in Germany, for expats.</p>
        <a class="btn foot-cta" href="/free-consultation">Free consultation</a>
      </div>
      <nav class="foot-cols" aria-label="Footer navigation">
        {columns.map((c) => (
          <div class="foot-col">
            <p class="foot-head">{c.head}</p>
            <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="broker">
      <p class="foot-head">Insurance broker</p>
      <p>[Placeholder: legal name, address, register number and supervisory authority of the insurance broker, licence under &sect; 34d GewO. To be completed before launch.] Our advice is free for you; see <a href="/how-we-get-paid">how we get paid</a>.</p>
    </div>
    <div class="foot-bottom">
      <span>&copy; 2026 Private Health Insurance Germany</span>
      <span class="foot-legal"><a href="/imprint">Imprint</a><a href="/privacy">Privacy</a><a href="/editorial-standards">Editorial standards</a></span>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--navy); color: #C9D1EA; padding: 64px 0 28px; }
  .site-footer a { color: #E4E9F7; }
  .site-footer a:hover { color: #fff; text-decoration: underline; }
  .foot-top { display: grid; gap: 40px; }
  .foot-logo { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-display); font-stretch: 112%; font-weight: 800; font-size: 14px; line-height: 16px; text-transform: uppercase; color: #fff !important; --logo-a: #fff; --logo-b: var(--brand-coral); }
  .foot-brand p { margin: 16px 0 20px; max-width: 320px; font-size: 15px; }
  .foot-cta { background: var(--accent); color: #fff !important; }
  .foot-cta:hover { text-decoration: none !important; background: var(--accent-dk); }
  .foot-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 24px; }
  .foot-head { font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #8F9CCB; margin-bottom: 14px; }
  .foot-col ul { list-style: none; display: grid; gap: 10px; font-size: 15px; }
  .broker { margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.16); font-size: 14px; line-height: 22px; max-width: 760px; }
  .broker .foot-head { margin-bottom: 8px; }
  .foot-bottom { margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 13px; color: #8F9CCB; }
  .foot-legal { display: flex; gap: 20px; }
  @media (min-width: 960px) {
    .foot-top { grid-template-columns: 300px 1fr; gap: 64px; }
    .foot-cols { grid-template-columns: repeat(4, 1fr); }
  }
</style>
