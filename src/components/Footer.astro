---
const year = new Date().getFullYear();
---

<footer role="contentinfo">
  <div class="foot-inner">
    <div class="foot-brand">
      <span class="foot-logo">Living in Germany</span>
      <p>Your guide to living, working, and thriving in Germany — in plain English.</p>
    </div>

    <nav class="foot-nav" aria-label="Footer navigation">
      <div class="foot-col">
        <h3>Guides</h3>
        <ul>
          <li><a href="/guides/moving-to-berlin">Move to Berlin</a></li>
          <li><a href="/guides/find-a-job">Find a job</a></li>
          <li><a href="/guides/anmeldung">Anmeldung</a></li>
          <li><a href="/guides/find-an-apartment">Find an apartment</a></li>
          <li><a href="/guides/health-insurance">Health insurance</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Resources</h3>
        <ul>
          <li><a href="/tools">Tools</a></li>
          <li><a href="/newsletter">Newsletter</a></li>
          <li><a href="/guides">All guides</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Company</h3>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/imprint">Imprint</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/agb">AGB</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="foot-bottom">
    <span>© {year} Living in Germany. Made with ♥ for expats everywhere.</span>
    <div class="foot-links">
      <a href="/imprint">Imprint</a>
      <a href="/privacy">Privacy</a>
      <a href="/agb">AGB</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--card);
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .foot-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
  }

  .foot-logo {
    font-size: 1.05rem; font-weight: 800;
    letter-spacing: -.02em; color: var(--text);
  }
  .foot-brand p {
    margin-top: .5rem;
    font-size: .85rem; color: var(--muted); max-width: 220px; line-height: 1.55;
  }

  .foot-nav {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
  }
  .foot-col h3 {
    font-size: .75rem; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--muted); margin-bottom: .75rem;
  }
  .foot-col ul { list-style: none; display: flex; flex-direction: column; gap: .4rem; }
  .foot-col a {
    font-size: .88rem; color: var(--muted);
    transition: color var(--ease);
  }
  .foot-col a:hover { color: var(--red); }

  .foot-bottom {
    border-top: 1px solid var(--border);
    padding: 1rem clamp(1rem, 4vw, 2rem);
    max-width: var(--max-w);
    margin: 0 auto;
    width: 100%;
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .foot-bottom span { font-size: .82rem; color: var(--muted); }
  .foot-links { display: flex; gap: 1.25rem; }
  .foot-links a { font-size: .82rem; color: var(--muted); transition: color var(--ease); }
  .foot-links a:hover { color: var(--red); }

  @media (max-width: 700px) {
    .foot-inner { grid-template-columns: 1fr; gap: 2rem; }
    .foot-nav { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; text-align: center; }
    .foot-links { justify-content: center; }
  }
  @media (max-width: 400px) {
    .foot-nav { grid-template-columns: 1fr; }
  }
</style>
