---
const year = new Date().getFullYear();
---

<footer role="contentinfo">
  <div class="foot-inner">
    <div class="foot-brand">
      <span class="foot-logo">PKV Germany</span>
      <p>Plain-English guide to private health insurance in Germany for expats and foreign nationals.</p>
      <p class="foot-disclaimer">We are not a licensed insurance broker. We connect you with registered Versicherungsmakler under §34d GewO. Free of charge.</p>
    </div>

    <nav class="foot-nav" aria-label="Footer navigation">
      <div class="foot-col">
        <h3>PKV Guide</h3>
        <ul>
          <li><a href="/private-health-insurance">What is PKV?</a></li>
          <li><a href="/guide/who-qualifies">Who qualifies?</a></li>
          <li><a href="/guide/costs-and-contributions">PKV costs</a></li>
          <li><a href="/guide/how-to-switch">How to switch</a></li>
          <li><a href="/guide/for-freelancers">For freelancers</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Tools</h3>
        <ul>
          <li><a href="/compare">GKV vs PKV</a></li>
          <li><a href="/calculator">Cost calculator</a></li>
          <li><a href="/quiz">Eligibility quiz</a></li>
          <li><a href="/checklist">Document checklist</a></li>
          <li><a href="/top-insurers">Top insurers</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h3>Company</h3>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Get free advice</a></li>
          <li><a href="/case-studies">Case studies</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/imprint">Imprint</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="foot-bottom">
    <span>© {year} PKV Germany. Informational guide for expats.</span>
    <div class="foot-links">
      <a href="/imprint">Imprint</a>
      <a href="/privacy">Privacy</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--card); border-top: 1px solid var(--border); margin-top: auto; }
  .foot-inner {
    max-width: var(--max-w); margin: 0 auto;
    padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem);
    display: grid; grid-template-columns: 1fr 2fr; gap: 3rem;
  }
  .foot-logo { font-size: 1.05rem; font-weight: 800; letter-spacing: -.02em; color: var(--text); }
  .foot-brand p { margin-top: .5rem; font-size: .85rem; color: var(--muted); max-width: 220px; line-height: 1.55; }
  .foot-disclaimer { font-size: .75rem !important; color: #aaa !important; margin-top: .75rem !important; }
  .foot-nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .foot-col h3 { font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: .75rem; }
  .foot-col ul { list-style: none; display: flex; flex-direction: column; gap: .4rem; }
  .foot-col a { font-size: .88rem; color: var(--muted); transition: color var(--ease); }
  .foot-col a:hover { color: var(--red); }
  .foot-bottom {
    border-top: 1px solid var(--border);
    padding: 1rem clamp(1rem, 4vw, 2rem);
    max-width: var(--max-w); margin: 0 auto; width: 100%;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  .foot-bottom span { font-size: .82rem; color: var(--muted); }
  .foot-links { display: flex; gap: 1.25rem; }
  .foot-links a { font-size: .82rem; color: var(--muted); transition: color var(--ease); }
  .foot-links a:hover { color: var(--red); }
  @media (max-width: 700px) {
    .foot-inner { grid-template-columns: 1fr; gap: 2rem; }
    .foot-nav { grid-template-columns: 1fr 1fr; }
    .foot-bottom { flex-direction: column; text-align: center; }
    .foot-links { justify-content: center; }
  }
  @media (max-width: 400px) { .foot-nav { grid-template-columns: 1fr; } }
</style>
