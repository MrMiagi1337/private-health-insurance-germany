---
interface Section { id: string; label: string }
interface Props { sections: Section[] }
const { sections } = Astro.props;
---

<div class="ssn" data-ssn>
  <div class="container">
    <nav aria-label="On this page">
      <ul class="ssn-list">
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`} data-ssn-link={s.id} aria-current={i === 0 ? 'true' : undefined} class:list={['ssn-tab', { active: i === 0 }]}>{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<style>
  /* Secondary floating bar: same translucent material as the header, lighter blur because it is smaller. */
  .ssn {
    position: sticky; top: var(--nav-h); z-index: 100;
    height: var(--sticky-nav-h);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(160%); backdrop-filter: blur(16px) saturate(160%);
    border-bottom: var(--border-w) solid color-mix(in srgb, var(--border) 75%, transparent);
    display: flex; align-items: center;
  }
  @supports not (backdrop-filter: blur(1px)) { .ssn { background: var(--surface); } }
  @media (prefers-reduced-transparency: reduce) { .ssn { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; } }
  .ssn .container { height: 100%; position: relative; }
  .ssn .container::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 40px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--surface) 85%, transparent)); pointer-events: none; }
  @media (min-width: 960px) { .ssn .container::after { display: none; } }
  nav { height: 100%; }
  .ssn-list {
    list-style: none; display: flex; align-items: center; gap: 8px; height: 100%; padding-right: 32px;
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .ssn-list::-webkit-scrollbar { display: none; }
  .ssn-tab {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px;
    border-radius: 999px; white-space: nowrap;
    font-size: var(--fs-nav); font-weight: var(--fw-nav); line-height: 21px;
    color: var(--text-muted); transition: background var(--ease), color var(--ease), transform var(--dur-spring) var(--spring);
  }
  .ssn-tab:hover { color: var(--navy); }
  .ssn-tab:active { transform: scale(.97); transition-duration: var(--dur-press); }
  .ssn-tab.active { color: var(--navy); }
  .ssn-list:not(.has-ind) .ssn-tab.active { background: var(--blue-tint); }
  /* the active pill glides to the section you scrolled into (indicator.ts) */
  .ssn-list { --ind-inset: 0px; --ind-radius: 999px; }
  .ssn-list :global(.ind) { background: var(--blue-tint); }
  .ssn-tab:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
</style>

<script>
  import { attachIndicator } from '../lib/indicator';
  document.querySelectorAll<HTMLElement>('[data-ssn]').forEach((root) => {
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-ssn-link]'));
    const list = root.querySelector<HTMLElement>('.ssn-list')!;
    const place = attachIndicator(list, () => list.querySelector<HTMLElement>('.ssn-tab.active'));
    const targets = links
      .map((l) => document.getElementById(l.dataset.ssnLink!))
      .filter((t): t is HTMLElement => !!t);
    if (!targets.length || !('IntersectionObserver' in window)) return;
    const setActive = (id: string) => {
      links.forEach((l) => {
        const on = l.dataset.ssnLink === id;
        l.classList.toggle('active', on);
        if (on) {
          l.setAttribute('aria-current', 'true');
          const left = l.offsetLeft - (list.clientWidth - l.offsetWidth) / 2;
          if (list.scrollWidth > list.clientWidth) list.scrollTo({ left, behavior: 'smooth' });
        } else l.removeAttribute('aria-current');
      });
      place();
    };
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        const first = targets.find((t) => visible.has(t.id));
        if (first) setActive(first.id);
      },
      { rootMargin: '-130px 0px -55% 0px', threshold: 0 }
    );
    targets.forEach((t) => io.observe(t));
  });
</script>
