---
// Kept for the existing guide pages: same props and slots, rendered through ArticleLayout.
import ArticleLayout from './ArticleLayout.astro';
interface Props { title: string; description: string; readTime?: string; updatedDate?: string; showInsuranceCTA?: boolean; category?: string; }
const { title, description, readTime, updatedDate, category = 'Guide' } = Astro.props;
const hasRelated = Astro.slots.has('related');
---
<ArticleLayout title={title} description={description} readTime={readTime} updatedDate={updatedDate} category={category}
  articleSchema={false} breadcrumbSchema={false}>
  <slot />
  <Fragment slot="related">{hasRelated && <slot name="related" />}</Fragment>
</ArticleLayout>
