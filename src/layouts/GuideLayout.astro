---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  emoji?: string;
  readTime?: string;
  updatedDate?: string;
  showInsuranceCTA?: boolean;
  category?: string;
}

const {
  title,
  description,
  emoji = '📖',
  readTime = '5 min read',
  updatedDate = '2025',
  showInsuranceCTA = true,
  category = 'Guide',
} = Astro.props;
---

<Layout title={title} description={description}>
  <main>

    <!-- Breadcrumb -->
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/guides">Guides</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <div class="guide-wrap container">

      <!-- Main article -->
      <article class="guide-article">
        <header class="guide-header">
          <div class="guide-meta-top">
            <span class="guide-tag">{category}</span>
            <span class="guide-meta-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {readTime}
            </span>
            <span class="guide-meta-item">Updated {updatedDate}</span>
          </div>
          <h1>{title}</h1>
          <p class="guide-lead">{description}</p>
        </header>

        <div class="guide-body">
          <slot />
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="guide-sidebar">

        {showInsuranceCTA && (
          <div class="sidebar-cta">
            <div class="cta-accent"></div>
            <div class="cta-inner">
              <p class="cta-eyebrow">Health insurance tip</p>
              <h3>Earning over €77,400/year?</h3>
              <p>You may be eligible for private health insurance in Germany. See how GKV and PKV compare for your situation.</p>
              <a href="/guides/german-health-insurance" class="cta-btn">
                See how much you'd save
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <p class="cta-note">Free guide — no signup needed</p>
            </div>
          </div>
        )}

        <div class="sidebar-toc">
          <p class="sidebar-label">On this page</p>
          <slot name="toc" />
        </div>

        <div class="sidebar-related">
          <p class="sidebar-label">Related guides</p>
          <slot name="related" />
        </div>

      </aside>
    </div>

  </main>
</Layout>

<style>
  /* ── Breadcrumb ── */
  .breadcrumb {
    padding-top: 1.25rem; padding-bottom: 0;
  }
  .breadcrumb ol {
    display: flex; align-items: center; gap: .4rem;
    list-style: none; flex-wrap: wrap;
  }
  .breadcrumb li { font-size: .8rem; color: var(--muted); }
  .breadcrumb a { color: var(--muted); transition: color var(--ease); }
  .breadcrumb a:hover { color: var(--text); }
  .breadcrumb [aria-current="page"] { color: var(--text); font-weight: 500; }

  /* ── Layout ── */
  .guide-wrap {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    align-items: start;
  }

  /* ── Header ── */
  .guide-header { margin-bottom: 2.25rem; }

  .guide-meta-top {
    display: flex; align-items: center; gap: .75rem; flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }
  .guide-tag {
    font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--red); background: var(--red-lt);
    padding: 3px 10px; border-radius: 999px;
  }
  .guide-meta-item {
    display: flex; align-items: center; gap: 4px;
    font-size: .8rem; color: var(--muted); font-weight: 500;
  }

  .guide-header h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.4rem);
    font-weight: 800; letter-spacing: -.03em; line-height: 1.15;
    color: var(--text); margin-bottom: .75rem;
  }
  .guide-lead {
    font-size: 1.05rem; color: var(--muted); line-height: 1.65;
    max-width: 640px;
  }

  /* ── Article body ── */
  .guide-body {
    font-size: 1rem;
    line-height: 1.8;
    color: #3a3a42;
  }

  .guide-body :global(h2) {
    font-size: 1.4rem; font-weight: 800;
    letter-spacing: -.025em; line-height: 1.3;
    color: var(--text);
    margin: 2.5rem 0 .8rem;
  }
  .guide-body :global(h3) {
    font-size: 1.05rem; font-weight: 700;
    color: var(--text); margin: 1.75rem 0 .5rem;
  }
  .guide-body :global(p) {
    margin-bottom: 1.15rem;
  }
  .guide-body :global(ul),
  .guide-body :global(ol) {
    margin: .5rem 0 1.25rem 1.25rem;
  }
  .guide-body :global(li) {
    margin-bottom: .5rem;
    padding-left: .25rem;
  }

  /* Links — subtle, not loud */
  .guide-body :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--ease), color var(--ease);
    font-weight: 500;
  }
  .guide-body :global(a:hover) {
    color: var(--red);
    text-decoration-color: var(--red);
  }

  .guide-body :global(strong) { font-weight: 700; color: var(--text); }
  .guide-body :global(em) { font-style: italic; }

  /* Callout / info box */
  .guide-body :global(.info-box) {
    background: #f0f9fa;
    border: 1px solid #b2dde3;
    border-left: 3px solid var(--red);
    border-radius: 8px;
    padding: .9rem 1.25rem;
    margin: 1.75rem 0;
    font-size: .93rem;
    color: var(--text);
  }
  .guide-body :global(.info-box strong) {
    color: var(--red-dk);
  }

  /* Tables */
  .guide-body :global(table) {
    width: 100%; border-collapse: collapse;
    margin: 1.5rem 0; font-size: .9rem;
    border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden;
  }
  .guide-body :global(th) {
    background: var(--bg); padding: .65rem 1rem;
    text-align: left; font-size: .78rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em; color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .guide-body :global(td) {
    padding: .65rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .guide-body :global(tr:last-child td) { border-bottom: none; }
  .guide-body :global(tr:hover td) { background: #faf9f8; }

  /* Step numbers for ol */
  .guide-body :global(ol) {
    counter-reset: step;
    list-style: none;
    margin-left: 0;
  }
  .guide-body :global(ol > li) {
    counter-increment: step;
    padding-left: 2.25rem;
    position: relative;
  }
  .guide-body :global(ol > li::before) {
    content: counter(step);
    position: absolute; left: 0;
    width: 1.5rem; height: 1.5rem;
    background: var(--red); color: #fff;
    border-radius: 50%; font-size: .72rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    top: .2rem; flex-shrink: 0;
  }

  /* ── Sidebar ── */
  .guide-sidebar {
    display: flex; flex-direction: column; gap: 1rem;
    position: sticky; top: 80px;
  }

  /* CTA card — clean, not gradient */
  .sidebar-cta {
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--sh-sm);
  }
  .cta-accent {
    height: 4px;
    background: var(--red);
  }
  .cta-inner { padding: 1.25rem; }
  .cta-eyebrow {
    font-size: .72rem; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--red);
    margin-bottom: .5rem !important;
  }
  .cta-inner h3 {
    font-size: .95rem; font-weight: 800;
    color: var(--text); line-height: 1.35;
    margin-bottom: .5rem;
  }
  .cta-inner > p {
    font-size: .83rem; color: var(--muted);
    line-height: 1.55; margin-bottom: 1rem !important;
  }
  .cta-btn {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    background: var(--red); color: #fff !important;
    font-size: .83rem; font-weight: 700;
    padding: .65rem 1rem; border-radius: 8px;
    text-decoration: none !important;
    transition: background var(--ease);
    width: 100%;
  }
  .cta-btn:hover { background: var(--red-dk) !important; }
  .cta-note {
    font-size: .73rem; color: var(--muted);
    text-align: center; margin-top: .6rem !important;
  }

  /* TOC + Related */
  .sidebar-toc,
  .sidebar-related {
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    box-shadow: var(--sh-sm);
  }

  .sidebar-label {
    font-size: .72rem; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--muted);
    margin-bottom: .65rem !important;
  }

  .sidebar-toc :global(ul) {
    list-style: none; margin: 0 !important;
    display: flex; flex-direction: column; gap: .1rem;
  }
  .sidebar-toc :global(li) { margin: 0 !important; padding: 0 !important; }
  .sidebar-toc :global(a) {
    display: block; font-size: .84rem; color: var(--muted);
    padding: .25rem 0;
    text-decoration: none !important; font-weight: 400;
    transition: color var(--ease);
    border-left: 2px solid transparent;
    padding-left: .6rem;
  }
  .sidebar-toc :global(a:hover) {
    color: var(--red);
    border-left-color: var(--red);
  }

  .sidebar-related :global(ul) {
    list-style: none; margin: 0 !important;
    display: flex; flex-direction: column; gap: .1rem;
  }
  .sidebar-related :global(li) { margin: 0 !important; padding: 0 !important; }
  .sidebar-related :global(a) {
    display: block; font-size: .84rem; color: var(--muted);
    padding: .3rem 0;
    text-decoration: none !important;
    transition: color var(--ease);
  }
  .sidebar-related :global(a:hover) { color: var(--text); }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .guide-wrap {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .guide-sidebar { position: static; }
    .sidebar-toc { display: none; }
  }
</style>
