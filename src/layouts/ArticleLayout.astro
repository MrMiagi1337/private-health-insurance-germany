---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HeroArticle from '../components/sections/HeroArticle.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import GuideCard from '../components/ui/GuideCard.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';

interface Related { title: string; excerpt: string; href: string; eyebrow?: string; readTime?: string; image?: string; alt?: string }
interface Props {
  title: string;
  description: string;
  intro?: string;
  readTime?: string;
  reviewedBy?: string;
  image?: string;
  alt?: string;
  breadcrumbs?: { label: string; href?: string }[];
  toc: { id: string; label: string }[];
  summary?: string[];
  faqs?: { q: string; a: string }[];
  references?: { label: string; href?: string }[];
  author?: { name: string; role: string };
  related?: Related[];
  leadSource?: string;
  datePublished?: string;
  dateModified?: string;
}
const {
  title, description, intro = description, readTime, reviewedBy, image, alt = '',
  breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Guides', href: '/guide' }, { label: title }],
  toc, summary = [], faqs = [], references = [],
  author = { name: 'My Healthcare Broker team', role: 'Independent consultants for private health insurance in Germany' },
  related = [], leadSource = 'phig-article',
  datePublished = '2026-01-15', dateModified = '2026-10-01',
} = Astro.props;

const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished, dateModified,
  author: { '@type': 'Organization', name: author.name },
  publisher: { '@type': 'Organization', name: 'Private Health Insurance Germany' },
};
const initials = author.name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<Layout title={title} description={description}>
  <main>
    <Breadcrumbs items={breadcrumbs} />
    <HeroArticle title={title} intro={intro} readTime={readTime} reviewedBy={reviewedBy} image={image} alt={alt} />

    <div class="container-article art">
      <nav class="toc" aria-labelledby="toc-h">
        <p id="toc-h" class="toc-title">In this article</p>
        <ul>
          {toc.map((t) => (
            <li>
              <a href={`#${t.id}`}>
                <span>{t.label}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {summary.length > 0 && (
        <aside class="summary" aria-labelledby="sum-h">
          <h2 id="sum-h">Summary</h2>
          <ul>{summary.map((s) => <li>{s}</li>)}</ul>
        </aside>
      )}

      <div class="prose"><slot /></div>

      {faqs.length > 0 && (
        <section id="faq" class="art-block" aria-labelledby="faq-h">
          <h2 id="faq-h">Frequently asked questions</h2>
          <FaqAccordion items={faqs} />
        </section>
      )}

      {references.length > 0 && (
        <aside class="refs art-block" aria-labelledby="ref-h">
          <h2 id="ref-h">Sources and references</h2>
          <ul>
            {references.map((r) => <li>{r.href ? <a href={r.href}>{r.label}</a> : r.label}</li>)}
          </ul>
        </aside>
      )}

      <div class="author art-block">
        <span class="avatar" aria-hidden="true">{initials}</span>
        <div>
          <p class="a-name">{author.name}</p>
          <p class="a-role">{author.role}</p>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="art-wide">
        <div class="container">
          <SectionIntro title="Related articles" />
          <div class="rel-grid">{related.map((r) => <GuideCard {...r} />)}</div>
        </div>
      </section>
    )}

    <section class="art-wide art-end">
      <div class="container-narrow"><LeadForm source={leadSource} title="Talk to an independent consultant about your situation" /></div>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
</Layout>

<style>
  .art { padding-top: 24px; }
  .toc { border: var(--border-w) solid var(--border); border-radius: var(--radius-card); padding: 24px; background: var(--surface); }
  .toc-title { font-weight: var(--fw-heading); color: var(--navy); font-size: 20px; line-height: 28px; margin-bottom: 8px; }
  .toc ul { list-style: none; }
  .toc li + li { border-top: var(--border-w) solid var(--border); }
  .toc a { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 44px; padding: 10px 0; color: var(--text); font-size: 15px; line-height: 22px; }
  .toc a svg { color: var(--blue); flex: none; transition: transform var(--ease); }
  .toc a:hover { color: var(--navy); }
  .toc a:hover svg { transform: translateX(3px); }
  .toc a:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; border-radius: 4px; }
  .summary { margin-top: 32px; background: var(--blue-tint); border-radius: var(--radius-card); padding: 24px; }
  .summary h2 { font-size: 20px; line-height: 28px; margin-bottom: 12px; }
  .summary ul { padding-left: 20px; display: grid; gap: 8px; }
  .prose { margin-top: 48px; }
  .art-block { margin-top: 56px; }
  .art-block h2 { font-size: var(--fs-h2-sm); line-height: var(--lh-h2-sm); margin-bottom: 16px; scroll-margin-top: calc(var(--nav-h) + 24px); }
  .refs { background: var(--cream); border-radius: var(--radius-card); padding: 24px; }
  .refs h2 { font-size: 20px; line-height: 28px; margin-bottom: 12px; }
  .refs ul { padding-left: 20px; display: grid; gap: 6px; font-size: 15px; }
  .refs a { color: var(--blue-dk); font-weight: var(--fw-btn); }
  .author { display: flex; gap: 16px; align-items: center; padding-top: 32px; border-top: var(--border-w) solid var(--border); }
  .avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--blue-tint); color: var(--navy); display: grid; place-items: center; font-weight: var(--fw-heading); flex: none; }
  .a-name { font-weight: var(--fw-heading); color: var(--navy); }
  .a-role { color: var(--text-muted); font-size: 15px; }
  .art-wide { margin-top: var(--section-y-mobile); }
  .art-end { padding-bottom: var(--section-y-mobile); }
  .rel-grid { display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 32px; }
  @media (min-width: 640px) { .rel-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) {
    .art { padding-top: 32px; }
    .art-wide { margin-top: var(--section-y); }
    .art-end { padding-bottom: var(--section-y); }
    .rel-grid { grid-template-columns: repeat(3, 1fr); gap: 25px; }
  }
</style>
